# enum_eq_test.deor
# Exercises the enum variant value-equals rules: a typed enum variant missing
# its '= value', and an untyped enum variant that has one anyway.

enum string Status
	Active = "on"
	Inactive  # meta(error: typed_enum_eq)

enum Mode
	Fast = 1  # meta(error: untyped_enum_eq, error: undeclared_reassign)
	Slow

fn void main()
	print("should never reach here")

