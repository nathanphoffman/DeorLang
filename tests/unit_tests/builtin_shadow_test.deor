# builtin_shadow_test.deor
# Exercises the built-in-name-shadow validator: print, crash, len, range, args,
# and input are plain IDENTs (not lexer keywords) but still cannot be used as a
# variable, fn param, struct field, for-loop var, top-level fn name, or
# destructuring target.

shape intList = list of int

shape range = list of int  # meta(error: builtin_shadow)

enum string print  # meta(error: builtin_shadow, error: pascal)
	Foo = "Foo"

struct Item
	int range  # meta(error: builtin_shadow)

fn void crash()  # meta(error: builtin_shadow, error: crash)
	print("hi")

fn void test_local_var()
	int print = 5  # meta(error: builtin_shadow)

fn void test_param(int len)  # meta(error: builtin_shadow)
	print("hi")

fn void test_for_loop()
	intList items = [1, 2, 3]

	for input in items  # meta(error: builtin_shadow)
		print("hi")

fn void test_destructure()
	Item thing = (5)  # meta(error: struct_field_count)
	(args) in thing  # meta(error: builtin_shadow)

fn void main()
	crash()  # meta(error: crash)
	test_local_var()
	test_param(5)
	test_for_loop()
	test_destructure()

