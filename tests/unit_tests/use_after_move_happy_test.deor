# use_after_move_happy_test.deor
# Confirms check_use_after_move does not flag legitimate patterns easily
# mistaken for use-after-move: moving a Copy-type primitive (a documented
# no-op, see docs/move.md), moving inside s_join's bracket-literal list
# (also inert — concat only ever borrows), the "name = f(move name)"
# self-reassign idiom, moving in one if/else arm while reading in the other
# (branches are mutually exclusive, so this is always fine regardless of
# what happens after the chain closes), a for-move loop that fully consumes
# its collection (the loop var itself stays readable inside the body — see
# for_move_loop_var_test.deor for the declared-vars side of that), a
# partial-move destructure that leaves an untouched field readable, and the
# "if kind is X: return ..." dispatch idiom used throughout this codebase's
# own codegen (an if-arm that unconditionally returns must not poison a
# later, independent if-arm's use of the same name).
# See use_after_move_test.deor for the cases this check DOES flag.

import "lib/string.deor"

shape wordList = list of string

struct Score
	string label
	int points

fn string append_str(string base_val, string suffix)
	return s_join([base_val, suffix])

fn void test_copy_move()
	int count = 5
	int doubled = move count
	print(count)

fn void test_sjoin_move()
	string greeting = "hello"
	print(s_join([move greeting, " there"]))
	print(greeting)

fn void test_self_reassign()
	string built = "a"
	string next_b = "b"
	string next_c = "c"
	built = append_str(move built, next_b)
	built = append_str(move built, next_c)
	print(built)

fn void test_branch_independent()
	string label = "x"
	if true
		string taken = move label
	else
		print(label)

fn void test_for_move()
	wordList items = ["one", "two"]
	for move (item in items)
		print(item)

fn void test_untouched_field_after_partial_move()
	label as "x"
	points as 5
	Score score = (label, points)
	move (label) in score
	(points) in score
	print(points)

fn string test_terminal_dispatch(string kind, string value)
	if kind is "AAA"
		string taken = move value
		return taken
	if kind is "BBB"
		return value
	return "none"

fn void main()
	test_copy_move()
	test_sjoin_move()
	test_self_reassign()
	test_branch_independent()
	test_for_move()
	test_untouched_field_after_partial_move()
	string dispatch_kind = "BBB"
	string dispatch_val = "kept"
	print(test_terminal_dispatch(dispatch_kind, dispatch_val))

# expect:
# 5
# hello there
# hello
# abc
# one
# two
# 5
# kept
