# negative_literal_test.deor
# Unary minus on literals used to emit `/* unknown_primary */` in Rust. Covers int and
# float negatives in declarations, assignments, arguments, returns, comparisons and
# validator constructor arguments.

import "lib/convert.deor"

type Positive(int val)
	val > 0

fn int double_it(int value)
	return value * 2

fn int neg_return()
	return -7

fn float neg_float_return()
	return -1.5

fn void main()
	int missing = -1
	print(c_int_to_string(missing))

	missing = -2
	print(c_int_to_string(missing))

	float offset = -1.5
	print(c_float_to_string(offset))

	offset = -2.5
	print(c_float_to_string(offset))

	print(c_int_to_string(double_it(-5)))
	print(c_int_to_string(neg_return()))
	print(c_float_to_string(neg_float_return()))

	if missing > -3
		print("greater than -3")

	if missing < -1 and offset < -0.5
		print("both negative")

	Positive bad_num = -1
	if bad_num is not valid
		print("negative rejected")

# expect:
# -1
# -2
# -1.5
# -2.5
# -10
# -7
# -1.5
# greater than -3
# both negative
# negative rejected
