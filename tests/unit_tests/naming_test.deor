# naming_test.deor
# Exercises the declaration-name-casing validator rules: a struct name that
# isn't PascalCase, a shape name that isn't camelCase, and a const name that
# isn't SCREAMING_SNAKE_CASE.

struct badname  # error: pascal
	int val

shape BadShape = list of int  # error: camel

enum badenum  # error: pascal
	Alpha
	Beta

fn void test_const_screaming()
	const string bad_name = "x"  # error: screaming

fn void test_for_var_short()
	for ab in [1, 2, 3]  # error: min3
		print(ab)

fn void test_for_var_bad_case()
	for myVar in [1, 2, 3]  # error: snake
		print(myVar)

fn void main()
	print("should never reach here")

