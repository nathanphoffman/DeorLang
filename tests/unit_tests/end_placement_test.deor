# end_placement_test.deor
# 'end' is reserved — only valid directly after 'at' (list at end / list at end = val).
# Each case below misuses it as a plain identifier and should be rejected.

fn int sum_range(int start, int end)  # meta(error: undefined_var, error: end)
	total as 0

	for idx in (start, end)  # meta(error: bare_tuple_range, error: end)
		total = total + idx

	return total

fn void bad_bare_use()
	int end = 5  # meta(error: undefined_var, error: end)
	print(end)  # meta(error: end)

fn void main()
	int range_start = 3
	int range_end = 7
	int total = sum_range(range_start, range_end)
	print(total)

