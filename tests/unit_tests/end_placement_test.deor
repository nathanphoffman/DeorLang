# end_placement_test.deor
# 'end' is reserved — only valid directly after 'at' (list at end / list at end = val).
# Each case below misuses it as a plain identifier and should be rejected.

fn int sum_range(int start, int end)  # error: undefined_var, end
	total as 0

	for idx in (start, end)  # error: bare_tuple_range, end
		total = total + idx

	return total

fn void bad_bare_use()
	int end = 5  # error: undefined_var, end
	print(end)  # error: end

fn void main()
	int range_start = 3
	int range_end = 7
	int total = sum_range(range_start, range_end)
	print(total)

