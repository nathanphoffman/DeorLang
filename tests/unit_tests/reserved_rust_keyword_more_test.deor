# reserved_rust_keyword_more_test.deor
# More Rust-only keywords in other name slots (for-loop var, struct field,
# fn param, destructure binding). Names that merely contain a keyword
# (boxes, matches, looper) must stay legal.

shape intList = list of int

struct Holder
	int boxes
	int matches

fn void test_for_var()
	for ref in range(3)  # meta(error: kw_in_parens)
		print(ref)  # meta(error: kw_in_parens)

fn void test_mod()
	int mod = 5  # meta(error: kw_in_parens)
	print(mod)  # meta(error: kw_in_parens)

fn void test_trait_param(int trait)  # meta(error: kw_in_parens)
	print(trait)  # meta(error: kw_in_parens)

fn void test_ok_names()
	int boxes = 1
	int matches = 2
	int looper = 3
	print(boxes)
	print(matches)
	print(looper)

fn void main()
	print("should never reach here")

