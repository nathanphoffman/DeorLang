# unknown_type_test.deor
# Exercises the general type-existence check across every type-position: variable
# declarations, function parameters, function return types, struct fields, and shape
# list-element/func-input/func-output slots. Before this check existed, none of these
# positions were validated at all — a typo'd or made-up type name transpiled clean and
# only failed later at rustc with a confusing "cannot find type" error. A typed enum's
# own name is also rejected here, since it's a real declared name but not usable as a
# Rust type (see docs/enums.md) — no validator ever caught that either.

enum string Color
	Red = "red"

struct BadField
	Bogus1 thing_here  # error: unknown_type

shape badList = list of Bogus2  # error: unknown_type

shape badFunc = func of Bogus3 to Bogus4  # error: unknown_type

fn Bogus5 make_thing()  # error: unknown_type
	return 5

fn void takes_bad(Bogus6 val)  # error: unknown_type
	print("hi")

fn void test_var_decl()
	Bogus7 thing = 5  # error: unknown_type
	print(thing)

fn void test_typed_enum_as_type()
	Color background = Red  # error: unknown_type
	print("hi")

fn void main()
	print("should never reach here")

