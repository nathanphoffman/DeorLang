fn int sum_to(int num)

	total as 0
	for idx in range(num)
		total = total + idx

	return total

fn int sum_range(int start, int stop)

	total as 0
	for idx in range(start, stop)
		total = total + idx

	return total

fn int count_down(int num)
	result as 0
	for idx in range(num)
		if idx < 2
			continue
		result = result + idx
	return result

fn int count_up_while(int limit)
	result as 0
	for if result < limit
		result = result + 1
	return result

fn int loop_true_break()
	counter as 0
	for if true
		counter = counter + 1
		if counter is 5
			break
	return counter

fn int bare_range_count(int num)
	total as 0
	for in range(num)
		total = total + 1
	return total

fn void main()
	int total1 = sum_to(5)
	print(total1)
	int range_start = 3
	int range_end = 7
	int total2 = sum_range(range_start, range_end)
	print(total2)
	int total3 = count_down(5)
	print(total3)
	flag as true
	if not flag
		print("no")
	else
		print("yes")
	int total4 = count_up_while(4)
	print(total4)
	int total5 = loop_true_break()
	print(total5)
	int total6 = bare_range_count(6)
	print(total6)

	# print's legitimate 2-arg form: the second arg replaces the trailing
	# newline (print! instead of println!), so this line and the next print's
	# output land concatenated on the same stdout line — see call_args_test.deor
	# for the error-path arg-count checks this form must still satisfy.
	prefix as "prefix-"
	suffix as "suffix"
	print(prefix, suffix)
	print("end")

# expect:
# 10
# 18
# 9
# yes
# 4
# 5
# 6
# prefix-suffixend
