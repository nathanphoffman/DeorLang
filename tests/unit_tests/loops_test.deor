fn int sum_to(int num)

	total as 0

	for idx num times
		total = total + idx

	return total

fn int sum_offset(int start, int stop)

	total as 0

	for idx_off stop - start times
		int idx = start + idx_off
		total = total + idx

	return total

fn int count_down(int num)
	result as 0

	for idx num times
		if idx < 2
			continue

		result = result + idx

	return result

fn int count_up_while(int limit)
	result as 0

	for if result < limit
		result = result + 1

	return result

fn int loop_true_break()
	counter as 0

	for if true
		counter = counter + 1

		if counter is 5
			break

	return counter

fn int bare_times_count(int num)
	total as 0

	for num times
		total = total + 1

	return total

fn int times_expr_count(int num)
	total as 0

	for idx num + 1 times
		total = total + idx

	return total

fn int times_len_count()
	nums as [4, 5, 6]
	total as 0

	for idx len(nums) times
		total = total + idx

	return total

fn int times_named_count()
	limit as 4
	total as 0

	for limit times
		total = total + 10

	return total

fn int times_break_continue()
	total as 0

	for idx 10 times
		if idx < 2
			continue

		if idx is 5
			break

		total = total + idx

	return total

fn void main()
	int total1 = sum_to(5)
	print(total1)
	int range_start = 3
	int range_end = 7
	int total2 = sum_offset(range_start, range_end)
	print(total2)
	int total3 = count_down(5)
	print(total3)
	flag as true

	if not flag
		print("no")
	else
		print("yes")

	int total4 = count_up_while(4)
	print(total4)
	int total5 = loop_true_break()
	print(total5)
	int total6 = bare_times_count(6)
	print(total6)
	int total7 = times_expr_count(3)
	print(total7)
	int total8 = times_len_count()
	print(total8)
	int total9 = times_named_count()
	print(total9)
	int total10 = times_break_continue()
	print(total10)

	# print's legitimate 2-arg form: the second arg replaces the trailing
	# newline (print! instead of println!), so this line and the next print's
	# output land concatenated on the same stdout line — see call_args_test.deor
	# for the error-path arg-count checks this form must still satisfy.
	prefix as "prefix-"
	suffix as "suffix"
	print(prefix, suffix)
	print("end")

# expect:
# 10
# 18
# 9
# yes
# 4
# 5
# 6
# 6
# 3
# 40
# 9
# prefix-suffixend
