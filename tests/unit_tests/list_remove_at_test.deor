# list_remove_at_test.deor
# Exercises `list remove at idx`: removing from the middle shifts later elements left,
# and removing several elements high-to-low (the pattern documented in
# docs/collections.md) leaves the expected survivors.

shape intList = list of int

fn void main()
	intList nums = [10, 20, 30, 40, 50, 60]
	int start_len = len(nums)
	print(start_len)

	nums remove at 2
	int third = nums at 2
	print(third)

	nums remove at 3
	nums remove at 1
	int after_len = len(nums)
	print(after_len)

	int first = nums at 0
	int second = nums at 1
	int last = nums at 2
	print(first)
	print(second)
	print(last)

# expect:
# 6
# 40
# 3
# 10
# 40
# 60
