# reserved_shape_param_test.deor
# Regression: a parameter (or function name) spelled like a declaration keyword
# (shape/struct/enum/type) used to trigger "declarations must come before macros and
# functions" — the load-time declaration-order check saw the keyword and blamed
# ordering, even though the struct was declared first. It must instead report the
# reserved word as a bad name.

struct Curve
	float power

fn float strength(Curve shape, float distance)  # error: kw_in_parens, undefined_var
	return distance

fn int type_param(int type)  # error: kw_in_parens, undefined_var, non_primitive_validator
	return type  # error: non_primitive_validator

fn int struct_param(int struct)  # error: kw_in_parens, undefined_var
	return struct

fn int enum_param(int enum)  # error: kw_in_parens, undefined_var
	return enum  # error: kw_in_parens

fn int shape()  # error: kw_in_parens, empty_parens
	return 1  # error: kw_in_parens

fn void main()
	print("should never reach here")

