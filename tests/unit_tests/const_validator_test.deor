# const_validator_test.deor
# Exercises the const and validator-type validator rules: a validator type's
# own declaration shadowing its type name or base type, a validator built on
# a list shape or another validator type (including itself) instead of a
# primitive or struct, reassigning a const, using 'empty' on a validator type,
# reassigning a validator-type variable without re-running its predicate, and
# 'avow' used on a non-validator variable.

shape intList = list of int

type Positive(int val)
	val > 0

type Roll(int Roll)
	Roll > 0

type Weight(int int)
	int > 0

type BadValidator(intList vals)
	true

type SelfValidator(SelfValidator vals)
	true

type BuiltinShadowValidator(int print)
	print > 0

fn void test_const_reassign()
	const string PIPE = "|"
	PIPE = "/"

fn void test_validator_empty()
	Positive pos_val = empty

fn void test_validator_reassign()
	Positive pos_val = 5
	pos_val as 6

fn void test_avow_non_validator()
	int plain = 5
	int result = (avow plain)

fn void main()
	test_const_reassign()
	test_validator_empty()
	test_validator_reassign()
	test_avow_non_validator()

# expect-error:
# line 14: type 'Roll' - validator parameter name cannot be the same as the type name
# line 17: type 'int' - parameter name cannot be the same as its type
# line 20: type 'BadValidator' - validator base type must be a primitive
# line 23: type 'SelfValidator' - validator base type must be a primitive
# line 26: type 'print' - this name belongs to a built-in function
# line 31: variable 'PIPE' - cannot reassign a const variable
# line 34: variable 'empty' - empty is not valid for validator types
# line 38: variable 'pos_val' - cannot reassign a validator type variable
# line 42: variable 'plain' - avow can only be used on a validator type variable
