# const_validator_test.deor
# Exercises the const and validator-type validator rules: a validator type's
# own declaration shadowing its type name or base type, a validator built on
# a list shape or another validator type (including itself) instead of a
# primitive or struct, reassigning a const, using 'empty' on a validator type,
# reassigning a validator-type variable without re-running its predicate, and
# 'avow' used on a non-validator variable.

shape intList = list of int

type Positive(int val)
	val > 0

type Roll(int Roll)  # error: type_param_shadow
	Roll > 0

type Weight(int int)  # error: param_shadow
	int > 0

type BadValidator(intList vals)  # error: non_primitive_validator
	true

type SelfValidator(SelfValidator vals)  # error: non_primitive_validator
	true

type BuiltinShadowValidator(int print)  # error: builtin_shadow
	print > 0

fn void test_const_reassign()
	const string PIPE = "|"
	PIPE = "/"  # error: const_reassign

fn void test_validator_empty()
	Positive pos_val = empty  # error: validator_empty

fn void test_validator_reassign()
	Positive pos_val = 5
	pos_val as 6  # error: validator_reassign

fn void test_avow_non_validator()
	int plain = 5
	int result = (avow plain)  # error: avow

fn void main()
	test_const_reassign()
	test_validator_empty()
	test_validator_reassign()
	test_avow_non_validator()

