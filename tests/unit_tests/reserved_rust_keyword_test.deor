# reserved_rust_keyword_test.deor
# Rust-only keywords (box, match, impl, ...) are not Deor keywords, but using one
# as a name produces a .rs file that doesn't compile. The validator rejects them.

fn void test_box()
	int box = 5  # error: kw_in_parens
	print(box)  # error: kw_in_parens

fn void test_match()
	int match = 5  # error: kw_in_parens
	print(match)  # error: kw_in_parens

fn void test_param_impl(int impl)  # error: kw_in_parens
	print(impl)  # error: kw_in_parens

fn void test_loop_as()
	loop as 5  # error: kw_in_parens

fn void main()
	print("should never reach here")

