# empty_parens_test.deor
# Exercises the empty-parens validator: '()' with nothing inside is invalid
# everywhere except a zero-parameter fn declaration or a call to one.

struct Room
	int area
	string name

# A validator type's parens are never allowed to be empty, unlike a zero-param
# fn declaration or call — check_empty_parens' ep_is_type_decl branch exists
# specifically to keep this case from being wrongly exempted alongside those.
type EmptyValidator()
	true

fn void greet()
	print("hi")

fn void test_with_empty()
	Room room = (5, "Office")
	Room updated = room with ()

fn int test_return_empty()
	return ()

fn void test_move_empty()
	int x = 5
	int y = move ()

fn void main()
	greet()

# expect-error:
# line 12: variable '(' - '()' is not valid
# line 20: variable '(' - '()' is not valid
# line 23: variable '(' - '()' is not valid
# line 27: variable '(' - '()' is not valid
