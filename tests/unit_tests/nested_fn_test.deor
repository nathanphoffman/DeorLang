# nested_fn_test.deor
# Exercises the nested-function-declaration validator rule: declaring a fn
# inside a non-fn block (here, a struct body) must be a transpiler error, not
# something that silently falls through to broken codegen / a confusing
# rustc failure. A fn nested directly inside another fn's body IS allowed —
# see nested_fn_happy_test.deor for that case.

struct Broken
	int val
	fn bool inner(int val)
		return val > 0

fn void main()
	print("should never reach here")

# expect-error:
# line 10: fn 'inner' - functions may only be declared at the top level of a file
