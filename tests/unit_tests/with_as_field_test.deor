# with_as_field_test.deor
# `with (value as field)` is not Deor syntax. The with-field scanner used to get
# stuck on the `as` token and hang the compiler forever; it must now error.

struct Traffic
	int traders
	int stations

fn Traffic grow(Traffic traffic, int grown)
	Traffic updated = traffic with (grown as traders)  # meta(error: with_fields, error: undefined_var)

	return updated

fn void main()
	print("should never reach here")

