# with_as_field_more_test.deor
# Other malformed `with (...)` lists must error instead of hanging the compiler.
# The valid forms (single field, several fields) are covered by typed_with_test.

struct Pair
	int left
	int right

fn Pair bad_two(Pair pair, int grown, int more)
	Pair first = pair with (grown as left, more as right)  # error: with_fields, undefined_var

	return first

fn Pair bad_mixed(Pair pair, int right, int grown)
	Pair second = pair with (right, grown as left)  # error: with_fields, undefined_var

	return second

fn Pair bad_literal(Pair pair)
	Pair third = pair with (5)  # error: with_fields

	return third

fn Pair bad_as_form(Pair pair, int grown)
	changed as pair with (grown as left)  # error: with_fields, undefined_var

	return changed

fn void main()
	print("should never reach here")

