# Helpers for the compiler's error tests. A line that should produce a transpiler
# error carries a meta tag (see lib/meta.deor):
#   # meta(error: code)                       at the end of the line that should fail
#   # meta(error: a, error: b)                several errors on one line
#   # meta(error: code, where: elsewhere)     an error with no line in this file: one about
#                                             the file as a whole (declaration order) or
#                                             raised in a file it imports (a fixture)
# The code is the bracketed name ending the transpiler's message, for example
# `[max_params]`. Both sides are reduced to sorted "line code" text (line is `*` for an
# elsewhere error) so the runner can compare them directly. Inserting or removing
# lines above a marker never breaks a test. A line and code count once however many
# times the transpiler reports them (two bad arguments on one line, say).

import "lib/meta.deor"

# Lists "line code" for every `error` field in the source's meta tags, sorted.
fn string collect_markers(string source)
	rust
		{
			let mut found: Vec<String> = Vec::new();
			for tag in read_meta_tags(source) {
				// A tag marked `where: elsewhere` has no line in this file.
				let elsewhere = tag.fields.iter().any(|field| field.key == "where" && field.value == "elsewhere");
				let place = if elsewhere { "*".to_string() } else { tag.attached_line.to_string() };
				for field in tag.fields.iter().filter(|field| field.key == "error") {
					found.push(format!("{} {}", place, field.value));
				}
			}
			found.sort();
			found.dedup();
			found.join("\n")
		}

# Lists every warning the meta reader gave for the source, as "line N: warning" text.
# A test file with a malformed tag must fail, so the runner checks this is empty.
fn string collect_marker_warnings(string source)
	rust
		{
			let mut found: Vec<String> = Vec::new();
			for tag in read_meta_tags(source) {
				for warning in tag.warnings.iter() {
					found.push(format!("line {}: {}", tag.line, warning));
				}
			}
			found.join("\n")
		}

# Lists "line code" for every error the transpiler reported, sorted. Errors raised at
# a line of `path` get that line number; all others get `*`. An error line with no
# bracketed code shows up as "? <the line>" so it fails the comparison instead of
# being silently ignored.
fn string collect_reported_errors(string output, string path)
	rust
		{
			let prefixes = ["[validation] ", "[error] "];
			let mut found: Vec<String> = Vec::new();
			for line in output.lines() {
				let Some(rest) = prefixes.iter().find_map(|prefix| line.strip_prefix(prefix)) else { continue };
				let Some(code) = line.trim_end().rsplit_once('[').and_then(|(_, tail)| tail.strip_suffix(']')) else {
					found.push(format!("? {}", line));
					continue;
				};
				// "<path> line N: ..." means the error is on line N of this very file.
				let own_line = rest.strip_prefix(path.as_str())
					.and_then(|after| after.strip_prefix(" line "))
					.and_then(|after| after.split_once(':'))
					.map(|(number, _)| number.to_string());
				found.push(format!("{} {}", own_line.unwrap_or_else(|| "*".to_string()), code));
			}
			found.sort();
			found.dedup();
			found.join("\n")
		}
