# DO NOT EDIT THIS FILE — it ships with the Deor standard library and is
# overwritten by `deor update`. Local changes will be silently lost.
#
# To add your own functions to this module, create lib/result_extension.deor
# instead and import it alongside this file.

type TOk(T val)
	true

struct TResult
	TOk value
	string message

# The result is built with an explicit type (not a bare `return (value, message)`) because a
# bare tuple finds its struct by field names alone, which would be ambiguous once this file
# is imported for two different types.

# Builds a successful result holding val, with an empty message.
fn TResult r_T_ok(T val)
	TOk value = val
	string message = ""
	TResult built = (value, message)

	return built

# Builds a failed result: value is left not valid and message says what went wrong.
fn TResult r_T_error(string message)
	TOk value
	TResult built = (value, message)

	return built
