# overwritten by `deor update`. Local changes will be silently lost.
#
# To add your own functions to this module, create lib/optional_extension.deor
# instead and import it alongside this file.

# A value that may be missing: a validator type over T whose rule accepts anything, so it
# is only not valid when nothing was assigned. Check it with `is valid` / `is not valid`
# and unwrap it with `avow`, like any other validator type.
type TOptional(T val)
	true

# An optional holding nothing.
fn TOptional o_T_none()
	TOptional nothing

	return nothing

# An optional holding val.
fn TOptional o_T_some(T val)
	TOptional something = val

	return something

# The optional's value when it has one, otherwise fallback.
fn T o_T_or(TOptional opt, T fallback)
	if opt is valid
		return (avow opt)

	return fallback
