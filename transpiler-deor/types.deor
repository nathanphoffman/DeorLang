shape tokenList = list of Token

shape strList = list of string

# A single lexer token. `kind` is the token category (e.g. "KW_FN", "IDENT", "PLUS"),
# `value` is the literal source text, and `line` is the source line number for diagnostics.
struct Token
	string kind
	string value
	int line
	string file

# Returned by every code-generation function: the Rust source text produced so far
# (`code`) and the token-stream index to resume from after consuming this construct
# (`new_pos`). Pairs code with its parse position so callers never lose their place.
struct ParseResult
	string code
	int new_pos

# Returned by a registry try_*_entry scan (see registry/*.deor) for a declaration whose
# registry entry is a single key/value pair — struct name+fields, shape name+form, raw
# name+"raw:". `matched` is false when the token at the scanned position wasn't the
# expected declaration shape; callers still advance to `new_pos` either way so the
# single-pass registry loop in registry.deor never stalls.
struct Reg2Scan
	bool matched
	string key
	string val
	int new_pos

# Same as Reg2Scan but for a registry whose entry is a key plus two values — currently
# just the validator-type registry ([Name, baseType, paramName] triplets).
struct Reg3Scan
	bool matched
	string key
	string val
	string val2
	int new_pos

# Code-generation context threaded through all gen_* functions. Holds every pre-built
# registry so generators can look up struct fields, enum variants, shape aliases,
# and validator types without re-scanning the token stream on each call.
struct TokenMeta
	int line
	string file

struct GenCtx
	ListRef variant_reg
	ListRef shape_reg
	ListRef struct_reg
	ListRef enum_reg
	ListRef mut_names
	ListRef type_reg
	TokensRef tokens
	ListRef typed_enum_reg
	ListRef typed_variant_reg
	ListRef validator_var_reg
	ListRef validator_fn_reg

# Cursor-style view into a token list. Used inside `using c` blocks during declaration
# parsing to step through tokens one at a time without carrying raw indices everywhere.
# `token_count` and `pos` guard bounds; `current` is the token at `pos`.
struct TokenCursor
	int token_count
	int pos
	Token current

# Returned by deduplicate_decls: the deduped token stream plus the
# ENFORCE_MACRO_FILE_DEPTH pragma value captured along the way (0 = unset/no limit),
# threaded through to build_macros for cross-file macro call depth enforcement.
struct DedupResult
	tokenList tokens
	int enforce_macro_file_depth

rust
	use std::rc::Rc;
	type TokensRef = Rc<Vec<Token>>;
	type RcCtx = Rc<GenCtx>;
	// A shared, read-only registry list: cloning copies a pointer, not every entry.
	type ListRef = Rc<Vec<String>>;
	fn list_wrap(items: Vec<String>) -> ListRef { Rc::new(items) }
	// One line's characters, shared by the lexer's scan_* functions without copying the list per call.
	type CharsRef = Rc<Vec<String>>;
	fn chars_wrap(chars: Vec<String>) -> CharsRef { Rc::new(chars) }
	fn tokens_wrap(t: Vec<Token>) -> TokensRef { Rc::new(t) }
	fn make_rctx(ctx: GenCtx) -> RcCtx { Rc::new(ctx) }
	fn now_ms() -> i64 { std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis() as i64 }
	fn elapsed_ms(start: i64) -> i64 { now_ms() - start }
	// Hash set for hot name lookups: cloning an Rc is cheap, unlike list_has's by-value strList.
	type NameSet = Rc<std::collections::HashSet<String>>;
	fn name_set(names: Vec<String>) -> NameSet { Rc::new(names.into_iter().collect()) }
	// Single-field token reads: one small copy instead of cloning the whole Token and destructuring it.
	fn token_kind_at(tokens: TokensRef, pos: i64) -> String { tokens[pos as usize].kind.clone() }
	fn token_value_at(tokens: TokensRef, pos: i64) -> String { tokens[pos as usize].value.clone() }
	fn token_file_at(tokens: TokensRef, pos: i64) -> String { tokens[pos as usize].file.clone() }
	fn token_line_at(tokens: TokensRef, pos: i64) -> i64 { tokens[pos as usize].line }
	// Borrowed stride-2 registry lookup: the value after the matching key, or "". Same result as reg_get without copying the list.
	fn reg_get_ref(pairs: &Vec<String>, key: &String) -> String {
		pairs.chunks(2).find(|pair| pair[0] == *key).and_then(|pair| pair.get(1)).cloned().unwrap_or_default()
	}
	fn name_set_has(set: NameSet, name: String) -> bool { set.contains(&name) }

raw TokensRef
raw RcCtx
raw NameSet
raw ListRef
raw CharsRef
