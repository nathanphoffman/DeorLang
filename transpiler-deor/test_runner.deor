# Test-mode code generation for `deor input.test.deor output.rs --test`.
# A test file has no main: every function named test_* (returning a string, taking no
# arguments) is a test, and this file builds the Rust main() that runs them all.
# A test passes by returning SUCCESS (the empty string); any other string is the
# failure message. A test that panics (crash, bad index, ...) is reported as a failure
# too, so one broken test never stops the rest.

rust
	pub const TEST_RUNNER_SOURCE: &str = r#"
	fn deor_panic_message(payload: Box<dyn std::any::Any + Send>) -> String {
	    if let Some(text) = payload.downcast_ref::<String>() {
	        return text.clone();
	    }
	    if let Some(text) = payload.downcast_ref::<&str>() {
	        return text.to_string();
	    }
	    "(no panic message)".to_string()
	}

	fn deor_run_tests(tests: Vec<(&str, fn() -> String)>) -> i32 {
	    // The default panic printout is silenced; each crash is reported per test instead.
	    std::panic::set_hook(Box::new(|_| {}));
	    let mut failed = 0;
	    for (name, test) in &tests {
	        match std::panic::catch_unwind(*test) {
	            Ok(message) if message.is_empty() => println!("  SUCCESS: {}", name),
	            Ok(message) => {
	                failed += 1;
	                println!("  FAIL: {} - {}", name, message);
	            }
	            Err(payload) => {
	                failed += 1;
	                println!("  FAIL: {} - crashed: {}", name, deor_panic_message(payload));
	            }
	        }
	    }
	    println!("{} ran, {} failed", tests.len(), failed);
	    if failed > 0 { 1 } else { 0 }
	}
	"#;

# Returns the fixed Rust source of the test runner (the part that never changes).
fn string test_runner_source()
	rust
		TEST_RUNNER_SOURCE.to_string()

# Crashes with a clear message unless the test function starting at `fn_pos` reads
# `fn string name()`. Without this check a wrong signature would surface as an opaque
# rustc type error in the generated runner.
fn void check_test_signature(TokensRef tokens, int fn_pos)
	int type_pos = fn_pos + 1
	int name_pos = fn_pos + 2
	int close_pos = fn_pos + 4
	string return_type = token_value_at(tokens, type_pos)
	string close_kind = token_kind_at(tokens, close_pos)
	bool returns_string = return_type is "string"
	bool takes_nothing = close_kind is RPAREN

	if not returns_string or not takes_nothing
		string test_name = token_value_at(tokens, name_pos)
		string problem = s_join(["test function '", test_name, "' must be written 'fn string ", test_name, "()' - it returns a message and takes no arguments"])
		crash(problem)

# Collects the names of the test_* functions declared in the entry file itself
# (not in anything it imports), in the order they appear.
fn strList find_test_names(TokensRef tokens, string entry_file)
	strList names = empty
	int token_count = len(tokens)
	int first_pos = 0
	string prefix = "test_"

	for pos in range(first_pos, token_count)
		string kind = token_kind_at(tokens, pos)
		string file = token_file_at(tokens, pos)

		if kind is not KW_FN or file is not entry_file
			continue

		int name_pos = pos + 2
		string name = token_value_at(tokens, name_pos)

		if s_starts_with(name, prefix)
			check_test_signature(tokens, pos)
			names at end = name

	return names

# Builds the Rust main() that hands every test to the runner and exits with its result.
fn string build_test_main(strList names)
	strList entries = empty

	for name in names
		string entry = s_join(["(\"", name, "\", ", name, " as fn() -> String)"])
		entries at end = entry

	string separator = ", "
	string entry_list = s_join_with(entries, separator)

	return s_join(["\nfn main() {\n    std::process::exit(deor_run_tests(vec![", entry_list, "]));\n}\n"])

# Returns the complete Rust to append to a test file: the fixed runner plus a main()
# listing this file's tests.
fn string generate_test_runner(TokensRef tokens, string entry_file)
	strList names = find_test_names(tokens, entry_file)
	string runner_source = test_runner_source()
	string main_code = build_test_main(names)

	return s_cat(runner_source, main_code)
