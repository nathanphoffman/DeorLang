# True for the three ENFORCE_* pragma names.
fn bool is_pragma_name(string name)
	bool is_file_flag = name is "ENFORCE_UNIQUE_FILE_DECLARATIONS"
	bool is_import_flag = name is "ENFORCE_UNIQUE_IMPORT_DECLARATIONS"
	bool is_depth_flag = name is "ENFORCE_MACRO_FILE_DEPTH"

	return is_file_flag or is_import_flag or is_depth_flag

# True when `current` belongs to an ENFORCE_* pragma line: the pragma name, the `=` after
# ENFORCE_MACRO_FILE_DEPTH, or the number after that `=`. `previous` and `earlier` are the one
# and two tokens before it. The importer uses this so a pragma written above the imports at the
# top of the entry file doesn't count as a declaration ("imports must come first"). It takes
# single tokens, not the token list: arguments are cloned, and cloning the whole list for every
# token made loading several times slower.
fn bool is_pragma_token(Token current, Token previous, Token earlier)
	unsafe_macro_run token_kinds
	(kind, value) in current
	string current_kind = kind

	if current_kind is IDENT
		return is_pragma_name(value)

	(kind, value) in previous
	bool previous_is_depth_name = kind is IDENT and value is "ENFORCE_MACRO_FILE_DEPTH"
	bool previous_is_equals = kind is EQUALS

	if current_kind is EQUALS
		return previous_is_depth_name

	(kind, value) in earlier
	bool earlier_is_depth_name = kind is IDENT and value is "ENFORCE_MACRO_FILE_DEPTH"

	return current_kind is "INT" and previous_is_equals and earlier_is_depth_name
