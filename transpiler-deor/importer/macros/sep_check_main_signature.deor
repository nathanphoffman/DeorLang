
# Checks whether tokens[scan_pos..scan_pos+4] is the fixed "fn void main()" signature
# (KW_FN already confirmed by the caller at scan_pos itself).
# Reads: tokens, scan_pos, token_count
# Writes: is_main
macro sep_check_main_signature
	# ex: fn {void} main() — kw_pos+1 grabs the return-type slot
	fn int locate_void(int kw_pos)
		return kw_pos + 1

	# ex: fn void {main}() — kw_pos+2 grabs the fn name
	fn int locate_name(int kw_pos)
		return kw_pos + 2

	# ex: fn void main{(} — kw_pos+3 grabs the opening paren
	fn int locate_left_paren(int kw_pos)
		return kw_pos + 3

	# ex: fn void main({)} — kw_pos+4 grabs the closing paren
	fn int locate_right_paren(int kw_pos)
		return kw_pos + 4

	int void_pos = locate_void(scan_pos)
	int name_pos = locate_name(scan_pos)
	int left_paren_pos = locate_left_paren(scan_pos)
	int right_paren_pos = locate_right_paren(scan_pos)
	if right_paren_pos < token_count
		Token void_token = tokens at void_pos
		Token name_token = tokens at name_pos
		Token left_paren_token = tokens at left_paren_pos
		Token right_paren_token = tokens at right_paren_pos
		(kind) in void_token
		bool is_void = kind is "KW_VOID"
		(kind, value) in name_token
		bool is_main_name = kind is "IDENT" and value is "main"
		(kind) in left_paren_token
		bool is_lparen = kind is "LPAREN"
		(kind) in right_paren_token
		bool is_rparen = kind is "RPAREN"
		is_main = is_void and is_main_name and is_lparen and is_rparen
