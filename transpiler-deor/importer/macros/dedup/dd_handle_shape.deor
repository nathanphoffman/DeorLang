
# Checks a shape declaration against every name declared so far, anywhere in the project.
# Hard-errors on a repeat if the relevant ENFORCE_UNIQUE_* pragma is set (same-file repeat
# needs ENFORCE_UNIQUE_FILE_DECLARATIONS, cross-file needs ENFORCE_UNIQUE_IMPORT_DECLARATIONS);
# otherwise keeps the first and drops the repeat. Copies the single-line declaration to
# result and advances pos.
macro dd_handle_shape
	string key_prefix = ""
	unsafe_macro_run dd_check_duplicate
	macro_run dd_copy_single_line_decl
