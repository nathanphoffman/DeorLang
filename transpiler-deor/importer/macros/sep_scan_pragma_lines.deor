
# Repeatedly consumes ENFORCE_UNIQUE_FILE_DECLARATIONS / ENFORCE_UNIQUE_IMPORT_DECLARATIONS
# pragma lines (IDENT + NEWLINE) and ENFORCE_MACRO_FILE_DEPTH pragma lines
# (IDENT + EQUALS + INT + NEWLINE) starting at scan_pos, setting the matching flag/value for
# each one found and advancing past it. Stops at the first token that isn't a recognized
# pragma line.
# Reads/writes: tokens, scan_pos, enforce_unique_file, enforce_unique_import, enforce_macro_file_depth
# Reads: token_count
macro sep_scan_pragma_lines
	# ex: ENFORCE_UNIQUE_FILE_DECLARATIONS {\n} — anchor+1 grabs the newline that must follow
	fn int locate_next_token(int anchor)
		return anchor + 1

	bool scanning = true
	for if scanning
		scanning = false
		if scan_pos < token_count
			Token pragma_token = tokens at scan_pos
			(kind, value) in pragma_token
			bool is_file_flag = kind is "IDENT" and value is "ENFORCE_UNIQUE_FILE_DECLARATIONS"
			bool is_import_flag = kind is "IDENT" and value is "ENFORCE_UNIQUE_IMPORT_DECLARATIONS"
			bool is_depth_flag = kind is "IDENT" and value is "ENFORCE_MACRO_FILE_DEPTH"
			if is_file_flag or is_import_flag
				int newline_pos = locate_next_token(scan_pos)
				bool newline_ok = false
				if newline_pos < token_count
					Token pragma_newline_token = tokens at newline_pos
					(kind) in pragma_newline_token
					newline_ok = kind is "NEWLINE"
				if newline_ok
					if is_file_flag
						enforce_unique_file = true
					else
						enforce_unique_import = true
					scan_pos = scan_pos + 2
					scanning = true
			else if is_depth_flag
				int equals_pos = scan_pos + 1
				int value_pos = scan_pos + 2
				int depth_newline_pos = scan_pos + 3
				bool depth_ok = false
				string depth_str = ""
				if depth_newline_pos < token_count
					Token equals_token = tokens at equals_pos
					(kind) in equals_token
					bool eq_ok = kind is "EQUALS"
					Token value_token = tokens at value_pos
					(kind, value) in value_token
					bool val_ok = kind is "INT"
					depth_str = value
					Token depth_newline_token = tokens at depth_newline_pos
					(kind) in depth_newline_token
					bool depth_newline_ok = kind is "NEWLINE"
					depth_ok = eq_ok and val_ok and depth_newline_ok
				if depth_ok
					enforce_macro_file_depth = n_parse(depth_str)
					scan_pos = scan_pos + 4
					scanning = true
