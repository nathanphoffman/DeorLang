
# File loader. Recursively resolves imports, replacing each import statement in-place
# with the tokens from the referenced file. The thread-local HashSet shim prevents
# re-loading the same file twice (14x performance improvement over the naive approach).

rust
	thread_local! {
		static INCLUDED_FILES: std::cell::RefCell<std::collections::HashSet<String>> = std::cell::RefCell::new(std::collections::HashSet::new());
	}
	fn file_is_new(path: String) -> bool {
		INCLUDED_FILES.with(|set| {
			let mut s = set.borrow_mut();
			if s.contains(&path) { false } else { s.insert(path); true }
		})
	}
	fn file_is_new_keyed(key: String) -> bool {
		INCLUDED_FILES.with(|set| {
			let mut s = set.borrow_mut();
			if s.contains(&key) { false } else { s.insert(key); true }
		})
	}
	fn resolve_lib_path(path: String) -> String {
		if path.starts_with("lib/") {
			if let Ok(lib) = std::env::var("DEOR_LIB") {
				return format!("{}/{}", lib.trim_end_matches('/'), &path[4..]);
			}
		}
		path
	}

# Prints `msg` and exits with status 1. The single exit point every fatal_* helper
# below routes through, so load_file's guards don't each re-derive their own
# print + process::exit boilerplate.
fn void fatal(string msg)
	print(msg)
	rust
		std::process::exit(1);

# Fatal error scoped to a file being loaded: "[error] path: msg". Used by load_file's
# declaration-order guards (imports before decls, structural decls before macros,
# macros before functions).
fn void fatal_at(string path, string msg)
	string err_pre = "[error] "
	string err_sep = ": "
	strList err_parts = [err_pre, path, err_sep, msg]
	fatal(s_join(err_parts))

# Fatal error for an import path that doesn't resolve to an existing file.
fn void fatal_missing_import(string imp_path)
	string err_pre = "[error] cannot find import: "
	fatal(s_cat(err_pre, imp_path))

fn tokenList load_file(string path)
	string source = f_read(path)
	tokenList tok_raw = tokenize(source, path)
	tokenList result = empty
	int token_count = len(tok_raw)
	int pos = 0
	int depth = 0
	bool seen_decl = false
	int decl_phase = 0

	for if true

		is_at_end_of_file as pos >= token_count;
		if is_at_end_of_file
			break

		Token tok = tok_raw at pos
		(kind) in tok

		if kind is "EOF"
			break

		if kind is "INDENT"
			depth = depth + 1
			result at end = tok
			pos = pos + 1
			continue

		if kind is "DEDENT"
			depth = depth - 1
			result at end = tok
			pos = pos + 1
			continue

		bool at_root_depth = depth is 0

		# Enforces the file-level declaration order documented in best_practices.md:
		# imports -> structural declarations (struct/enum/type/shape, any order among
		# themselves) -> macros -> functions. Only checked at root depth — a macro
		# declared inside a function body is locally scoped and exempt.
		if at_root_depth
			bool is_structural_kw = kind is "KW_STRUCT" or kind is "KW_ENUM" or kind is "KW_SHAPE" or kind is "KW_TYPE"
			if is_structural_kw
				if decl_phase > 0
					string struct_order_msg = "struct/enum/type/shape declarations must come before macros and functions"
					fatal_at(path, struct_order_msg)
			if kind is "KW_MACRO" or kind is "KW_UNSAFE_MACRO"
				if decl_phase is 2
					string macro_order_msg = "macros must be declared before functions"
					fatal_at(path, macro_order_msg)
				else if decl_phase < 1
					decl_phase = 1
			if kind is "KW_FN"
				decl_phase = 2

		bool is_new_import = kind is "KW_IMPORT" and at_root_depth

		if is_new_import
			ParseResult import_result = scan_import_new(tok_raw, pos)
			string import_path = pr_code(import_result)
			int import_end = pr_pos(import_result)

			string import_type_concrete = ""
			string import_type_placeholder = ""

			ParseResult where_result = scan_import_where(tok_raw, import_end)
			import_type_code as pr_code(where_result)

			if not is_empty(import_type_code)
				import_end = pr_pos(where_result)
				const string PIPE = "|"
				list_code as s_split(import_type_code, PIPE)
				import_type_placeholder = list_code at 0
				import_type_concrete = list_code at 1

			import_path = resolve_lib_path(import_path)
			if not is_empty(import_path)
				if seen_decl
					string import_order_msg = "imports must appear at the top of the file before any declarations"
					fatal_at(path, import_order_msg)
				string dedup_key = import_path
				if not is_empty(import_type_concrete)
					dedup_key = s_join([import_path, "|", import_type_placeholder, "=", import_type_concrete])
				bool is_new = file_is_new_keyed(dedup_key)
				if is_new
					bool exists = f_exists(import_path)
					if not exists
						fatal_missing_import(import_path)
					tokenList import_tokens = load_file(import_path)
					if not is_empty(import_type_concrete)
						import_tokens = apply_t_substitution(import_tokens, import_type_placeholder, import_type_concrete)
					int import_len = len(import_tokens)
					for import_index in range(import_len)
						Token import_token = import_tokens at import_index
						(kind) in import_token
						bool import_is_eof = kind is "EOF"
						if not import_is_eof
							result at end = import_token
				pos = import_end
				continue
		if at_root_depth and kind is not "NEWLINE"
			seen_decl = true
		result at end = tok
		pos = pos + 1

	return result
