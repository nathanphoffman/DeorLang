# Named token kind strings produced by the lexer and compared against by the validator and codegen.
# Use `unsafe_macro_run token_kinds` at the top of any fn that reads or compares a token kind.

unsafe_macro token_kinds
	const string COMMA               = "COMMA"
	const string DEDENT              = "DEDENT"
	const string EQUALS              = "EQUALS"
	const string FLOAT               = "FLOAT"
	const string IDENT               = "IDENT"
	const string INDENT              = "INDENT"
	const string KW_AND              = "KW_AND"
	const string KW_AS               = "KW_AS"
	const string KW_AT               = "KW_AT"
	const string KW_AVOW             = "KW_AVOW"
	const string KW_BLOCK            = "KW_BLOCK"
	const string KW_BREAK            = "KW_BREAK"
	const string KW_CONST            = "KW_CONST"
	const string KW_CONTINUE         = "KW_CONTINUE"
	const string KW_ELSE             = "KW_ELSE"
	const string KW_EMPTY            = "KW_EMPTY"
	const string KW_END              = "KW_END"
	const string KW_ENUM             = "KW_ENUM"
	const string KW_FALSE            = "KW_FALSE"
	const string KW_FN               = "KW_FN"
	const string KW_FOR              = "KW_FOR"
	const string KW_FUNC             = "KW_FUNC"
	const string KW_IF               = "KW_IF"
	const string KW_IMPORT           = "KW_IMPORT"
	const string KW_IN               = "KW_IN"
	const string KW_IS               = "KW_IS"
	const string KW_LIST             = "KW_LIST"
	const string KW_MACRO            = "KW_MACRO"
	const string KW_MACRO_RUN        = "KW_MACRO_RUN"
	const string KW_MOVE             = "KW_MOVE"
	const string KW_NONE             = "KW_NONE"
	const string KW_NOT              = "KW_NOT"
	const string KW_OF               = "KW_OF"
	const string KW_OR               = "KW_OR"
	const string KW_RAW              = "KW_RAW"
	const string KW_REMOVE           = "KW_REMOVE"
	const string KW_RETURN           = "KW_RETURN"
	const string KW_RUST             = "KW_RUST"
	const string KW_SHAPE            = "KW_SHAPE"
	const string KW_STRUCT           = "KW_STRUCT"
	const string KW_TO               = "KW_TO"
	const string KW_TRUE             = "KW_TRUE"
	const string KW_TYPE             = "KW_TYPE"
	const string KW_UNSAFE_MACRO     = "KW_UNSAFE_MACRO"
	const string KW_UNSAFE_MACRO_RUN = "KW_UNSAFE_MACRO_RUN"
	const string KW_VALID            = "KW_VALID"
	const string KW_VOID             = "KW_VOID"
	const string KW_WITH             = "KW_WITH"
	const string LBRACKET            = "LBRACKET"
	const string LPAREN              = "LPAREN"
	const string MINUS               = "MINUS"
	const string NEWLINE             = "NEWLINE"
	const string PERCENT             = "PERCENT"
	const string PLUS                = "PLUS"
	const string RBRACKET            = "RBRACKET"
	const string RPAREN              = "RPAREN"
	const string RUST_BLOCK          = "RUST_BLOCK"
	const string SLASH               = "SLASH"
	const string STAR                = "STAR"
	const string STRING              = "STRING"
