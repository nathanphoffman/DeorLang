
# Token offsets for a `fn RetType name(params)` declaration header, counted from
# the position of the KW_FN token itself. Layout:
#   +0 KW_FN  +1 return type  +2 name (or LPAREN, if the return type was omitted)
#   +3 LPAREN (only valid when a return type is actually present)
fn int locate_fn_return_type(int kw_pos)
	return kw_pos + 1

fn int locate_fn_name(int kw_pos)
	return kw_pos + 2

fn int locate_fn_left_paren(int kw_pos)
	return kw_pos + 3
