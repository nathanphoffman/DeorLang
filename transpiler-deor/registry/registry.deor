
# === Registry builders ===
#
# Each concern has its own file under registry/:
#
#   registry/struct.deor         — skip_to_block_start, collect_struct_fields, try_struct_entry
#   registry/shape.deor          — try_shape_entry, try_raw_entry
#   registry/enum.deor           — try_enum_entry (enum_reg, variant_reg, typed_enum_reg, typed_variant_reg)
#   registry/validator_type.deor — try_type_entry
#   registry/type_resolve.deor   — resolve_type
#   registry/mut_scan.deor       — find_block_end_ref, collect_mut_names
#
# build_registry below dispatches to these try_*_entry functions from one shared walk
# of the token stream, the same way generate_rust_from_tokens (codegen.deor) dispatches
# to gen_*_decl — rather than each registry running its own independent full scan.

# Scans the full merged token stream once and builds every top-level registry
# (structs, shapes, enums/variants, validator types, typed enums/variants) that
# codegen needs to resolve names it encounters. mut_names and validator_var_reg
# start empty here — both are per-function, populated later (by collect_mut_names
# and collect_validator_var_types) when each fn body is generated.
fn RcCtx build_registry(TokensRef tokens_ref)
	strList struct_reg_list = empty
	strList shape_reg_list = empty
	strList enum_reg_list = empty
	strList variant_reg_list = empty
	strList type_reg_list = empty
	strList typed_enum_reg_list = empty
	strList typed_variant_reg_list = empty

	int token_count = len(tokens_ref)
	int pos = 0

	for if pos < token_count
		Token token = tokens_ref at pos
		move (kind) in token

		if kind is KW_STRUCT
			Reg2Scan scan = try_struct_entry(tokens_ref, pos)
			move (matched, key, val, new_pos) in scan

			if matched
				struct_reg_list at end = key
				struct_reg_list at end = val

			pos = new_pos

			continue

		if kind is KW_SHAPE
			Reg2Scan scan = try_shape_entry(tokens_ref, pos)
			move (matched, key, val, new_pos) in scan

			if matched
				shape_reg_list at end = key
				shape_reg_list at end = val

			pos = new_pos

			continue

		if kind is KW_RAW
			Reg2Scan scan = try_raw_entry(tokens_ref, pos)
			move (matched, key, val, new_pos) in scan

			if matched
				shape_reg_list at end = key
				shape_reg_list at end = val

			pos = new_pos

			continue

		if kind is KW_TYPE
			Reg3Scan scan = try_type_entry(tokens_ref, pos)
			move (matched, key, val, val2, new_pos) in scan

			if matched
				type_reg_list at end = key
				type_reg_list at end = val
				type_reg_list at end = val2

			pos = new_pos

			continue

		if kind is KW_ENUM
			EnumScan scan = try_enum_entry(tokens_ref, pos)
			move (matched, is_typed, name, rust_name, val_type, pairs, new_pos) in scan

			if matched
				if is_typed
					typed_enum_reg_list at end = name
					typed_enum_reg_list at end = val_type
					int typed_variant_count = len(pairs)

					for typed_variant_index in range(typed_variant_count)
						typed_variant_reg_list at end = pairs at typed_variant_index
				else
					enum_reg_list at end = name
					enum_reg_list at end = rust_name
					int variant_count = len(pairs)

					for variant_index in range(variant_count)
						variant_reg_list at end = pairs at variant_index

			pos = new_pos

			continue

		pos = pos + 1

	strList mut_names_list = empty
	strList validator_var_reg_list = empty
	ListRef struct_reg = list_wrap(move struct_reg_list)
	ListRef shape_reg = list_wrap(move shape_reg_list)
	ListRef enum_reg = list_wrap(move enum_reg_list)
	ListRef variant_reg = list_wrap(move variant_reg_list)
	ListRef type_reg = list_wrap(move type_reg_list)
	strList validator_fn_reg_list = collect_validator_fn_returns(tokens_ref, type_reg)
	ListRef typed_enum_reg = list_wrap(move typed_enum_reg_list)
	ListRef typed_variant_reg = list_wrap(move typed_variant_reg_list)
	ListRef mut_names = list_wrap(move mut_names_list)
	ListRef validator_var_reg = list_wrap(move validator_var_reg_list)
	ListRef validator_fn_reg = list_wrap(move validator_fn_reg_list)
	tokenList placeholder = empty
	TokensRef tokens = tokens_wrap(move placeholder)
	GenCtx ctx_raw = move (variant_reg, shape_reg, struct_reg, enum_reg, mut_names, type_reg, tokens, typed_enum_reg, typed_variant_reg, validator_var_reg, validator_fn_reg)
	RcCtx ctx = make_rctx(move ctx_raw)

	return ctx
