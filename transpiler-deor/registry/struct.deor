
# Struct registry: a flat strList of [structName, "field1,field2,..."] pairs, built one
# KW_STRUCT hit at a time by try_struct_entry below. Helpers walk a struct body to
# collect field names joined by commas.

fn ParseResult skip_to_block_start(TokensRef tokens, int start)
	int token_count = len(tokens)
	int cur = start
	for skip_index in range(start, token_count)
		Token skip_token = tokens at skip_index
		(kind) in skip_token
		cur = skip_index + 1
		if kind is "INDENT"
			break
	string empty_str = ""
	return make_result(empty_str, cur)

fn ParseResult collect_struct_fields(TokensRef tokens, int start)
	int token_count = len(tokens)
	strList fields = empty
	int cur = start
	for field_index in range(start, token_count)
		Token field_token = tokens at field_index
		(kind) in field_token
		if kind is "DEDENT"
			cur = field_index + 1
			break
		else if kind is "IDENT"
			# ex: int {x} — field_index+1 grabs the field name after its type
			int field_name_pos = field_index + 1
			if field_name_pos < token_count
				Token field_name_token = tokens at field_name_pos
				(kind, value) in field_name_token
				if kind is "IDENT"
					fields at end = value
					cur = field_name_pos + 1
	string comma = ","
	string fields_joined = s_join_with(fields, comma)
	return make_result(fields_joined, cur)

# Scans a single `struct Name\n\tfield decls...` declaration starting at a KW_STRUCT
# token. Called once per KW_STRUCT hit from build_registry's single-pass dispatch loop
# (registry.deor) rather than each registry running its own full scan over every token.
fn Reg2Scan try_struct_entry(TokensRef tokens, int pos)
	# ex: struct {Point} — kw_pos+1 grabs the struct name
	fn int locate_struct_name(int kw_pos)
		return kw_pos + 1

	# ex: struct Point{\n}\tint x — kw_pos+2 grabs the token after the struct name
	fn int locate_struct_body_start(int kw_pos)
		return kw_pos + 2

	int token_count = len(tokens)
	bool matched = false
	string key = ""
	string val = ""
	int new_pos = locate_struct_name(pos)
	int name_pos = locate_struct_name(pos)
	if name_pos < token_count
		Token name_token = tokens at name_pos
		(kind, value) in name_token
		if kind is "IDENT"
			matched = true
			key = value
			int block_start = locate_struct_body_start(pos)
			ParseResult block_result = skip_to_block_start(tokens, block_start)
			int field_start = pr_pos(block_result)
			ParseResult fields_result = collect_struct_fields(tokens, field_start)
			val = pr_code(fields_result)
			new_pos = pr_pos(fields_result)
	Reg2Scan result = (matched, key, val, new_pos)
	return result
