
# Shape registry. For list shapes stores [shapeName, elemType]; for function shapes
# stores [shapeName, "fn:inType:outType"]; for raw types (try_raw_entry below) stores
# [shapeName, "raw:"]. Used by resolve_type to expand shape aliases into Vec<T> or
# fn(T)->U Rust forms.

# Scans a single `shape Name = list of Elem` or `shape Name = func of In to Out`
# declaration starting at a KW_SHAPE token. Called once per KW_SHAPE hit from
# build_registry's single-pass dispatch loop (registry.deor) rather than each registry
# running its own full scan over every token.
fn Reg2Scan try_shape_entry(TokensRef tokens, int pos)
	int token_count = len(tokens)
	bool matched = false
	string key = ""
	string val = ""
	int new_pos = pos + 1
	int name_pos = pos + 1
	int form_pos = pos + 3
	int t4_pos = pos + 4
	if t4_pos < token_count
		Token name_token = tokens at name_pos
		Token form_token = tokens at form_pos
		(value) in name_token
		string shape_name = value
		(kind) in form_token
		if kind is "KW_LIST"
			int elem_pos = pos + 5
			if elem_pos < token_count
				Token elem_token = tokens at elem_pos
				(value) in elem_token
				matched = true
				key = shape_name
				val = value
		else
			Token t4_token = tokens at t4_pos
			(kind, value) in t4_token
			bool t4_is_of = kind is "KW_OF"
			bool t4_is_to = kind is "KW_TO"
			string in_type = ""
			string out_type = ""
			if t4_is_of
				int t5_pos = pos + 5
				if t5_pos < token_count
					Token t5_token = tokens at t5_pos
					(value) in t5_token
					in_type = value
				int t6_pos = pos + 6
				if t6_pos < token_count
					Token t6_token = tokens at t6_pos
					(kind, value) in t6_token
					bool t6_is_to = kind is "KW_TO"
					if t6_is_to
						int t7_pos = pos + 7
						if t7_pos < token_count
							Token t7_token = tokens at t7_pos
							(value) in t7_token
							out_type = value
			else if t4_is_to
				int t5_pos = pos + 5
				if t5_pos < token_count
					Token t5_token = tokens at t5_pos
					(value) in t5_token
					out_type = value
			matched = true
			key = shape_name
			val = s_join(["fn:", in_type, ":", out_type])
	Reg2Scan result = (matched, key, val, new_pos)
	return result

# Scans a single `raw TypeName` declaration starting at a KW_RAW token. Called once per
# KW_RAW hit from build_registry's single-pass dispatch loop (registry.deor).
fn Reg2Scan try_raw_entry(TokensRef tokens, int pos)
	int token_count = len(tokens)
	bool matched = false
	string key = ""
	string val = ""
	int new_pos = pos + 1
	int name_pos = pos + 1
	if name_pos < token_count
		Token name_token = tokens at name_pos
		(value) in name_token
		matched = true
		key = value
		val = "raw:"
	Reg2Scan result = (matched, key, val, new_pos)
	return result
