
# Shape registry. For list shapes stores [shapeName, elemType]; for function shapes
# stores [shapeName, "fn:inType:outType"]; for raw types (try_raw_entry below) stores
# [shapeName, "raw:"]. Used by resolve_type to expand shape aliases into Vec<T> or
# fn(T)->U Rust forms.

# Scans a single `shape Name = list of Elem` or `shape Name = func of In to Out`
# declaration starting at a KW_SHAPE token. Called once per KW_SHAPE hit from
# build_registry's single-pass dispatch loop (registry.deor) rather than each registry
# running its own full scan over every token.
fn Reg2Scan try_shape_entry(TokensRef tokens, int pos)
	# ex: shape {Foo} = list of T — kw_pos+1 grabs the shape name
	fn int locate_shape_name(int kw_pos)
		return kw_pos + 1

	# ex: shape Foo = {list} of T — kw_pos+3 grabs the form keyword (list/func)
	fn int locate_shape_form(int kw_pos)
		return kw_pos + 3

	# ex: shape Foo = func {of} T to U — kw_pos+4 grabs KW_OF/KW_TO (or nothing, if bare func)
	fn int locate_func_of_or_to(int kw_pos)
		return kw_pos + 4

	# ex: shape Foo = list of {T} — kw_pos+5 grabs the element type
	fn int locate_list_elem(int kw_pos)
		return kw_pos + 5

	# ex: shape Foo = func of {T} to U — kw_pos+5 grabs the input type
	fn int locate_func_in_type(int kw_pos)
		return kw_pos + 5

	# ex: shape Foo = func of T {to} U — kw_pos+6 grabs KW_TO (or nothing, if no output)
	fn int locate_func_to_after_of(int kw_pos)
		return kw_pos + 6

	# ex: shape Foo = func of T to {U} — kw_pos+7 grabs the output type
	fn int locate_func_out_type_after_of(int kw_pos)
		return kw_pos + 7

	# ex: shape Foo = func to {U} — kw_pos+5 grabs the output type (no of-clause)
	fn int locate_func_out_type_after_to(int kw_pos)
		return kw_pos + 5

	int token_count = len(tokens)
	bool matched = false
	string key = ""
	string val = ""
	int new_pos = locate_shape_name(pos)
	int name_pos = locate_shape_name(pos)
	int form_pos = locate_shape_form(pos)
	int of_or_to_pos = locate_func_of_or_to(pos)
	if of_or_to_pos < token_count
		Token name_token = tokens at name_pos
		Token form_token = tokens at form_pos
		(value) in name_token
		string shape_name = value
		(kind) in form_token
		if kind is "KW_LIST"
			int elem_pos = locate_list_elem(pos)
			if elem_pos < token_count
				Token elem_token = tokens at elem_pos
				(value) in elem_token
				matched = true
				key = shape_name
				val = value
		else
			Token of_or_to_token = tokens at of_or_to_pos
			(kind, value) in of_or_to_token
			bool is_of = kind is "KW_OF"
			bool is_to = kind is "KW_TO"
			string in_type = ""
			string out_type = ""
			if is_of
				int in_type_pos = locate_func_in_type(pos)
				if in_type_pos < token_count
					Token in_type_token = tokens at in_type_pos
					(value) in in_type_token
					in_type = value
				int to_pos = locate_func_to_after_of(pos)
				if to_pos < token_count
					Token to_token = tokens at to_pos
					(kind, value) in to_token
					bool has_to = kind is "KW_TO"
					if has_to
						int out_type_pos = locate_func_out_type_after_of(pos)
						if out_type_pos < token_count
							Token out_type_token = tokens at out_type_pos
							(value) in out_type_token
							out_type = value
			else if is_to
				int out_type_pos = locate_func_out_type_after_to(pos)
				if out_type_pos < token_count
					Token out_type_token = tokens at out_type_pos
					(value) in out_type_token
					out_type = value
			matched = true
			key = shape_name
			val = s_join(["fn:", in_type, ":", out_type])
	Reg2Scan result = (matched, key, val, new_pos)
	return result

# Scans a single `raw TypeName` declaration starting at a KW_RAW token. Called once per
# KW_RAW hit from build_registry's single-pass dispatch loop (registry.deor).
fn Reg2Scan try_raw_entry(TokensRef tokens, int pos)
	# ex: raw {TypeName} — kw_pos+1 grabs the raw type's name
	fn int locate_raw_name(int kw_pos)
		return kw_pos + 1

	int token_count = len(tokens)
	bool matched = false
	string key = ""
	string val = ""
	int new_pos = locate_raw_name(pos)
	int name_pos = locate_raw_name(pos)
	if name_pos < token_count
		Token name_token = tokens at name_pos
		(value) in name_token
		matched = true
		key = value
		val = "raw:"
	Reg2Scan result = (matched, key, val, new_pos)
	return result
