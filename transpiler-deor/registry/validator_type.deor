
# Scans a single `type Name(baseType paramName)` declaration starting at a KW_TYPE
# token, producing the [Name, baseType, paramName] triplet the validator-type registry
# stores. Enables the code generator to emit `Name::new(val)` for construction sites and
# `Option<Name>` for empty declarations. Called once per KW_TYPE hit from build_registry's
# single-pass dispatch loop (registry.deor).
fn Reg3Scan try_type_entry(TokensRef tokens, int pos)
	# ex: type {Positive}(int val) — kw_pos+1 grabs the validator type's name
	fn int locate_type_name(int kw_pos)
		return kw_pos + 1

	# ex: type Positive({int} val) — kw_pos+3 grabs the base type
	fn int locate_type_param_type(int kw_pos)
		return kw_pos + 3

	# ex: type Positive(int {val}) — kw_pos+4 grabs the param name
	fn int locate_type_param_name(int kw_pos)
		return kw_pos + 4

	int token_count = len(tokens)
	bool matched = false
	string key = ""
	string val = ""
	string val2 = ""
	int new_pos = locate_type_name(pos)
	int name_pos = locate_type_name(pos)
	int param_type_pos = locate_type_param_type(pos)
	int param_name_pos = locate_type_param_name(pos)

	if param_name_pos < token_count
		Token name_token = tokens at name_pos
		Token param_type_token = tokens at param_type_pos
		Token param_name_token = tokens at param_name_pos
		matched = true
		(value) in name_token
		key = value
		(value) in param_type_token
		val = value
		(value) in param_name_token
		val2 = value

	Reg3Scan result = (matched, key, val, val2, new_pos)

	return result

# Scans a function body's token range for `TypeName varName` declarations where TypeName
# is a known validator type (bare `TypeName varName` or the full `TypeName varName = expr`
# form both match — only the leading pair matters here). Builds [varName, TypeName] pairs
# so a later bare reassignment (`varName = expr`) can look up which validator type to
# re-run the predicate through — see gen_stmt's plain-reassignment branch in stmt.deor.
fn strList collect_validator_var_types(tokenList tokens, strList type_reg)
	unsafe_macro_run token_kinds
	strList result = empty
	int token_count = len(tokens)

	for index in range(token_count)
		Token token = tokens at index
		(kind, value) in token

		if kind is IDENT
			string maybe_type = value
			bool is_vtype = reg3_has(type_reg, maybe_type)

			if is_vtype
				int next_pos = index + 1

				if next_pos < token_count
					Token next_token = tokens at next_pos
					(kind, value) in next_token

					if kind is IDENT
						string var_name = value
						result at end = var_name
						result at end = maybe_type

	return result

# Scans every `fn ReturnType name(` declaration whose return type is a validator type and
# builds [fnName, ReturnType] pairs. A binding or reassignment whose value is a call to one
# of these functions already holds an Option<ReturnType>, so codegen must not wrap it in
# ReturnType::new() again — and function bodies only see their own tokens, so this has to be
# gathered here from the whole file.
fn strList collect_validator_fn_returns(TokensRef tokens, strList type_reg)
	unsafe_macro_run token_kinds

	# ex: fn Roll {find_best}( — decl_pos+2 grabs the function name after the return type
	fn int locate_fn_name(int decl_pos)
		return decl_pos + 2

	strList result = empty
	int token_count = len(tokens)

	for index in range(token_count)
		Token decl_token = tokens at index
		(kind) in decl_token

		if kind is KW_FN
			int type_pos = index + 1
			int name_pos = locate_fn_name(index)

			if name_pos < token_count
				Token type_token = tokens at type_pos
				Token name_token = tokens at name_pos
				(value) in type_token
				string return_type = value
				(value) in name_token
				string fn_name = value

				if reg3_has(type_reg, return_type)
					result at end = fn_name
					result at end = return_type

	return result
