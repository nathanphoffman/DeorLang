# Builds the enum and variant registries.
# enum_reg:    [deorName, RustName] pairs (deorName lowercase, RustName PascalCase)
# variant_reg: [variantName, rustEnumName] pairs for every variant of every untyped enum
#
# typed_enum_reg:    [enumName, valueType] pairs for typed enums (enum string/int/float/bool Name)
# typed_variant_reg: ["EnumName.VariantName", literalValue] pairs for typed enum variants

# Small (pairs, new_pos) return used only by the two variant-body scanners below — the
# variant list of a single enum, never the whole-program registry, so returning it from
# a function is a bounded, one-off cost rather than the per-token clone that returning
# the big accumulator lists themselves would be.
struct PairsScan
	strList pairs
	int new_pos

# Scans a single `enum Name` or `enum baseType Name` declaration starting at a KW_ENUM
# token, covering all four enum registries in one walk of the declaration (previously
# four separate full-token-stream scans: build_enum_reg, build_variant_reg,
# build_typed_enum_reg, build_typed_variant_reg). Called once per KW_ENUM hit from
# build_registry's single-pass dispatch loop (registry.deor). `is_typed` tells the
# caller which pair of registries `name`/`rust_name`/`val_type`/`pairs` belong to:
# untyped -> (enum_reg: name+rust_name, variant_reg: pairs); typed -> (typed_enum_reg:
# name+val_type, typed_variant_reg: pairs).
struct EnumScan
	bool matched
	bool is_typed
	string name
	string rust_name
	string val_type
	strList pairs
	int new_pos

fn bool is_typed_enum_type(string word)
	if word is "string"
		return true
	if word is "int"
		return true
	if word is "float"
		return true
	if word is "bool"
		return true
	return false

# Named accessors for PairsScan (Deor has no dot-access syntax) — used inside
# try_enum_entry, which already has its own locals named `pairs`/`new_pos` in scope, so
# destructuring a PairsScan there directly would collide with them.
fn strList ps_pairs(PairsScan scan)
	rust
		scan.pairs

fn int ps_new_pos(PairsScan scan)
	rust
		scan.new_pos

# Scans an untyped enum's variant list (already positioned at its opening INDENT) into
# [variantName, rustEnumName] pairs.
fn PairsScan collect_variant_pairs(TokensRef tokens, int start, string rust_name)
	int token_count = len(tokens)
	strList pairs = empty
	int new_pos = start
	bool scanning = true
	for if scanning
		if new_pos >= token_count
			scanning = false
		else
			Token variant_token = tokens at new_pos
			(kind, value) in variant_token
			new_pos = new_pos + 1
			if kind is "DEDENT"
				scanning = false
			else if kind is "IDENT"
				pairs at end = value
				pairs at end = rust_name
	PairsScan result = (pairs, new_pos)
	return result

# Scans a typed enum's variant list (already positioned at its opening INDENT) into
# ["EnumName.VariantName", literalValue] pairs.
fn PairsScan collect_typed_variant_pairs(TokensRef tokens, int start, string enum_name)
	int token_count = len(tokens)
	strList pairs = empty
	int new_pos = start
	bool scanning = true
	for if scanning
		if new_pos >= token_count
			scanning = false
		else
			Token variant_token = tokens at new_pos
			(kind, value) in variant_token
			new_pos = new_pos + 1
			if kind is "DEDENT"
				scanning = false
			else if kind is "IDENT"
				string variant_name = value
				if new_pos < token_count
					Token equals_token = tokens at new_pos
					(kind) in equals_token
					new_pos = new_pos + 1
					if kind is "EQUALS"
						if new_pos < token_count
							Token literal_token = tokens at new_pos
							(value) in literal_token
							new_pos = new_pos + 1
							string dot = "."
							string variant_key = s_join([enum_name, dot, variant_name])
							pairs at end = variant_key
							pairs at end = value
	PairsScan result = (pairs, new_pos)
	return result

fn EnumScan try_enum_entry(TokensRef tokens, int pos)
	# ex: enum {Color} — kw_pos+1 grabs the enum name (or type keyword if typed)
	fn int locate_type_or_name(int kw_pos)
		return kw_pos + 1

	# ex: enum int {Status} — kw_pos+2 grabs the enum name, when typed
	fn int locate_typed_name(int kw_pos)
		return kw_pos + 2

	# ex: enum int Status{\n}    ... — kw_pos+3 grabs the token that starts the body scan, when typed
	fn int locate_typed_body_start(int kw_pos)
		return kw_pos + 3

	# ex: enum ColorTag{\n}    ... — kw_pos+2 grabs the token that starts the body scan, when untyped
	fn int locate_untyped_body_start(int kw_pos)
		return kw_pos + 2

	int token_count = len(tokens)
	bool matched = false
	bool is_typed = false
	string name = ""
	string rust_name = ""
	string val_type = ""
	strList pairs = empty
	int new_pos = locate_type_or_name(pos)

	int type_pos = locate_type_or_name(pos)
	if type_pos < token_count
		Token type_token = tokens at type_pos
		(kind, value) in type_token
		if kind is "IDENT"
			bool word_is_typed = is_typed_enum_type(value)
			if word_is_typed
				matched = true
				is_typed = true
				val_type = value
				int name_pos = locate_typed_name(pos)
				if name_pos < token_count
					Token name_token = tokens at name_pos
					(value) in name_token
					name = value
					int body_start = locate_typed_body_start(pos)
					ParseResult block_result = skip_to_block_start(tokens, body_start)
					int scan_start = pr_pos(block_result)
					PairsScan pairs_result = collect_typed_variant_pairs(tokens, scan_start, name)
					pairs = ps_pairs(pairs_result)
					new_pos = ps_new_pos(pairs_result)
			else
				matched = true
				is_typed = false
				name = value
				rust_name = s_pascal(name)
				int body_start = locate_untyped_body_start(pos)
				ParseResult block_result = skip_to_block_start(tokens, body_start)
				int scan_start = pr_pos(block_result)
				PairsScan pairs_result = collect_variant_pairs(tokens, scan_start, rust_name)
				pairs = ps_pairs(pairs_result)
				new_pos = ps_new_pos(pairs_result)
	EnumScan result = (matched, is_typed, name, rust_name, val_type, pairs, new_pos)
	return result
