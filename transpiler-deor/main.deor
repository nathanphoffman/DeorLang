import "transpiler-deor/imports.deor"
import "transpiler-deor/macros/timer.deor"

# Entry point. Reads input and output paths from command-line arguments, calls
# collect_all_tokens_with_all_imports to load and resolve all imports, calls generate
# to produce Rust source, and writes it to the output file.
fn void main()
	ENFORCE_UNIQUE_FILE_DECLARATIONS

	strList raw_args = f_args()
	string verbose_long = "--verbose"
	string verbose_short = "-v"
	bool verbose = list_has(raw_args, verbose_long) or list_has(raw_args, verbose_short)
	if verbose
		verbose_enable()

	strList cli_args = empty
	int raw_count = len(raw_args)
	int raw_i = 0
	for if raw_i < raw_count
		string raw_arg = raw_args at raw_i
		bool is_verbose_flag = raw_arg is verbose_long or raw_arg is verbose_short
		if not is_verbose_flag
			cli_args at end = raw_arg
		raw_i = raw_i + 1

	int arg_count = len(cli_args)

	if arg_count < 2
		print("usage: deor input.deor output.rs [--verbose|-v]")
	else
		string input_path = cli_args at 0
		string output_path = cli_args at 1

		string _timer_label = "[timer] load+dedup: "
		unsafe_macro_run timer_start
		DedupResult dedup_r = collect_all_tokens_with_all_imports(input_path)
		macro_run timer_end
		(tokens, enforce_macro_file_depth) in dedup_r

		_timer_label = "[timer] macro-build: "
		unsafe_macro_run timer_start
		tokens = build_macros(tokens, enforce_macro_file_depth)
		macro_run timer_end

		TokensRef tokens_ref = tokens_wrap(move tokens)

		_timer_label = "[timer] validate: "
		unsafe_macro_run timer_start
		validate_tokens(tokens_ref)
		macro_run timer_end

		_timer_label = "[timer] registry: "
		unsafe_macro_run timer_start
		ctx as build_registry(tokens_ref)
		macro_run timer_end

		_timer_label = "[timer] total-codegen: "
		unsafe_macro_run timer_start
		string rust_code = generate_rust_from_tokens(tokens_ref, ctx)
		macro_run timer_end

		string allow_warnings = "#![allow(warnings)]\n"
		rust_code = s_cat(allow_warnings, rust_code)
		f_write(output_path, rust_code)
