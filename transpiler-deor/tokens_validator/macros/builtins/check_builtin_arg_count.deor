
# Shared detector for "known builtin called with wrong argument count" — used by
# check_crash_args (crash, exactly 1 arg) and check_print_args (print, 1-2 args).
# Parameterized via builtin_name, min_args, max_args, arg_count_rule — set these
# immediately before `macro_run check_builtin_arg_count`.
macro check_builtin_arg_count
	# ex: crash{(}"msg") — kw_pos+1 grabs the opening paren
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if cur_kind is "IDENT"
		bool is_target = cur_val is builtin_name
		if is_target
			int left_paren_pos = locate_next_token(pos)
			if left_paren_pos < token_count
				Token left_paren_token = tokens at left_paren_pos
				(kind) in left_paren_token
				if kind is "LPAREN"
					int arg_count = count_call_args(tokens, left_paren_pos)
					bool count_ok = arg_count >= min_args and arg_count <= max_args
					if not count_ok
						errors at end = val_err(tok, lbl_call, arg_count_rule)
