
# Whole-variable move tracking: marks a variable moved when it's consumed by
# `move name` or by entering a `for move (item in collection)` loop, and
# flags a bare read of a variable already in that state. Flow-sensitivity
# across if/else-if/else chains is handled separately by
# check_use_after_move_chain, which folds/unions moved_vars around this
# macro's marks. Part of check_use_after_move — see that macro's header for
# the full picture, including the separate partial-field-move tracking.
#
# Split into three concept-sized sub-macros, each independent and order
# between them doesn't matter (aside from check_use_after_move_var_ident
# needing to run after check_use_after_move_var_for so the loop variable it
# just marked moved isn't immediately re-flagged as a read) — see each
# sub-macro's own header for its Reads/Writes:
#   check_use_after_move_var_for   — `for move (item in collection)` marking
#   check_use_after_move_var_move  — `move name` marking + double-move check
#   check_use_after_move_var_ident — bare IDENT: fresh binding vs. read check
macro check_use_after_move_var
	macro_run check_use_after_move_var_for
	macro_run check_use_after_move_var_move
	macro_run check_use_after_move_var_ident
