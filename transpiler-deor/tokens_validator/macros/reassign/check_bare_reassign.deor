
# Shared detector for "bare reassignment of a tracked name" — used by both
# check_const_reassign (const bindings) and check_validator_reassign (validator
# type variables). Fires when cur_val is a tracked name, the next token is
# EQUALS (when allow_eq) or KW_AS (when allow_as), and the previous
# token is not an IDENT — i.e. this isn't the original typed declaration, it's
# a later bare `name = expr` / `name as expr` that skips re-running the real
# declaration form. Parameterized via bare_reassign_names, allow_eq, allow_as,
# bare_reassign_rule — set these immediately before `macro_run check_bare_reassign`.
macro check_bare_reassign
	# ex: pipe {=} "new" — kw_pos+1 grabs the token right after the tracked name
	fn int locate_after_name(int kw_pos)
		return kw_pos + 1

	# ex: {string} pipe = "new" — kw_pos-1 checks for a preceding type IDENT (a real decl)
	fn int locate_before_name(int kw_pos)
		return kw_pos - 1

	bool is_tracked = list_has(bare_reassign_names, cur_val)
	if is_tracked
		int after_pos = locate_after_name(pos)
		if after_pos < token_count
			Token after_token = tokens at after_pos
			(kind) in after_token
			bool is_eq = false
			if allow_eq
				is_eq = kind is "EQUALS"
			bool is_as = false
			if allow_as
				is_as = kind is "KW_AS"
			if is_eq or is_as
				bool is_decl = false
				if pos > 0
					int before_pos = locate_before_name(pos)
					Token before_token = tokens at before_pos
					(kind) in before_token
					is_decl = kind is "IDENT"
				if not is_decl
					errors at end = val_err(tok, lbl_var, bare_reassign_rule)
