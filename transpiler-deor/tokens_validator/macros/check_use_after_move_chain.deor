
# Flow-sensitive tracking of whole-variable moves across an if/else-if/else
# chain, via a stack of UamFrame snapshots (one per open chain, keyed by
# block_depth). Branches are mutually exclusive, so a move inside one arm
# must not poison a sibling arm — each arm has to start from the same
# pre-chain snapshot. But a move IS carried forward past the whole chain if
# any reachable arm made it, because rustc can't know at that point which
# arm actually ran — the same rule rustc itself applies. Part of
# check_use_after_move — see that macro's header for the full picture,
# including the separate (non-flow-sensitive) partial-field-move tracking.
# Reads: cur_kind, pos, tokens, token_count, block_depth, move_if_stack, moved_vars.
# Writes: move_if_stack, moved_vars.
macro check_use_after_move_chain
	# KW_IF opens a new chain frame — unless this IF is the "if" half of an
	# "else if", which belongs to the chain already on the stack (else and if
	# are two flat tokens on the same line, not a nested if inside an else
	# block — see docs/conditionals.md).
	if cur_kind is "KW_IF"
		bool uam_is_elseif = false
		if pos > 0
			int uam_pif_pos = pos - 1
			Token uam_pif_tok = tokens at uam_pif_pos
			(kind) in uam_pif_tok
			if kind is "KW_ELSE"
				uam_is_elseif = true
		if not uam_is_elseif
			int uam_depth = block_depth
			strList uam_pre_vars = moved_vars
			strList uam_acc_vars = moved_vars
			UamFrame uam_new_frame = (uam_depth, uam_pre_vars, uam_acc_vars)
			move_if_stack at end = uam_new_frame

	# KW_ELSE — the arm that just closed (its DEDENT ran immediately before
	# this token) is folded into the chain's accumulator — unless that arm's
	# last statement is KW_RETURN/KW_BREAK/KW_CONTINUE, in which case it never
	# falls through to code after the chain at all, so its moves must not be
	# treated as reachable there (the extremely common "if kind is X: return
	# ..." dispatch idiom throughout this codebase relies on this). Either
	# way, moved_vars is restored to the pre-chain snapshot so the next arm
	# starts from the same base as every other arm, not from what the
	# previous arm moved.
	if cur_kind is "KW_ELSE"
		int uam_efs_len = len(move_if_stack)
		if uam_efs_len > 0
			int uam_etop_idx = uam_efs_len - 1
			UamFrame uam_etop = move_if_stack at uam_etop_idx
			(uam_depth, uam_pre_vars, uam_acc_vars) in uam_etop
			if uam_depth is block_depth
				bool uam_e_terminal = false
				int uam_et_scan = pos - 1
				for if uam_et_scan >= 0
					Token uam_et_tok = tokens at uam_et_scan
					(kind) in uam_et_tok
					if kind is "NEWLINE"
						uam_et_scan = uam_et_scan - 1
					else
						break
				int uam_et_line_end = uam_et_scan
				for if uam_et_scan >= 0
					Token uam_et_tok2 = tokens at uam_et_scan
					(kind) in uam_et_tok2
					if kind is "NEWLINE"
						break
					if kind is "INDENT"
						break
					if kind is "DEDENT"
						break
					uam_et_scan = uam_et_scan - 1
				int uam_et_line_start = uam_et_scan + 1
				if uam_et_line_start <= uam_et_line_end
					Token uam_et_first = tokens at uam_et_line_start
					(kind) in uam_et_first
					if kind is "KW_RETURN"
						uam_e_terminal = true
					if kind is "KW_BREAK"
						uam_e_terminal = true
					if kind is "KW_CONTINUE"
						uam_e_terminal = true
				if not uam_e_terminal
					int uam_ei = 0
					int uam_en = len(moved_vars)
					for if uam_ei < uam_en
						string uam_ev = moved_vars at uam_ei
						bool uam_e_has = list_has(uam_acc_vars, uam_ev)
						if not uam_e_has
							uam_acc_vars at end = uam_ev
						uam_ei = uam_ei + 1
				move_if_stack remove at uam_etop_idx
				UamFrame uam_updated = (uam_depth, uam_pre_vars, uam_acc_vars)
				move_if_stack at end = uam_updated
				moved_vars = uam_pre_vars

	# DEDENT — only acts when it closes the last arm of a tracked chain (the
	# next token isn't KW_ELSE, so no more arms follow). Folds this final arm
	# into the accumulator (unless it's terminal — same reasoning as the
	# KW_ELSE case above) and that union becomes moved_vars going forward.
	# Every other DEDENT (closing a for/fn body, or a chain arm followed by
	# another else) is a no-op — nothing is cleared, so a move followed by a
	# read in later straight-line code is still caught.
	if cur_kind is "DEDENT"
		int uam_dfs_len = len(move_if_stack)
		if uam_dfs_len > 0
			int uam_dtop_idx = uam_dfs_len - 1
			UamFrame uam_dtop = move_if_stack at uam_dtop_idx
			(uam_depth, uam_acc_vars) in uam_dtop
			if uam_depth is block_depth
				bool uam_next_is_else = false
				int uam_after_dedent = pos + 1
				if uam_after_dedent < token_count
					Token uam_ad_tok = tokens at uam_after_dedent
					(kind) in uam_ad_tok
					if kind is "KW_ELSE"
						uam_next_is_else = true
				if not uam_next_is_else
					bool uam_d_terminal = false
					int uam_dt_scan = pos - 1
					for if uam_dt_scan >= 0
						Token uam_dt_tok = tokens at uam_dt_scan
						(kind) in uam_dt_tok
						if kind is "NEWLINE"
							uam_dt_scan = uam_dt_scan - 1
						else
							break
					int uam_dt_line_end = uam_dt_scan
					for if uam_dt_scan >= 0
						Token uam_dt_tok2 = tokens at uam_dt_scan
						(kind) in uam_dt_tok2
						if kind is "NEWLINE"
							break
						if kind is "INDENT"
							break
						if kind is "DEDENT"
							break
						uam_dt_scan = uam_dt_scan - 1
					int uam_dt_line_start = uam_dt_scan + 1
					if uam_dt_line_start <= uam_dt_line_end
						Token uam_dt_first = tokens at uam_dt_line_start
						(kind) in uam_dt_first
						if kind is "KW_RETURN"
							uam_d_terminal = true
						if kind is "KW_BREAK"
							uam_d_terminal = true
						if kind is "KW_CONTINUE"
							uam_d_terminal = true
					if not uam_d_terminal
						int uam_di = 0
						int uam_dn = len(moved_vars)
						for if uam_di < uam_dn
							string uam_dv = moved_vars at uam_di
							bool uam_d_has = list_has(uam_acc_vars, uam_dv)
							if not uam_d_has
								uam_acc_vars at end = uam_dv
							uam_di = uam_di + 1
					move_if_stack remove at uam_dtop_idx
					moved_vars = uam_acc_vars
