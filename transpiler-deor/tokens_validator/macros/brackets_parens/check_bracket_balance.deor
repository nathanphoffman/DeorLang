
# Whole-file bracket-balance check, run once before any other validation and
# short-circuited on immediately — same rationale as check_paren_balance.deor:
# a stray unmatched '[' or ']' should be reported cleanly on its own, rather than
# left to surface later as a confusing downstream error or a silent miscompile.
# open_line/open_file only update on a depth 0 -> 1 transition, so a later, properly
# matched top-level group (e.g. an unrelated list literal further down the file)
# never overwrites the line of the group that's actually left open.
macro check_bracket_balance
	int depth = 0
	int open_line = 0
	string open_file = ""
	int scan_i = 0
	for if scan_i < token_count
		Token scan_token = tokens at scan_i
		(kind, line, file) in scan_token
		if kind is "LBRACKET"
			if depth is 0
				open_line = line
				open_file = file
			depth = depth + 1
		else if kind is "RBRACKET"
			if depth is 0
				errors at end = val_err(scan_token, lbl_var, rule_unmatched_close_bracket)
			else
				depth = depth - 1
		scan_i = scan_i + 1
	if depth > 0
		string kind = "LBRACKET"
		string value = "["
		int line = open_line
		string file = open_file
		Token open_token = (kind, value, line, file)
		errors at end = val_err(open_token, lbl_var, rule_unmatched_open_bracket)
