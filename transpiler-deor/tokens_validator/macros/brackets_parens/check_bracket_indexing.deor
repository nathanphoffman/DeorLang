
# Flags `name[index]` bracket indexing, which is not valid in Deor — use `name at index` instead.
macro check_bracket_indexing
	# ex: data{[}0] — kw_pos+1 checks for a '[' right after the name (invalid indexing)
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	int next_pos = locate_next_token(pos)
	if next_pos < token_count
		Token next_token = tokens at next_pos
		(kind) in next_token
		if kind is "LBRACKET"
			errors at end = val_err(tok, lbl_var, rule_bracket_index)
