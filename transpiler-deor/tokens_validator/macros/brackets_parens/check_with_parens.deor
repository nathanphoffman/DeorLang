# Ensures `with` is always followed by a parenthesized field list — `with (f1, f2)`,
# parens required even for a single field — for both the `as` and typed-decl forms.
# Without this, a missing paren left the with-scanning loop's cursor stuck on the
# first token that isn't RPAREN/COMMA/IDENT (e.g. a NEWLINE), hanging the compiler
# forever instead of erroring. Same root cause check_destructure_binding_kw guards
# against for `(f1, keyword) in expr`.
macro check_with_parens
	# ex: with {(}f1, f2) — kw_pos+1 grabs the token after with
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if cur_kind is KW_WITH
		# ex: name {=} source with — `with` has no codegen for a plain reassignment
		# (it needs the struct's Rust type), so only declarations may use it.
		# `name = move source with` has one more token between `=` and `with`.
		int source_gap = 2

		if pos >= 3
			int move_pos = pos - 2
			kind as token_kind_at(tokens, move_pos)

			if kind is KW_MOVE
				source_gap = 3

		if pos >= source_gap + 1
			int eq_pos = pos - source_gap
			kind as token_kind_at(tokens, eq_pos)

			if kind is EQUALS
				bool is_typed_decl = false
				int type_gap = source_gap + 2

				if pos >= type_gap
					int type_pos = pos - type_gap
					kind as token_kind_at(tokens, type_pos)
					is_typed_decl = kind is IDENT

				if not is_typed_decl
					errors at end = val_err(tok, lbl_var, rule_with_assign)

		bool with_ok = false
		int next_pos = locate_next_token(pos)

		if next_pos < token_count
			kind as token_kind_at(tokens, next_pos)
			with_ok = kind is LPAREN

		if not with_ok
			errors at end = val_err(tok, lbl_var, rule_with_parens)

		# The list may hold only field names and commas: `with (grown as traders)`
		# leaves the codegen scanner stuck on `as` and hangs the compiler.
		if with_ok
			int scan_pos = next_pos + 1
			bool scanning = true

			for if scanning and scan_pos < token_count
				Token scan_token = tokens at scan_pos
				(kind) in scan_token

				if kind is RPAREN
					scanning = false
				else if kind is IDENT or kind is COMMA
					scan_pos = scan_pos + 1
				else
					errors at end = val_err(scan_token, lbl_var, rule_with_fields)
					scanning = false
