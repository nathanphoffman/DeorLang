
# Skips over raw `rust { ... }` blocks during validation so their contents are not
# checked as Deor tokens. A well-formed standalone rust block is always exactly
# KW_RUST NEWLINE RUST_BLOCK — checked directly rather than scanned for, so a
# malformed KW_RUST (e.g. one that isn't a real block-introducing statement) falls
# through untouched instead of scanning to end-of-file looking for a RUST_BLOCK
# that will never appear.
macro skip_rust_block
	# ex: rust {NEWLINE} then the raw block — kw_pos+1 grabs the newline that must follow rust
	fn int locate_newline(int kw_pos)
		return kw_pos + 1

	# ex: rust NEWLINE {RUST_BLOCK} — kw_pos+2 grabs the raw block body
	fn int locate_rust_block(int kw_pos)
		return kw_pos + 2

	if cur_kind is "KW_RUST"
		int newline_pos = locate_newline(pos)
		int block_pos = locate_rust_block(pos)
		bool is_block = false
		if block_pos < token_count
			Token newline_token = tokens at newline_pos
			Token block_token = tokens at block_pos
			(kind) in newline_token
			bool newline_ok = kind is "NEWLINE"
			(kind) in block_token
			bool block_ok = kind is "RUST_BLOCK"
			is_block = newline_ok and block_ok
		if is_block
			pos = block_pos + 1
			continue
