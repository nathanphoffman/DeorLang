
# moved_fields (partial-move destructure tracking) stays same-block only —
# see check_use_after_move's header comment for why this half isn't
# flow-sensitive like moved_vars.
# Reads: cur_kind.
# Writes: moved_fields.
macro check_use_after_move_field_reset
	if cur_kind is "INDENT"
		rust
			moved_fields.clear();
	if cur_kind is "DEDENT"
		rust
			moved_fields.clear();
	if cur_kind is "KW_ELSE"
		rust
			moved_fields.clear();
