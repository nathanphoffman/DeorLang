
# Whole-variable move tracking, bare IDENT case: a bare IDENT is either a
# fresh binding (name = ... / name as ...), which clears any moved/partial-
# move-field state for that name since a new value now occupies it, or a
# read, which is flagged if that name is in moved_vars and isn't a Copy
# type. skip_read covers every syntactic position an IDENT can appear in
# that is not actually a value read (struct/enum member access,
# declaration/call-target/keyword-adjacent slots, and the loop variable
# check_use_after_move_var_for's KW_FOR handling marks moved on this same
# pass). Part of check_use_after_move_var — see that macro's header for the
# full picture of whole-variable move tracking, and check_use_after_move's
# header for how this fits into the larger use-after-move check.
# Reads: cur_kind, cur_val, tok, pos, tokens, token_count, in_struct_body,
#   in_enum_body, moved_vars, copy_var_names, lbl_var, rule_use_after_move.
# Writes: moved_vars, moved_fields, errors.
macro check_use_after_move_var_ident
	# ex: name{=} / name{as} / name{(} — kw_pos+1 grabs the token that decides
	# fresh-binding vs. read
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	# ex: {move} name — kw_pos-1 grabs the token before this IDENT
	fn int locate_prev_token(int kw_pos)
		return kw_pos - 1

	if cur_kind is "IDENT"
		int next_pos = locate_next_token(pos)
		bool is_binding = false
		if next_pos < token_count
			Token next_token = tokens at next_pos
			(kind) in next_token
			if kind is "EQUALS"
				is_binding = true
			if kind is "KW_AS"
				is_binding = true

		if is_binding
			# a fresh value now occupies this name — it's no longer moved,
			# and any partial-move field tracking from a PRIOR value that
			# happened to share this name (e.g. a macro like gen_expr_r
			# inlined twice in the same block, each declaring its own fresh
			# `ge_r`) no longer applies either — the old "name.field" keys
			# belonged to a different instance.
			string name = cur_val
			string field_prefix = s_join([name, "."])
			rust
				moved_vars.retain(|x| x != &name);
				moved_fields.retain(|x| !x.starts_with(&field_prefix));
		else
			bool skip_read = in_struct_body
			if in_enum_body
				skip_read = true
			bool next_is_rparen = false
			if next_pos < token_count
				Token next_token2 = tokens at next_pos
				(kind) in next_token2
				if kind is "IDENT"
					skip_read = true
				if kind is "LPAREN"
					skip_read = true
				if kind is "KW_IN"
					skip_read = true
				if kind is "RPAREN"
					next_is_rparen = true
			if pos > 0
				int prev_pos = locate_prev_token(pos)
				Token prev_token = tokens at prev_pos
				(kind) in prev_token
				if kind is "KW_MOVE"
					skip_read = true
				# for move (item in {collection}) — collection here was just
				# marked moved by the KW_FOR handler above, in this very same
				# pass; without this, this identical token gets re-visited
				# as a plain read and flags itself as already-moved.
				if kind is "KW_IN"
					if next_is_rparen
						skip_read = true
				if kind is "KW_STRUCT"
					skip_read = true
				if kind is "KW_ENUM"
					skip_read = true
				if kind is "KW_SHAPE"
					skip_read = true
				if kind is "KW_TYPE"
					skip_read = true
				if kind is "KW_FN"
					skip_read = true
				if kind is "KW_MACRO"
					skip_read = true
				if kind is "KW_MACRO_RUN"
					skip_read = true
				if kind is "KW_UNSAFE_MACRO_RUN"
					skip_read = true
				if kind is "KW_UNSAFE_MACRO"
					skip_read = true
				if kind is "KW_OF"
					skip_read = true
				if kind is "KW_TO"
					skip_read = true
				if kind is "KW_RAW"
					skip_read = true

			# Inside an unclosed paren group that's either preceded by KW_MOVE
			# ('move (f1, f2)' construction or 'move (f1, f2) in source') or whose
			# closing paren is followed by KW_IN ('(f1, f2) in source', with or
			# without 'move') is always a destructure/construction TARGET LIST, never
			# a read: construction fields are what check_use_after_move_var_move.deor
			# just marked moved in this same pass (a few tokens back, at the KW_MOVE
			# position), which would otherwise make this very read-check flag them as
			# already-moved before the statement even finishes; a plain destructure's
			# names are fresh bindings, even when they happen to shadow an
			# already-moved name from earlier in the same scope (e.g. re-destructuring
			# 'label' back out of a struct that was just built by moving a variable
			# also named 'label' into it) — a function call's argument parens are the
			# only other paren shape an IDENT sits directly inside of, and those match
			# neither condition (preceded by the callee name, not KW_MOVE; followed by
			# whatever comes after the call, essentially never KW_IN).
			bool in_destructure_target = false
			bool dt_followed_by_in = false
			int dt_scan_pos = pos - 1
			int dt_scan_depth = 0
			bool dt_found_enclosing = false
			int dt_lparen_pos = 0
			for if dt_scan_pos >= 0
				Token dt_scan_token = tokens at dt_scan_pos
				(kind) in dt_scan_token
				if kind is "NEWLINE"
					break
				if kind is "RPAREN"
					dt_scan_depth = dt_scan_depth + 1
				else if kind is "LPAREN"
					if dt_scan_depth is 0
						dt_found_enclosing = true
						dt_lparen_pos = dt_scan_pos
						break
					else
						dt_scan_depth = dt_scan_depth - 1
				dt_scan_pos = dt_scan_pos - 1
			if dt_found_enclosing
				bool dt_preceded_by_move = false
				if dt_lparen_pos > 0
					int dt_before_lparen = dt_lparen_pos - 1
					Token dt_before_lparen_token = tokens at dt_before_lparen
					(kind) in dt_before_lparen_token
					if kind is "KW_MOVE"
						dt_preceded_by_move = true
				int dt_rparen_pos = find_matching_rparen(tokens, dt_lparen_pos)
				int dt_after_rparen = dt_rparen_pos + 1
				if dt_after_rparen < token_count
					Token dt_after_rparen_token = tokens at dt_after_rparen
					(kind) in dt_after_rparen_token
					if kind is "KW_IN"
						dt_followed_by_in = true
				if dt_preceded_by_move or dt_followed_by_in
					in_destructure_target = true
			if in_destructure_target
				if dt_followed_by_in
					# A binding TARGET receiving a freshly extracted value (both plain
					# '(f1, f2) in source' and 'move (f1, f2) in source' land here) — same
					# clearing as the is_binding branch above, since a fresh value now
					# occupies this name even if it happens to shadow an already-moved
					# variable declared earlier under the same name.
					string dt_name = cur_val
					string dt_field_prefix = s_join([dt_name, "."])
					rust
						moved_vars.retain(|x| x != &dt_name);
						moved_fields.retain(|x| !x.starts_with(&dt_field_prefix));
				skip_read = true

			if not skip_read
				bool was_moved = list_has(moved_vars, cur_val)
				if was_moved
					bool is_copy = list_has(copy_var_names, cur_val)
					if not is_copy
						errors at end = val_err(tok, lbl_var, rule_use_after_move)
