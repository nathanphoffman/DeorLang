
# Partial-move destructuring (`move (f1, f2) in source`), tracked at the
# field level via moved_fields ("source.field" keys) — separate from the
# whole-variable move_if_stack machinery in check_use_after_move_chain.
# Same-block only: moved_fields clears at every block boundary rather than
# being flow-sensitive across if/else-if/else, so this half does not yet
# flag the whole struct being used by value after a partial move, only a
# repeat destructure of a field that's already gone. Part of
# check_use_after_move — see that macro's header for the full picture.
# Reads: cur_kind, pos, tokens, token_count, moved_fields, lbl_var,
#   rule_double_move, rule_use_after_move.
# Writes: moved_fields, errors.
macro check_use_after_move_field
	# ex: move {(}f1, f2) in source — kw_pos+1 grabs the opening paren
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	# ex: {(}f1, f2) in source — kw_pos-1 grabs the token right before KW_IN
	fn int locate_prev_token(int kw_pos)
		return kw_pos - 1

	# ex: {(}f1, f2) in source — kw_pos-2 starts the backward scan for the
	# matching '(' when walking back from KW_IN to collect the field list
	fn int locate_backscan_start(int kw_pos)
		return kw_pos - 2

	# moved_fields resets at every block boundary — see the macro header for
	# why this half isn't flow-sensitive like moved_vars.
	if cur_kind is "INDENT"
		rust
			moved_fields.clear();
	if cur_kind is "DEDENT"
		rust
			moved_fields.clear();
	if cur_kind is "KW_ELSE"
		rust
			moved_fields.clear();

	# move (f1, f2) in source — the mark side. Collect the field names, then
	# the source identifier, and mark each field as moved on that source.
	# Does not touch moved_vars: `source` itself is not fully consumed, only
	# the named fields are, so a later `(other_field) in source` for an
	# untouched field must stay legal.
	if cur_kind is "KW_MOVE"
		int move_next_pos = locate_next_token(pos)
		if move_next_pos < token_count
			Token move_next_token = tokens at move_next_pos
			(kind) in move_next_token
			if kind is "LPAREN"
				strList move_fields = empty
				int scan_pos = locate_next_token(move_next_pos)
				bool scanning = true
				for if scanning
					if scan_pos < token_count
						Token scan_token = tokens at scan_pos
						(kind, value) in scan_token
						if kind is "IDENT"
							move_fields at end = value
						if kind is "RPAREN"
							scanning = false
						scan_pos = scan_pos + 1
					else
						scanning = false
				# scan_pos now sits just past the RPAREN — ex: move (f1, f2) {in} source
				if scan_pos < token_count
					Token in_token = tokens at scan_pos
					(kind) in in_token
					if kind is "KW_IN"
						int source_pos = scan_pos + 1
						if source_pos < token_count
							Token source_token = tokens at source_pos
							(kind, value) in source_token
							if kind is "IDENT"
								string source_name = value
								(line, file) in source_token
								string line_str = n_to_str(line)
								int field_index = 0
								int field_count = len(move_fields)
								for if field_index < field_count
									string field_name = move_fields at field_index
									string field_key = s_join([source_name, ".", field_name])
									bool already_moved = list_has(moved_fields, field_key)
									if already_moved
										strList msg_parts = ["[validation] ", file, " line ", line_str, ": ", lbl_var, " '", field_key, "' - ", rule_double_move]
										errors at end = s_join(msg_parts)
									else
										moved_fields at end = field_key
									field_index = field_index + 1

	# (f1, f2) in source / move (f1, f2) in source — the read side. Only
	# bagged destructures reach here: the token right before KW_IN must be
	# RPAREN, which a bare `for item in collection` header never has (see
	# docs/loops.md — no parens on the plain form), so this can't misfire on
	# a for-loop header. Walk back to the matching '(' to collect the field
	# list, then check each field against moved_fields. Skipped entirely when
	# this destructure is itself the `move (...) in source` above that just
	# marked the fields — that's the transition to moved, not a use of it.
	if cur_kind is "KW_IN"
		if pos > 0
			int prev_pos = locate_prev_token(pos)
			Token prev_token = tokens at prev_pos
			(kind) in prev_token
			if kind is "RPAREN"
				int next_pos = locate_next_token(pos)
				if next_pos < token_count
					Token next_token = tokens at next_pos
					(kind, value) in next_token
					if kind is "IDENT"
						int after_pos = locate_next_token(next_pos)
						bool is_bare = true
						if after_pos < token_count
							Token after_token = tokens at after_pos
							(kind) in after_token
							if kind is "LPAREN"
								is_bare = false
						if is_bare
							string source_name = value
							strList fields = empty
							int backscan_pos = locate_backscan_start(pos)
							int paren_depth = 0
							for if backscan_pos >= 0
								Token backscan_token = tokens at backscan_pos
								(kind, value) in backscan_token
								if kind is "RPAREN"
									paren_depth = paren_depth + 1
								else if kind is "LPAREN"
									if paren_depth is 0
										break
									paren_depth = paren_depth - 1
								else if kind is "IDENT"
									if paren_depth is 0
										fields at end = value
								backscan_pos = backscan_pos - 1

							bool is_move_stmt = false
							if backscan_pos > 0
								int before_lparen_pos = backscan_pos - 1
								Token before_lparen_token = tokens at before_lparen_pos
								(kind) in before_lparen_token
								if kind is "KW_MOVE"
									is_move_stmt = true

							if not is_move_stmt
								int field_index = 0
								int field_count = len(fields)
								for if field_index < field_count
									string field_name = fields at field_index
									string field_key = s_join([source_name, ".", field_name])
									bool was_moved = list_has(moved_fields, field_key)
									if was_moved
										(line, file) in next_token
										string line_str = n_to_str(line)
										strList msg_parts = ["[validation] ", file, " line ", line_str, ": ", lbl_var, " '", field_key, "' - ", rule_use_after_move]
										errors at end = s_join(msg_parts)
									field_index = field_index + 1
