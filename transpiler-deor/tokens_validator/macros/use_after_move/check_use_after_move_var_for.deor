
# Whole-variable move tracking, `for move (item in collection)` case: the
# collection is fully consumed once the loop is entered, so a bare read of
# it later is flagged the same as any other moved variable. Part of
# check_use_after_move_var — see that macro's header for the full picture
# of whole-variable move tracking, and check_use_after_move's header for how
# this fits into the larger use-after-move check.
# Reads: cur_kind, pos, tokens, token_count, moved_vars, lbl_var,
#   rule_use_after_move.
# Writes: moved_vars, errors.
macro check_use_after_move_var_for
	# ex: for {move} (item in collection) — kw_pos+1 grabs the token after 'for'
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	# for move (item in collection) — collection is fully consumed once the
	# loop is entered.
	if cur_kind is "KW_FOR"
		int move_pos = locate_next_token(pos)
		if move_pos < token_count
			Token move_token = tokens at move_pos
			(kind) in move_token
			if kind is "KW_MOVE"
				# ex: for move ({item} in collection) — move_pos+2 grabs the loop var
				int var_pos = move_pos + 2
				# ex: for move (item {in} collection) — var_pos+1 grabs 'in'
				int in_pos = locate_next_token(var_pos)
				# ex: for move (item in {collection}) — in_pos+1 grabs the collection name
				int collection_pos = locate_next_token(in_pos)
				if collection_pos < token_count
					Token collection_token = tokens at collection_pos
					(kind, value) in collection_token
					if kind is "IDENT"
						int after_collection = locate_next_token(collection_pos)
						bool collection_is_bare = true
						if after_collection < token_count
							Token after_token = tokens at after_collection
							(kind) in after_token
							if kind is "LPAREN"
								collection_is_bare = false
						if collection_is_bare
							bool already_moved = list_has(moved_vars, value)
							if already_moved
								errors at end = val_err(collection_token, lbl_var, rule_use_after_move)
							else
								moved_vars at end = value
