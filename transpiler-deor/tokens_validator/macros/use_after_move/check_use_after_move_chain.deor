
# Flow-sensitive tracking of whole-variable moves across an if/else-if/else
# chain, via a stack of UamFrame snapshots (one per open chain, keyed by
# block_depth). Branches are mutually exclusive, so a move inside one arm
# must not poison a sibling arm — each arm has to start from the same
# pre-chain snapshot. But a move IS carried forward past the whole chain if
# any reachable arm made it, because rustc can't know at that point which
# arm actually ran — the same rule rustc itself applies. Part of
# check_use_after_move — see that macro's header for the full picture,
# including the separate (non-flow-sensitive) partial-field-move tracking.
# Reads: cur_kind, pos, tokens, token_count, block_depth, move_if_stack, moved_vars.
# Writes: move_if_stack, moved_vars.
macro check_use_after_move_chain
	# ex: {else} if cond — kw_pos-1 checks the token before for an else-if
	fn int locate_prev_token(int kw_pos)
		return kw_pos - 1

	# ex: DEDENT{next} — kw_pos+1 grabs the token right after a DEDENT
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	# KW_IF opens a new chain frame — unless this IF is the "if" half of an
	# "else if", which belongs to the chain already on the stack (else and if
	# are two flat tokens on the same line, not a nested if inside an else
	# block — see docs/conditionals.md).
	if cur_kind is "KW_IF"
		bool is_elseif = false
		if pos > 0
			int prev_pos = locate_prev_token(pos)
			Token prev_token = tokens at prev_pos
			(kind) in prev_token
			if kind is "KW_ELSE"
				is_elseif = true
		if not is_elseif
			int chain_depth = block_depth
			strList pre_vars = moved_vars
			strList acc_vars = moved_vars
			UamFrame new_frame = (chain_depth, pre_vars, acc_vars)
			move_if_stack at end = new_frame

	# KW_ELSE — the arm that just closed (its DEDENT ran immediately before
	# this token) is folded into the chain's accumulator — unless that arm's
	# last statement is KW_RETURN/KW_BREAK/KW_CONTINUE, in which case it never
	# falls through to code after the chain at all, so its moves must not be
	# treated as reachable there (the extremely common "if kind is X: return
	# ..." dispatch idiom throughout this codebase relies on this). Either
	# way, moved_vars is restored to the pre-chain snapshot so the next arm
	# starts from the same base as every other arm, not from what the
	# previous arm moved.
	if cur_kind is "KW_ELSE"
		int stack_len = len(move_if_stack)
		if stack_len > 0
			int top_idx = stack_len - 1
			UamFrame top_frame = move_if_stack at top_idx
			(chain_depth, pre_vars, acc_vars) in top_frame
			if chain_depth is block_depth
				bool arm_is_terminal = false
				int line_scan = locate_prev_token(pos)
				for if line_scan >= 0
					Token line_scan_token = tokens at line_scan
					(kind) in line_scan_token
					if kind is "NEWLINE"
						line_scan = line_scan - 1
					else
						break
				int line_end = line_scan
				for if line_scan >= 0
					Token line_scan_token2 = tokens at line_scan
					(kind) in line_scan_token2
					if kind is "NEWLINE"
						break
					if kind is "INDENT"
						break
					if kind is "DEDENT"
						break
					line_scan = line_scan - 1
				int line_start = line_scan + 1
				if line_start <= line_end
					Token line_first_token = tokens at line_start
					(kind) in line_first_token
					if kind is "KW_RETURN"
						arm_is_terminal = true
					if kind is "KW_BREAK"
						arm_is_terminal = true
					if kind is "KW_CONTINUE"
						arm_is_terminal = true
				if not arm_is_terminal
					int move_index = 0
					int move_count = len(moved_vars)
					for if move_index < move_count
						string moved_name = moved_vars at move_index
						bool already_acc = list_has(acc_vars, moved_name)
						if not already_acc
							acc_vars at end = moved_name
						move_index = move_index + 1
				move_if_stack remove at top_idx
				UamFrame updated_frame = (chain_depth, pre_vars, acc_vars)
				move_if_stack at end = updated_frame
				moved_vars = pre_vars

	# DEDENT — only acts when it closes the last arm of a tracked chain (the
	# next token isn't KW_ELSE, so no more arms follow). Folds this final arm
	# into the accumulator (unless it's terminal — same reasoning as the
	# KW_ELSE case above) and that union becomes moved_vars going forward.
	# Every other DEDENT (closing a for/fn body, or a chain arm followed by
	# another else) is a no-op — nothing is cleared, so a move followed by a
	# read in later straight-line code is still caught.
	if cur_kind is "DEDENT"
		int stack_len = len(move_if_stack)
		if stack_len > 0
			int top_idx = stack_len - 1
			UamFrame top_frame = move_if_stack at top_idx
			(chain_depth, acc_vars) in top_frame
			if chain_depth is block_depth
				bool next_is_else = false
				int after_dedent = locate_next_token(pos)
				if after_dedent < token_count
					Token after_dedent_token = tokens at after_dedent
					(kind) in after_dedent_token
					if kind is "KW_ELSE"
						next_is_else = true
				if not next_is_else
					bool arm_is_terminal = false
					int line_scan = locate_prev_token(pos)
					for if line_scan >= 0
						Token line_scan_token = tokens at line_scan
						(kind) in line_scan_token
						if kind is "NEWLINE"
							line_scan = line_scan - 1
						else
							break
					int line_end = line_scan
					for if line_scan >= 0
						Token line_scan_token2 = tokens at line_scan
						(kind) in line_scan_token2
						if kind is "NEWLINE"
							break
						if kind is "INDENT"
							break
						if kind is "DEDENT"
							break
						line_scan = line_scan - 1
					int line_start = line_scan + 1
					if line_start <= line_end
						Token line_first_token = tokens at line_start
						(kind) in line_first_token
						if kind is "KW_RETURN"
							arm_is_terminal = true
						if kind is "KW_BREAK"
							arm_is_terminal = true
						if kind is "KW_CONTINUE"
							arm_is_terminal = true
					if not arm_is_terminal
						int move_index = 0
						int move_count = len(moved_vars)
						for if move_index < move_count
							string moved_name = moved_vars at move_index
							bool already_acc = list_has(acc_vars, moved_name)
							if not already_acc
								acc_vars at end = moved_name
							move_index = move_index + 1
					move_if_stack remove at top_idx
					moved_vars = acc_vars
