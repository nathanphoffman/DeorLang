
# Tracks declared variable names whose type is one of Deor's Copy primitives
# (int, float, bool) into copy_var_names — backing registry for
# check_use_after_move, which must not flag a re-read of a `move`d primitive:
# per docs/move.md, `move` on a Copy type is an inert no-op (Rust copies
# instead of consuming), so the original stays valid and usable afterward.
# Two sources: typed declarations ('Type name = expr') and function
# parameters ('fn Ret name(Type1 p1, Type2 p2, ...)') — same shape
# track_non_bool_vars already scans, mirrored here for the positive
# int/float/bool set instead of the "everything but bool" set.
macro track_copy_vars
	# ex: Type {name} = expr — kw_pos+1 grabs the variable name
	fn int locate_var_name(int kw_pos)
		return kw_pos + 1

	# ex: Type name {=} expr — kw_pos+2 grabs the equals sign
	fn int locate_equals(int kw_pos)
		return kw_pos + 2

	# ex: fn int add{(}left, right) — kw_pos+3 grabs the opening paren
	fn int locate_left_paren(int kw_pos)
		return kw_pos + 3

	if cur_kind is "IDENT"
		bool is_copy_kw = cur_val is "int"
		if not is_copy_kw
			is_copy_kw = cur_val is "float"
		if not is_copy_kw
			is_copy_kw = cur_val is "bool"
		if is_copy_kw
			int name_pos = locate_var_name(pos)
			int equals_pos = locate_equals(pos)
			if equals_pos < token_count
				Token name_token = tokens at name_pos
				Token equals_token = tokens at equals_pos
				(kind) in name_token
				string name_kind = kind
				(kind) in equals_token
				if name_kind is "IDENT" and kind is "EQUALS"
					(value) in name_token
					copy_var_names at end = value

	if cur_kind is "KW_FN"
		int left_paren_pos = locate_left_paren(pos)
		if left_paren_pos < token_count
			Token left_paren_token = tokens at left_paren_pos
			(kind) in left_paren_token
			if kind is "LPAREN"
				int param_scan_pos = left_paren_pos + 1
				for if param_scan_pos < token_count
					Token param_scan_token = tokens at param_scan_pos
					(kind, value) in param_scan_token
					if kind is "RPAREN"
						break
					if kind is "COMMA"
						param_scan_pos = param_scan_pos + 1
						continue
					if kind is "IDENT"
						string param_type = value
						bool param_is_copy = param_type is "int"
						if not param_is_copy
							param_is_copy = param_type is "float"
						if not param_is_copy
							param_is_copy = param_type is "bool"
						int param_name_pos = param_scan_pos + 1
						if param_name_pos < token_count
							Token param_name_token = tokens at param_name_pos
							(kind, value) in param_name_token
							if kind is "IDENT"
								if param_is_copy
									copy_var_names at end = value
								param_scan_pos = param_name_pos
					param_scan_pos = param_scan_pos + 1
