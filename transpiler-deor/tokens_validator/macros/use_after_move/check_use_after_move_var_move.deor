
# Whole-variable move tracking, `move name` case (the single-target form):
# marks the named variable moved unless it's Copy, used inertly inside a
# s_join([...]) bracket-literal, or immediately self-reassigned
# (`name = f(move name)`), and flags a double-move if it's already moved.
# Part of check_use_after_move_var — see that macro's header for the full
# picture of whole-variable move tracking, and check_use_after_move's header
# for how this fits into the larger use-after-move check.
# Reads: cur_kind, pos, tokens, token_count, moved_vars, copy_var_names,
#   lbl_var, rule_double_move.
# Writes: moved_vars, errors.
macro check_use_after_move_var_move
	# ex: {move} name — kw_pos+1 grabs the move target
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	# ex: {move} name — kw_pos-1 grabs the token before this KW_MOVE
	fn int locate_prev_token(int kw_pos)
		return kw_pos - 1

	# move name — single-target form.
	if cur_kind is "KW_MOVE"
		int next_pos = locate_next_token(pos)
		if next_pos < token_count
			Token next_token = tokens at next_pos
			(kind, value) in next_token
			if kind is "IDENT"
				# move is inert inside s_join([...])'s bracket-literal item list —
				# it compiles to [...].concat(), which only ever borrows its
				# operands, so there's nothing for move to consume here (see
				# docs/move.md#move-in-string-concatenation). Find the nearest
				# enclosing '[' by bracket depth and check it opens 's_join('.
				bool in_sjoin = false
				int scan_pos = locate_prev_token(pos)
				int bracket_depth = 0
				for if scan_pos >= 0
					Token scan_token = tokens at scan_pos
					(kind) in scan_token
					if kind is "RBRACKET"
						bracket_depth = bracket_depth + 1
					else if kind is "LBRACKET"
						if bracket_depth is 0
							if scan_pos >= 2
								int lparen_pos = scan_pos - 1
								int func_pos = scan_pos - 2
								Token lparen_token = tokens at lparen_pos
								Token func_token = tokens at func_pos
								(kind) in lparen_token
								bool lparen_ok = kind is "LPAREN"
								(kind, value) in func_token
								if lparen_ok
									if kind is "IDENT"
										if value is "s_join"
											in_sjoin = true
							break
						else
							bracket_depth = bracket_depth - 1
					scan_pos = scan_pos - 1

				(value) in next_token
				string move_name = value

				# name = f(move name) — a very common idiom in this codebase
				# (`result_code = s_cat(move result_code, ...)`): the old value
				# is consumed to build the new one, and a completely fresh value
				# occupies `name` once the statement finishes, so marking it
				# moved here would be wrong — it's usable again immediately
				# after. Detect by walking back to this line's first token and
				# checking for '<same name> ='.
				bool self_reassign = false
				int line_scan_pos = locate_prev_token(pos)
				for if line_scan_pos >= 0
					Token line_scan_token = tokens at line_scan_pos
					(kind) in line_scan_token
					if kind is "NEWLINE"
						break
					if kind is "INDENT"
						break
					if kind is "DEDENT"
						break
					line_scan_pos = line_scan_pos - 1
				int line_first_pos = line_scan_pos + 1
				if line_first_pos < pos
					Token line_first_token = tokens at line_first_pos
					(kind, value) in line_first_token
					if kind is "IDENT"
						string line_first_name = value
						int line_first_next = line_first_pos + 1
						if line_first_next < token_count
							Token line_first_next_token = tokens at line_first_next
							(kind) in line_first_next_token
							if kind is "EQUALS"
								if line_first_name is move_name
									self_reassign = true

				(value) in next_token
				bool is_copy = list_has(copy_var_names, value)
				if in_sjoin
					is_copy = true
				if self_reassign
					is_copy = true
				if not is_copy
					bool already_moved = list_has(moved_vars, value)
					if already_moved
						errors at end = val_err(next_token, lbl_var, rule_double_move)
					else
						moved_vars at end = value
			else if kind is "LPAREN"
				# Type name = move (f1, f2, ...) — struct construction via move (see
				# docs/move.md#struct-construction): each named field is moved INTO the
				# new struct. 'move (' also introduces two other, unrelated shapes that
				# must NOT be treated as construction: 'move (f1, f2) in source' (partial
				# destructure FROM an existing struct, tracked separately by
				# check_use_after_move_field.deor's field-level moved_fields) and
				# 'for move (item in collection)' (loop consumption, handled by
				# check_use_after_move_var_for.deor — 'in' sits INSIDE these parens, not
				# after them, so it can't be told apart from construction by peeking past
				# the closing paren the way the destructure form can). The one token that
				# reliably marks construction specifically is what precedes this KW_MOVE:
				# only the '= move (...)' RHS position has EQUALS there — a destructure
				# statement starts its own line (NEWLINE/INDENT before it), and a for-loop
				# has KW_FOR before it.
				bool is_construct_position = false
				if pos > 0
					int before_move_pos = locate_prev_token(pos)
					Token before_move_token = tokens at before_move_pos
					(kind) in before_move_token
					if kind is "EQUALS"
						is_construct_position = true
				if is_construct_position
					int construct_rparen_pos = find_matching_rparen(tokens, next_pos)
					int construct_scan_pos = next_pos + 1
					for if construct_scan_pos < construct_rparen_pos
						Token construct_scan_token = tokens at construct_scan_pos
						(kind, value) in construct_scan_token
						if kind is "IDENT"
							bool field_is_copy = list_has(copy_var_names, value)
							if not field_is_copy
								bool field_already_moved = list_has(moved_vars, value)
								if field_already_moved
									errors at end = val_err(construct_scan_token, lbl_var, rule_double_move)
								else
									moved_vars at end = value
						construct_scan_pos = construct_scan_pos + 1
