# Declares the membership tables checked throughout the token validator —
# separate from define_errors' message-vocabulary strings, these are lists
# tested with list_has(...) rather than read directly into an error message.
unsafe_macro define_lookup_tables

	strList forbidden_in_parens = ["KW_LIST", "KW_STRUCT", "KW_SHAPE", "KW_ENUM", "KW_TYPE", "KW_FN", "KW_OF", "KW_FOR", "KW_IF", "KW_ELSE", "KW_RETURN", "KW_BREAK", "KW_CONTINUE", "KW_REMOVE", "KW_RUST", "KW_IMPORT", "KW_MACRO", "KW_UNSAFE_MACRO", "KW_VOID", "KW_RAW"]

	# Every reserved keyword kind except KW_END — used by check_kw_as_name to flag
	# any of them appearing in a declaration/binding name slot (`Type keyword =
	# expr` or `keyword as expr`). Keywords silently corrupt codegen when they end
	# up in a name position instead of erroring, so this is checked universally
	# rather than one keyword at a time. KW_END is excluded: `list at end = val`
	# is legitimate (end immediately followed by EQUALS), and check_end_placement
	# already handles that keyword's one legitimate position precisely.
	strList reserved_keywords = ["KW_AND", "KW_AS", "KW_AT", "KW_AVOW", "KW_BLOCK", "KW_BREAK", "KW_CONST", "KW_CONTINUE", "KW_ELSE", "KW_EMPTY", "KW_ENUM", "KW_FALSE", "KW_FN", "KW_FOR", "KW_FUNC", "KW_IF", "KW_IMPORT", "KW_IN", "KW_IS", "KW_LIST", "KW_MACRO", "KW_MACRO_RUN", "KW_UNSAFE_MACRO", "KW_UNSAFE_MACRO_RUN", "KW_MOVE", "KW_NONE", "KW_NOT", "KW_OF", "KW_OR", "KW_RAW", "KW_REMOVE", "KW_RETURN", "KW_RUST", "KW_SHAPE", "KW_STRUCT", "KW_TO", "KW_TRUE", "KW_TYPE", "KW_VALID", "KW_VOID", "KW_WITH"]

	# built-in function names — not lexer keywords, just plain IDENTs with special
	# codegen meaning, but they must never be shadowed (see docs/syntax.md#built-in-function-names)
	strList builtin_names = ["print", "crash", "len", "range", "args", "input"]

	# primitive type keywords — these are plain IDENTs (not lexer keywords), checked
	# by value wherever a typed enum / validator base type / shape needs to tell a
	# primitive apart from a user-defined type name
	strList primitive_type_names = ["string", "int", "float", "bool"]
