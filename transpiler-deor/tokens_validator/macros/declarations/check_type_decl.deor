# type name: PascalCase, min 3, plus validator-declaration-specific rules.
# check_type_base_primitive / check_validator_declaration must run BEFORE
# validate_ident below — validate_ident does an unconditional `pos = pos + 1;
# continue` on a keyword match, which would otherwise skip both checks every
# time (as it did, silently, until this fix).
macro check_type_decl
	macro_run check_type_base_primitive
	macro_run check_validator_declaration

	string keyword = "KW_TYPE"
	string lbl = lbl_type
	string rule = rule_pascal
	fnTestRule test_rule = is_pascal
	int validate_indent_offset = 1
	macro_run validate_ident
