
# Flags a bare expression statement (e.g. 'left + right', a lone 'val', a lone '42')
# sitting inside a function body that has MORE than one statement. A single-statement
# body that's just an expression is the documented implicit-return shape (see
# docs/functions.md "Return Rules") and fn_build_body_ctx.deor already generates a
# real 'return' for it — this check exists for every OTHER case, which used to fall
# through gen_stmt's dispatcher (no case matches a bare expression) into a silent
# '/* unhandled */' codegen fallback instead of a clear diagnostic. Scans every
# nesting depth inside the body (not just its top level), since a bare expression
# left inside an if/for branch is exactly as broken as one at the body's own end.
macro check_missing_return_expr
	# Token offsets for a `fn RetType name(params)` header, counted from KW_FN.
	fn int locate_fn_return_type(int kw_pos)
		return kw_pos + 1

	fn int locate_fn_name(int kw_pos)
		return kw_pos + 2

	fn int locate_fn_left_paren(int kw_pos)
		return kw_pos + 3

	if cur_kind is "KW_FN"
		int return_type_pos = locate_fn_return_type(pos)
		int name_pos = locate_fn_name(pos)
		int left_paren_pos = locate_fn_left_paren(pos)
		if left_paren_pos < token_count
			Token return_type_token = tokens at return_type_pos
			(kind, value) in return_type_token
			bool has_ret_type = kind is "IDENT"
			bool is_void = value is "void"
			Token left_paren_token = tokens at left_paren_pos
			(kind) in left_paren_token
			bool is_call_shape = kind is "LPAREN"
			if has_ret_type and not is_void and is_call_shape
				int right_paren_pos = find_matching_rparen(tokens, left_paren_pos)
				int newline_pos = right_paren_pos + 1
				if newline_pos < token_count
					Token newline_token = tokens at newline_pos
					(kind) in newline_token
					if kind is "NEWLINE"
						int indent_pos = newline_pos + 1
						if indent_pos < token_count
							Token indent_token = tokens at indent_pos
							(kind) in indent_token
							if kind is "INDENT"
								int body_first_pos = indent_pos + 1
								int body_end_pos = find_block_end_ref(tokens, indent_pos)
								if body_first_pos < body_end_pos
									int first_nl_pos = first_depth0_newline(tokens, body_first_pos, body_end_pos)
									bool is_single_stmt = false
									bool found_nl = first_nl_pos < body_end_pos
									if found_nl
										int after_first_nl = first_nl_pos + 1
										is_single_stmt = after_first_nl is body_end_pos
									if not is_single_stmt
										# Walk every statement start in the body, at any nesting depth: the
										# token right after body_first_pos, or right after any NEWLINE/
										# INDENT/DEDENT (block open, block close, or plain line end).
										int scan_pos = body_first_pos
										for if scan_pos < body_end_pos
											bool at_boundary = scan_pos is body_first_pos
											if not at_boundary
												int prev_pos = scan_pos - 1
												Token prev_token = tokens at prev_pos
												(kind) in prev_token
												string prev_kind = kind
												bool prev_is_boundary = prev_kind is "NEWLINE"
												if not prev_is_boundary
													prev_is_boundary = prev_kind is "INDENT"
												if not prev_is_boundary
													prev_is_boundary = prev_kind is "DEDENT"
												at_boundary = prev_is_boundary
											if at_boundary
												Token stmt_token = tokens at scan_pos
												(kind) in stmt_token
												string stmt_kind = kind
												bool is_candidate = stmt_kind is "IDENT"
												if not is_candidate
													is_candidate = stmt_kind is "INT"
												if not is_candidate
													is_candidate = stmt_kind is "FLOAT"
												if not is_candidate
													is_candidate = stmt_kind is "STRING"
												if not is_candidate
													is_candidate = stmt_kind is "KW_TRUE"
												if not is_candidate
													is_candidate = stmt_kind is "KW_FALSE"
												if is_candidate
													int next_pos = scan_pos + 1
													if next_pos < body_end_pos
														Token next_token = tokens at next_pos
														(kind) in next_token
														bool is_bare_expr = starts_binary_op(kind)
														if not is_bare_expr
															is_bare_expr = kind is "NEWLINE"
														if is_bare_expr
															errors at end = val_err(stmt_token, lbl_stmt, rule_missing_return_expr)
											scan_pos = scan_pos + 1

# True for a token kind that can follow a bare primary as a binary operator — a
# local copy of codegen's is_binary_op so this validator file (which runs before
# codegen even starts) doesn't reach into codegen internals for it.
fn bool starts_binary_op(string kind)
	if kind is "PLUS"
		return true
	if kind is "MINUS"
		return true
	if kind is "STAR"
		return true
	if kind is "SLASH"
		return true
	if kind is "PERCENT"
		return true
	if kind is "GT"
		return true
	if kind is "LT"
		return true
	if kind is "GTE"
		return true
	if kind is "LTE"
		return true
	if kind is "KW_IS"
		return true
	if kind is "KW_AND"
		return true
	if kind is "KW_OR"
		return true
	return false

# Position of the first depth-0 NEWLINE in [start, end_pos) — depth tracked relative
# to `start`, so a nested if/for block's own NEWLINEs don't count. Used only to tell
# whether the body is a single top-level statement (that NEWLINE immediately followed
# by end_pos itself) — the implicit-return exception this check must not fire on.
# Returns end_pos itself (never a valid depth-0 NEWLINE position) as the not-found
# sentinel — unary minus has no codegen in Deor yet, so plain -1 isn't usable here.
fn int first_depth0_newline(TokensRef tokens, int start, int end_pos)
	int depth = 0
	int scan_pos = start
	for if scan_pos < end_pos
		Token scan_token = tokens at scan_pos
		(kind) in scan_token
		if kind is "INDENT"
			depth = depth + 1
		else if kind is "DEDENT"
			depth = depth - 1
		else if kind is "NEWLINE"
			if depth is 0
				return scan_pos
		scan_pos = scan_pos + 1
	return end_pos
