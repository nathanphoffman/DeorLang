
# Validates type declarations: catches param name shadowing the type name (type Roll(int Roll))
# and param name shadowing its own base type (type Roll(int int)).
macro check_validator_declaration
	# Token offsets for a `type Name(baseType paramName)` declaration header,
	# counted from the position of the KW_TYPE token itself. Layout:
	#   +0 KW_TYPE  +1 name  +2 LPAREN  +3 base type  +4 param name  +5 RPAREN
	#   +6 NEWLINE  +7 INDENT (first token of the predicate body, if one exists)
	fn int locate_type_name(int kw_pos)
		return kw_pos + 1

	fn int locate_type_left_paren(int kw_pos)
		return kw_pos + 2

	fn int locate_type_param_type(int kw_pos)
		return kw_pos + 3

	fn int locate_type_param_name(int kw_pos)
		return kw_pos + 4

	fn int locate_type_newline(int kw_pos)
		return kw_pos + 6

	fn int locate_type_body(int kw_pos)
		return kw_pos + 7

	if cur_kind is "KW_TYPE"
		int type_name_pos = locate_type_name(pos)
		int left_paren_pos = locate_type_left_paren(pos)
		int param_type_pos = locate_type_param_type(pos)
		int param_name_pos = locate_type_param_name(pos)
		if param_name_pos < token_count
			Token type_name_token = tokens at type_name_pos
			Token left_paren_token = tokens at left_paren_pos
			Token param_type_token = tokens at param_type_pos
			Token param_name_token = tokens at param_name_pos
			(kind, value) in type_name_token
			string type_name = value
			(kind) in left_paren_token
			if kind is "LPAREN"
				(value) in param_type_token
				string param_type = value
				(kind, value) in param_name_token
				if kind is "IDENT"
					if value is type_name
						errors at end = val_err(param_name_token, lbl_type, rule_type_param_shadow)
					if value is param_type
						errors at end = val_err(param_name_token, lbl_type, rule_param_shadow)
					if list_has(builtin_names, value)
						errors at end = val_err(param_name_token, lbl_type, rule_builtin_shadow)

				# If the body is empty there's no INDENT after the header's NEWLINE
				# (codegen would otherwise read past the header into whatever token
				# happens to follow, or off the end of the token stream entirely).
				int newline_pos = locate_type_newline(pos)
				int body_pos = locate_type_body(pos)
				bool has_body = false
				if body_pos < token_count
					Token newline_token = tokens at newline_pos
					(kind) in newline_token
					if kind is "NEWLINE"
						Token body_token = tokens at body_pos
						(kind) in body_token
						if kind is "INDENT"
							has_body = true
				if not has_body
					errors at end = val_err(type_name_token, lbl_type, rule_validator_missing_body)
