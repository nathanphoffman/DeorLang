
# Validates type declarations: catches param name shadowing the type name (type Roll(int Roll))
# and param name shadowing its own base type (type Roll(int int)).
macro check_validator_declaration
	if cur_kind is "KW_TYPE"
		# ex: type {Roll}(int Roll) — pos+1 grabs the type name
		int vd_name_pos = pos + 1
		# ex: type Roll{(}int Roll) — pos+2 grabs the opening paren
		int vd_lp_pos = pos + 2
		# ex: type Roll({int} Roll) — pos+3 grabs the param's base type
		int vd_ptype_pos = pos + 3
		# ex: type Roll(int {Roll}) — pos+4 grabs the param name
		int vd_pname_pos = pos + 4
		if vd_pname_pos < token_count
			Token vd_name_tok = tokens at vd_name_pos
			Token vd_lp_tok = tokens at vd_lp_pos
			Token vd_ptype_tok = tokens at vd_ptype_pos
			Token vd_pname_tok = tokens at vd_pname_pos
			(kind, value) in vd_name_tok
			string vd_type_name = value
			(kind) in vd_lp_tok
			if kind is "LPAREN"
				(value) in vd_ptype_tok
				string vd_param_type = value
				(kind, value) in vd_pname_tok
				if kind is "IDENT"
					if value is vd_type_name
						errors at end = val_err(vd_pname_tok, lbl_type, rule_type_param_shadow)
					if value is vd_param_type
						errors at end = val_err(vd_pname_tok, lbl_type, rule_param_shadow)
					if list_has(builtin_names, value)
						errors at end = val_err(vd_pname_tok, lbl_type, rule_builtin_shadow)

				# ex: type Roll(int val){\n}{\t}return val > 0 — pos+6 is the header's
				# NEWLINE and pos+7 must be the INDENT opening the predicate body; if the
				# body is empty there's no INDENT here (codegen would otherwise read past
				# the header into whatever token happens to follow, or off the end of the
				# token stream entirely).
				int vd_nl_pos = pos + 6
				int vd_body_pos = pos + 7
				bool vd_has_body = false
				if vd_body_pos < token_count
					Token vd_nl_tok = tokens at vd_nl_pos
					(kind) in vd_nl_tok
					if kind is "NEWLINE"
						Token vd_body_tok = tokens at vd_body_pos
						(kind) in vd_body_tok
						if kind is "INDENT"
							vd_has_body = true
				if not vd_has_body
					errors at end = val_err(vd_name_tok, lbl_type, rule_validator_missing_body)
