
# Validates variable names in typed declarations (`Type name = ...`) and as-bindings: enforces min 3 chars,
# snake_case, and rejects a built-in function name (print, crash, len, range, args, input).
macro check_var_decl
	# ex: int {name} = 5 — kw_pos+1 grabs the variable name
	fn int locate_var_name(int kw_pos)
		return kw_pos + 1

	# ex: int name {=} 5 — kw_pos+2 grabs the equals sign
	fn int locate_var_equals(int kw_pos)
		return kw_pos + 2

	# ex: {const} int NAME = 5 — kw_pos-1 checks the token before the type for the const keyword
	fn int locate_const_check_pos(int kw_pos)
		return kw_pos - 1

	int name_pos = locate_var_name(pos)
	int equals_pos = locate_var_equals(pos)
	if equals_pos < token_count
		Token name_token = tokens at name_pos
		Token equals_token = tokens at equals_pos
		(kind) in name_token
		string name_kind = kind
		(kind) in equals_token
		string equals_kind = kind
		if name_kind is "IDENT" and equals_kind is "EQUALS"
			Token type_token = tokens at pos
			(value) in type_token
			string type_name = value
			bool is_known_type = list_has(primitive_type_names, type_name) or list_has(declared_type_names, type_name)
			if not is_known_type
				errors at end = val_err(type_token, lbl_var, rule_unknown_type)
			(value, line, file) in name_token
			string var_name = value
			int var_line = line
			string var_file = file
			if len(var_name) < 3
				errors at end = val_err(name_token, lbl_var, rule_min3)
			if list_has(builtin_names, var_name)
				errors at end = val_err(name_token, lbl_var, rule_builtin_shadow)
			bool is_const = false
			if pos > 0
				int const_check_pos = locate_const_check_pos(pos)
				Token const_check_token = tokens at const_check_pos
				(kind) in const_check_token
				is_const = kind is "KW_CONST"
			if is_const
				if not is_screaming_snake(var_name)
					errors at end = val_err(name_token, lbl_var, rule_screaming)
			if not is_const
				if not is_snake(var_name)
					errors at end = val_err(name_token, lbl_var, rule_snake)
		if name_kind is "KW_AS"
			if len(cur_val) < 3
				errors at end = val_err(tok, lbl_var, rule_min3)
			if not is_snake(cur_val)
				errors at end = val_err(tok, lbl_var, rule_snake)
			if list_has(builtin_names, cur_val)
				errors at end = val_err(tok, lbl_var, rule_builtin_shadow)
