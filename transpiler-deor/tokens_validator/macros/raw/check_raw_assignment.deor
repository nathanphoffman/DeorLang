
# Validates `raw name = expr` — the RHS must be a call to a function (Deor or
# rust-backed); that function's return value is what's actually opaque to Deor.
# A literal or an inline `rust` block is rejected: `rust` was never wired up as
# a value-producing expression in codegen, and a literal defeats the point of
# marking something raw in the first place. Tracks the variable name into
# raw_var_names for use by the other raw checks.
macro check_raw_assignment
	# ex: raw {name} = call() — kw_pos+1 grabs the binding name
	fn int locate_name(int kw_pos)
		return kw_pos + 1

	# ex: raw name {=} call() — kw_pos+2 grabs the equals sign
	fn int locate_equals(int kw_pos)
		return kw_pos + 2

	# ex: raw name = {call}() — kw_pos+3 grabs the call target right after '='
	fn int locate_call_target(int kw_pos)
		return kw_pos + 3

	# ex: raw name = call{(}) — kw_pos+4 confirms a '(' follows the call name
	fn int locate_call_lparen(int kw_pos)
		return kw_pos + 4

	if cur_kind is "KW_RAW"
		int equals_pos = locate_equals(pos)
		if equals_pos < token_count
			Token equals_token = tokens at equals_pos
			(kind) in equals_token
			if kind is "KW_AS"
				int as_name_pos = locate_name(pos)
				Token as_name_token = tokens at as_name_pos
				errors at end = val_err(as_name_token, lbl_var, rule_raw_as)
			else if kind is "EQUALS"
				int name_pos = locate_name(pos)
				Token name_token = tokens at name_pos
				(kind, value) in name_token
				if kind is "IDENT"
					raw_var_names at end = value
					int call_pos = locate_call_target(pos)
					bool is_call = false
					if call_pos < token_count
						Token call_token = tokens at call_pos
						(kind) in call_token
						if kind is "IDENT"
							int lparen_pos = locate_call_lparen(pos)
							if lparen_pos < token_count
								Token lparen_token = tokens at lparen_pos
								(kind) in lparen_token
								is_call = kind is "LPAREN"
					if not is_call
						errors at end = val_err(name_token, lbl_var, rule_raw_assignment)
