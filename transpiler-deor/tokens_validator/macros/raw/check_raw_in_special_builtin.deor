
# Flags a raw variable used inside the argument span of the builtins that get
# type-assuming codegen instead of a plain pass-through function call: len(...)
# (assumes a `.len()` method + numeric cast), crash(...) (assumes Display for
# panic!), and the bracket-literal form of s_join([...]) (assumes concatenation).
# Ordinary function calls (Deor or lib) aren't checked here — raw values are
# meant to pass through those untouched, with Rust's own compiler as the guard.
macro check_raw_in_special_builtin
	# ex: len{(}pool) — kw_pos+1 grabs the opening paren after the builtin name
	fn int locate_left_paren(int kw_pos)
		return kw_pos + 1

	if cur_kind is "IDENT"
		strList target_names = ["len", "crash", "s_join"]
		bool is_target = list_has(target_names, cur_val)
		if is_target
			int left_paren_pos = locate_left_paren(pos)
			if left_paren_pos < token_count
				Token left_paren_token = tokens at left_paren_pos
				(kind) in left_paren_token
				if kind is "LPAREN"
					int scan_pos = left_paren_pos + 1
					int depth = 0
					for if scan_pos < token_count
						Token scan_token = tokens at scan_pos
						(kind, value) in scan_token
						if kind is "RPAREN"
							bool at_root = depth is 0
							if at_root
								break
							depth = depth - 1
						else if kind is "LPAREN"
							depth = depth + 1
						else if kind is "LBRACKET"
							depth = depth + 1
						else if kind is "RBRACKET"
							depth = depth - 1
						else if kind is "IDENT"
							bool is_raw = list_has(raw_var_names, value)
							if is_raw
								errors at end = val_err(scan_token, lbl_var, rule_raw_in_expr)
						scan_pos = scan_pos + 1
