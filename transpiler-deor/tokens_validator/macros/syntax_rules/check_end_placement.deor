# Ensures `end` only appears directly after `at` (`list at end`, `list at end = val`)
# — it cannot be used as a variable/parameter name or as a plain expression value.
macro check_end_placement
	# ex: {at} end — kw_pos-1 grabs the token before 'end'
	fn int locate_prev_token(int kw_pos)
		return kw_pos - 1

	if cur_kind is "KW_END"
		bool is_valid = false
		if pos > 0
			int prev_pos = locate_prev_token(pos)
			Token prev_token = tokens at prev_pos
			(kind) in prev_token
			is_valid = kind is "KW_AT"
		if not is_valid
			errors at end = val_err(tok, lbl_var, rule_end)
