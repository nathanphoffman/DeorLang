
# Flags the bare-tuple range form `for [var] in (start, end)` / `for in (start,
# end)` — range iteration must go through `range(...)` now, so a paren
# directly in the iterator-expression slot of a for-header is always invalid.
# Does not apply to `for if ...` (while-loop form) or `for move (...)`
# (move-iteration form), which legitimately have other tokens there.
macro check_bare_tuple_range
	# ex: for {item} in ... — kw_pos+1 grabs the token after 'for' that decides the loop form
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if cur_kind is "KW_FOR"
		int next_pos = locate_next_token(pos)
		if next_pos < token_count
			Token next_token = tokens at next_pos
			(kind) in next_token
			bool applies = true
			if kind is "KW_IF"
				applies = false
			if kind is "KW_MOVE"
				applies = false
			if applies
				int iter_pos = 0
				if kind is "KW_IN"
					# ex: for in {(}low, high) — bare index-free range form
					iter_pos = locate_next_token(next_pos)
				else
					# ex: for var {in} expr — next token after the loop var should be 'in'
					int in_pos = locate_next_token(next_pos)
					# ex: for var in {expr} — in_pos+1 grabs the iteration expression
					iter_pos = locate_next_token(in_pos)
				if iter_pos < token_count
					Token iter_token = tokens at iter_pos
					(kind) in iter_token
					if kind is "LPAREN"
						errors at end = val_err(iter_token, lbl_call, rule_bare_tuple_range)
