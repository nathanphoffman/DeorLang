# Validates a bare struct tuple in return position: `return (a, b, c)`. Every item must be
# a single named variable, and the names must match some struct's fields exactly — the
# same rule as `Type var = (a, b, c)`. Without this check a literal, expression or
# misnamed variable slipped through and codegen wrote `/* unhandled(...) */` into the
# Rust, so the failure only surfaced as an opaque rustc error.
# A `(` with no top-level comma (`return (a + b)`, `return (avow x)`, `return (a)`) is a
# parenthesised expression, not a tuple, and is left alone.
macro check_return_tuple
	# ex: return {(}a, b) — kw_pos+1 grabs the opening paren
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if cur_kind is KW_RETURN
		int open_pos = locate_next_token(pos)

		if open_pos < token_count
			Token open_token = tokens at open_pos
			(kind) in open_token

			if kind is LPAREN
				strList item_names = empty
				bool all_named = true
				bool has_comma = false
				bool scanning = true
				int nest = 1
				int item_len = 0
				int item_start = open_pos + 1
				int scan_pos = open_pos + 1

				for if scanning
					if scan_pos >= token_count
						scanning = false
					else
						Token scan_token = tokens at scan_pos
						move (kind, value) in scan_token
						bool ends_item = false

						if kind is LPAREN
							nest = nest + 1
						else if kind is RPAREN
							nest = nest - 1

							if nest is 0
								ends_item = true
								scanning = false
						else if kind is COMMA
							if nest is 1
								ends_item = true
								has_comma = true

						if ends_item
							bool is_single_name = false

							if item_len is 1
								Token item_token = tokens at item_start
								move (kind, value) in item_token

								if kind is IDENT
									is_single_name = true
									item_names at end = value

							if not is_single_name
								all_named = false

								if has_comma
									Token bad_token = tokens at item_start
									errors at end = val_err(bad_token, lbl_fn, rule_return_tuple_item)

							item_len = 0
							item_start = scan_pos + 1
						else
							item_len = item_len + 1

						scan_pos = scan_pos + 1

				if has_comma and all_named
					strList owners = structs_with_exact_fields(struct_field_reg, item_names)
					int owner_count = len(owners)

					if owner_count is 0
						errors at end = val_err(open_token, lbl_fn, rule_return_tuple_fields)

					if owner_count > 1
						errors at end = val_err(open_token, lbl_fn, rule_struct_ambiguous)
