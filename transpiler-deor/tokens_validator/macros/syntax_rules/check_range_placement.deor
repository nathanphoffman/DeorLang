
# Flags `range(...)` used anywhere except directly as a for-loop's iterator
# expression. `range` has no real existence outside of for_iter_expr's special
# codegen — that macro only recognizes it while parsing a for-loop header, so
# anywhere else it's treated as a plain (undefined) function call and silently
# emits a `range(...)` call in the generated Rust with no such function to call.
# Valid forms: `for var in range(n)` and `for in range(n)` — in both, the
# token right before `range` is `in`, and the token(s) before that are the
# start of a `for` header (`for`, or `for var`).
macro check_range_placement
	# ex: range{(}n) — kw_pos+1 checks that this is actually a call, not just the bare name
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	# ex: for var {in} range(n) — kw_pos-1 checks for the 'in' keyword right before 'range'
	fn int locate_prev_token(int kw_pos)
		return kw_pos - 1

	# ex: for {var} in range(n) — kw_pos-2 checks for a loop variable or 'for' itself
	fn int locate_prev2(int kw_pos)
		return kw_pos - 2

	# ex: {for} var in range(n) — kw_pos-3 confirms the 'for' that opened this header
	fn int locate_prev3(int kw_pos)
		return kw_pos - 3

	if cur_kind is "IDENT"
		if cur_val is "range"
			int next_pos = locate_next_token(pos)
			if next_pos < token_count
				Token next_token = tokens at next_pos
				(kind) in next_token
				if kind is "LPAREN"
					bool is_valid = false
					if pos > 1
						int prev_pos = locate_prev_token(pos)
						Token prev_token = tokens at prev_pos
						(kind) in prev_token
						if kind is "KW_IN"
							int prev2_pos = locate_prev2(pos)
							Token prev2_token = tokens at prev2_pos
							(kind) in prev2_token
							if kind is "KW_FOR"
								is_valid = true
							else if kind is "IDENT"
								if pos > 2
									int prev3_pos = locate_prev3(pos)
									Token prev3_token = tokens at prev3_pos
									(kind) in prev3_token
									if kind is "KW_FOR"
										is_valid = true
					if not is_valid
						errors at end = val_err(tok, lbl_call, rule_range_placement)
