# Flags the removed `for var in range(...)` / `for in range(...)` loop form with a
# pointer to the count-loop replacement (`for var N times`). `range` is no longer a
# built-in, so outside a for-header it is just an ordinary name and left alone — only
# a `range(` call sitting directly after a `in` keyword is reported.
macro check_removed_range
	# ex: range{(}n) — kw_pos+1 checks that this is actually a call, not just the bare name
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	# ex: for var {in} range(n) — kw_pos-1 checks for the 'in' keyword right before 'range'
	fn int locate_prev_token(int kw_pos)
		return kw_pos - 1

	if cur_kind is IDENT
		if cur_val is "range"
			int next_pos = locate_next_token(pos)

			if next_pos < token_count and pos > 0
				Token next_token = tokens at next_pos
				(kind) in next_token
				bool is_call = kind is LPAREN
				int prev_pos = locate_prev_token(pos)
				Token prev_token = tokens at prev_pos
				(kind) in prev_token

				if is_call and kind is KW_IN
					errors at end = val_err(tok, lbl_call, rule_range_removed)
