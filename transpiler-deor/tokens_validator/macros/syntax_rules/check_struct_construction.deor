
# Validates `Type var = (field1, field2, ...)` and `Type var = move (field1, field2, ...)`
# struct construction. Fires when the current IDENT token is a known struct type and the
# following tokens form either construction pattern. Checks that the provided variable
# names match the struct's declared fields exactly, whether or not 'move' is present —
# the plain (non-move) form used to skip this check entirely, letting a typo'd field name
# through to an opaque rustc error instead of a clear one here.
macro check_struct_construction
	# ex: Item {item} = (a, b) — kw_pos+1 grabs the variable name
	fn int locate_var_name(int kw_pos)
		return kw_pos + 1

	# ex: Item item {=} (a, b) — kw_pos+2 grabs the equals sign
	fn int locate_equals(int kw_pos)
		return kw_pos + 2

	# ex: Item item = {(}a, b)  OR  Item item = {move}(a, b) — kw_pos+3 is either the
	# opening paren (plain form) or the move keyword (move form)
	fn int locate_value_or_move(int kw_pos)
		return kw_pos + 3

	# ex: Item item = move{(}a, b) — kw_pos+4 grabs the opening paren after 'move'
	fn int locate_paren_after_move(int kw_pos)
		return kw_pos + 4

	if paren_depth is 0
		int name_pos = locate_var_name(pos)
		int equals_pos = locate_equals(pos)
		int value_pos = locate_value_or_move(pos)
		if value_pos < token_count
			Token name_token = tokens at name_pos
			Token equals_token = tokens at equals_pos
			Token value_token = tokens at value_pos
			(kind) in name_token
			string name_kind = kind
			(kind) in equals_token
			string equals_kind = kind
			(kind) in value_token
			string value_kind = kind
			bool is_var = name_kind is "IDENT"
			bool is_eq = equals_kind is "EQUALS"
			bool prefix_ok = is_var and is_eq

			bool matched = false
			int paren_pos = value_pos
			if prefix_ok
				if value_kind is "LPAREN"
					matched = true
				else if value_kind is "KW_MOVE"
					int move_paren_pos = locate_paren_after_move(pos)
					if move_paren_pos < token_count
						Token move_paren_token = tokens at move_paren_pos
						(kind) in move_paren_token
						if kind is "LPAREN"
							matched = true
							paren_pos = move_paren_pos

			if matched
				string sep = ","
				string fields_str = find_struct_field_str(struct_field_reg, cur_val)
				bool is_struct = fields_str is not ""
				if is_struct
					strList expected_fields = s_split(fields_str, sep)
					int expected_count = len(expected_fields)
					strList provided_fields = empty
					int scan_pos = paren_pos + 1
					bool scanning = true
					for if scanning
						if scan_pos >= token_count
							scanning = false
						else
							Token scan_token = tokens at scan_pos
							(kind, value) in scan_token
							if kind is "RPAREN"
								scanning = false
							else if kind is "IDENT"
								provided_fields at end = value
							scan_pos = scan_pos + 1
					int provided_count = len(provided_fields)
					bool wrong_count = provided_count is not expected_count
					if wrong_count
						errors at end = val_err(tok, lbl_struct, rule_struct_field_count)
					else
						int field_index = 0
						for if field_index < provided_count
							string field_name = provided_fields at field_index
							if not list_has(expected_fields, field_name)
								errors at end = val_err(tok, lbl_struct, rule_struct_field_name)
							field_index = field_index + 1
