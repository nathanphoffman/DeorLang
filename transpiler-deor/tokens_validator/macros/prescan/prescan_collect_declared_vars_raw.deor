
# Declared-var collection, raw decl form ('raw name = expr'). Part of
# prescan_collect_declared_vars — see that macro's header for the full list
# of binding forms this prescan pass covers and what it feeds.
# Reads: pre_i, tokens, token_count.
# Writes: declared_var_names.
macro prescan_collect_declared_vars_raw
	# ex: raw {name} = expr — kw_pos+1 grabs the raw variable name
	fn int locate_name(int kw_pos)
		return kw_pos + 1

	# ex: raw name {=} expr — kw_pos+2 grabs the equals sign
	fn int locate_equals(int kw_pos)
		return kw_pos + 2

	if kind is "KW_RAW"
		int name_pos = locate_name(pre_i)
		int equals_pos = locate_equals(pre_i)
		if equals_pos < token_count
			Token name_token = tokens at name_pos
			Token equals_token = tokens at equals_pos
			(kind, value) in name_token
			string name_kind = kind
			string name_value = value
			(kind) in equals_token
			if name_kind is "IDENT" and kind is "EQUALS"
				declared_var_names at end = name_value
