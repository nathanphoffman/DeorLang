
# Prescan pass: collects every name introduced by any binding form into
# declared_var_names, so check_undeclared_reassign can tell a real reassignment
# (`total = total + 1`, name declared earlier) from a typo'd or never-declared
# bare `=` (`hello = "world"`, name never introduced anywhere). Also the backing
# registry for check_undefined_var_read, which flags any *read* of a name never
# introduced here (or in enum_variant_names / fn_names).
#
# Split into one sub-macro per binding source, each independent and order
# between them doesn't matter — every section is gated on its own
# `if kind is "..."` check — see each sub-macro's own header for its
# Reads/Writes:
#   prescan_collect_declared_vars_binding         — typed decl / const /
#     validator, as-binding, and validator type bare decl
#   prescan_collect_declared_vars_raw             — raw decl ('raw name = expr')
#   prescan_collect_declared_vars_validator_param — validator type's own
#     predicate parameter ('type Roll(int val)')
#   prescan_collect_declared_vars_for             — for-loop vars, plain and
#     move-destructure ('for item in list' / 'for move (item in collection)')
#   prescan_collect_declared_vars_fn_params       — fn params
#     ('fn Ret name(Type1 p1, Type2 p2)')
#   prescan_collect_declared_vars_enum            — typed enum variants
#   prescan_collect_declared_vars_destructure     — tuple destructuring
#     ('(f1, f2) in source')
macro prescan_collect_declared_vars
	macro_run prescan_collect_declared_vars_binding
	macro_run prescan_collect_declared_vars_raw
	macro_run prescan_collect_declared_vars_validator_param
	macro_run prescan_collect_declared_vars_for
	macro_run prescan_collect_declared_vars_fn_params
	macro_run prescan_collect_declared_vars_enum
	macro_run prescan_collect_declared_vars_destructure
