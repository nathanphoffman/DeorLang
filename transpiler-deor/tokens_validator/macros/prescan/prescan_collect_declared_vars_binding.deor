
# Declared-var collection, IDENT-led binding forms: typed decl / const /
# validator ('Type name = expr'), as-binding ('name as expr'), and a
# validator type's own bare declaration without '=' ('Roll best' — the "not
# valid until assigned" form, which still declares the name so a later
# `best = expr` reassignment isn't flagged as undeclared). Part of
# prescan_collect_declared_vars — see that macro's header for the full list
# of binding forms this prescan pass covers and what it feeds.
# Reads: pre_i, pre_tok, tokens, token_count, validator_type_names.
# Writes: declared_var_names.
macro prescan_collect_declared_vars_binding
	# ex: Type {name} = expr — kw_pos+1 grabs the variable name
	fn int locate_name(int kw_pos)
		return kw_pos + 1

	# ex: Type name {=} expr — kw_pos+2 grabs the equals sign
	fn int locate_equals(int kw_pos)
		return kw_pos + 2

	if kind is "IDENT"
		int name_pos = locate_name(pre_i)
		int equals_pos = locate_equals(pre_i)
		if equals_pos < token_count
			Token name_token = tokens at name_pos
			Token equals_token = tokens at equals_pos
			(kind, value) in name_token
			string name_kind = kind
			string name_value = value
			(kind) in equals_token
			if name_kind is "IDENT" and kind is "EQUALS"
				declared_var_names at end = name_value
		if name_pos < token_count
			# ex: {name} as expr — name_pos grabs the 'as' keyword slot
			Token as_token = tokens at name_pos
			(kind) in as_token
			if kind is "KW_AS"
				(value) in pre_tok
				declared_var_names at end = value
			# ex: Roll {best} — a validator type's bare declaration without '='
			# (the "not valid until assigned" form) still declares the name, so a
			# later `best = expr` reassignment isn't flagged as undeclared
			(value) in pre_tok
			bool is_vtype = list_has(validator_type_names, value)
			if is_vtype
				if kind is "IDENT"
					(value) in as_token
					declared_var_names at end = value
