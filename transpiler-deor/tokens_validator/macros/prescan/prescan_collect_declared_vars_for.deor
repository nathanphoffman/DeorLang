
# Declared-var collection, for-loop variable forms: the plain loop var
# ('for item in list') and the move-destructure header
# ('for move (item in collection)') — a separate token shape from the plain
# form, so it needs its own fixed offsets rather than reusing them. Part of
# prescan_collect_declared_vars — see that macro's header for the full list
# of binding forms this prescan pass covers and what it feeds.
# Reads: pre_i, tokens, token_count.
# Writes: declared_var_names.
macro prescan_collect_declared_vars_for
	# ex: for {item} in list — kw_pos+1 grabs the loop variable
	fn int locate_loop_var(int kw_pos)
		return kw_pos + 1

	# ex: for item {in} list — kw_pos+2 grabs the 'in' keyword
	fn int locate_in_keyword(int kw_pos)
		return kw_pos + 2

	# ex: for {move} (item in collection) — kw_pos+1 grabs the move keyword slot
	fn int locate_move_keyword(int kw_pos)
		return kw_pos + 1

	# ex: for move {(}item in collection) — kw_pos+2 grabs the opening paren
	fn int locate_move_lparen(int kw_pos)
		return kw_pos + 2

	# ex: for move ({item} in collection) — kw_pos+3 grabs the loop variable
	fn int locate_move_var(int kw_pos)
		return kw_pos + 3

	# ex: for move (item {in} collection) — kw_pos+4 grabs the 'in' keyword
	fn int locate_move_in(int kw_pos)
		return kw_pos + 4

	if kind is KW_FOR
		int loop_var_pos = locate_loop_var(pre_i)
		int in_pos = locate_in_keyword(pre_i)

		if in_pos < token_count
			kind as token_kind_at(tokens, loop_var_pos)
			value as token_value_at(tokens, loop_var_pos)
			string loop_var_kind = kind
			string loop_var_value = value
			kind as token_kind_at(tokens, in_pos)

			if loop_var_kind is IDENT and kind is KW_IN
				declared_var_names at end = loop_var_value

		# A separate shape from the plain form above, so it needs its own
		# offsets rather than reusing them.
		int move_pos = locate_move_keyword(pre_i)

		if move_pos < token_count
			kind as token_kind_at(tokens, move_pos)

			if kind is KW_MOVE
				int move_lparen_pos = locate_move_lparen(pre_i)
				int move_var_pos = locate_move_var(pre_i)
				int move_in_pos = locate_move_in(pre_i)

				if move_in_pos < token_count
					kind as token_kind_at(tokens, move_lparen_pos)
					bool move_lparen_ok = kind is LPAREN
					kind as token_kind_at(tokens, move_var_pos)
					value as token_value_at(tokens, move_var_pos)
					string move_var_kind = kind
					string move_var_value = value
					kind as token_kind_at(tokens, move_in_pos)

					if move_lparen_ok and move_var_kind is IDENT and kind is KW_IN
						declared_var_names at end = move_var_value
