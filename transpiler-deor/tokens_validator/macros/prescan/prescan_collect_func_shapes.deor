
# Prescan pass: collects names of func shapes (shape Foo = func ...) into
# func_shape_names so prescan_check_struct_fields can reject them as field types.
# Must run in a dedicated first pass before the main prescan loop.
macro prescan_collect_func_shapes
	# ex: shape Foo = {func} of A to B — kw_pos+3 grabs the form keyword
	fn int locate_form(int kw_pos)
		return kw_pos + 3

	# ex: shape {Foo} = func ... — kw_pos+1 grabs the shape name
	fn int locate_name(int kw_pos)
		return kw_pos + 1

	if kind is KW_SHAPE
		int form_pos = locate_form(pre_i)

		if form_pos < token_count
			kind as token_kind_at(tokens, form_pos)

			if kind is KW_FUNC
				int name_pos = locate_name(pre_i)

				if name_pos < token_count
					kind as token_kind_at(tokens, name_pos)
					value as token_value_at(tokens, name_pos)

					if kind is IDENT
						func_shape_names at end = value
