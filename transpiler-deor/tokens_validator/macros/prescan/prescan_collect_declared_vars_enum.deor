
# Declared-var collection, typed enum variant form ('enum string Color\n\tRed
# = "Red"') — a typed enum's variants are themselves declared names, unlike
# an untyped enum's. Part of prescan_collect_declared_vars — see that
# macro's header for the full list of binding forms this prescan pass
# covers and what it feeds.
# Reads: pre_i, tokens, token_count, primitive_type_names.
# Writes: declared_var_names.
macro prescan_collect_declared_vars_enum
	# ex: enum {string} Color — kw_pos+1 grabs the type keyword slot of a typed enum
	fn int locate_type_keyword(int kw_pos)
		return kw_pos + 1

	if kind is "KW_ENUM"
		int type_keyword_pos = locate_type_keyword(pre_i)
		if type_keyword_pos < token_count
			Token type_keyword_token = tokens at type_keyword_pos
			(kind, value) in type_keyword_token
			bool is_typed = false
			if kind is "IDENT"
				is_typed = list_has(primitive_type_names, value)
			if is_typed
				# find the INDENT that opens this enum's variant block
				int indent_scan_pos = type_keyword_pos + 2
				for if indent_scan_pos < token_count
					Token indent_scan_token = tokens at indent_scan_pos
					(kind) in indent_scan_token
					if kind is "INDENT"
						break
					indent_scan_pos = indent_scan_pos + 1
				# ex: enum string Color\n{\t}Red = "Red" — indent_scan_pos+1 grabs the first variant name
				int body_pos = indent_scan_pos + 1
				int depth = 1
				for if body_pos < token_count
					Token body_token = tokens at body_pos
					(kind, value) in body_token
					if kind is "INDENT"
						depth = depth + 1
					else if kind is "DEDENT"
						depth = depth - 1
						if depth is 0
							break
					else if kind is "IDENT"
						# ex: Red {=} "Red" — body_pos+1 grabs the equals sign after a variant name
						int equals_check_pos = body_pos + 1
						if equals_check_pos < token_count
							Token equals_check_token = tokens at equals_check_pos
							(kind) in equals_check_token
							if kind is "EQUALS"
								declared_var_names at end = value
					body_pos = body_pos + 1
