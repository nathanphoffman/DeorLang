
# Prescan pass: walks each enum body and validates that all variants are PascalCase,
# at least 3 chars, and follow the correct syntax for their enum kind. Also
# registers every variant name into enum_variant_names, so check_undefined_var_read
# recognizes a bare variant reference (`ColorTag bg = Blue`, `if bg is Blue`) as a
# known name — untyped variants never enter declared_var_names any other way — and
# registers the enum's own name into enum_names, so the same check recognizes a
# typed enum's name where it's used as an extraction source (`(Red) in Color`) —
# unlike a struct destructure's source, `Color` here is a compile-time enum name,
# never a runtime variable, so it can't come from declared_var_names either.
#
# Untyped enums (enum Name): variants are bare identifiers — no data, no '= value'.
# Typed enums (enum string/int/float/bool Name): each variant MUST have '= value'.
macro prescan_check_enum_variants
	# ex: enum {string} Color — kw_pos+1 grabs the token after enum to check for a
	# type keyword; for an untyped enum this same slot is the enum's own name.
	fn int locate_enum_type_or_name_slot(int kw_pos)
		return kw_pos + 1

	# ex: enum string {Color} — kw_pos+2 grabs the enum name after the type keyword
	fn int locate_enum_typed_name(int kw_pos)
		return kw_pos + 2

	if kind is "KW_ENUM"
		# Detect typed vs. untyped by peeking at token after KW_ENUM
		bool is_typed = false
		int scan_pos = locate_enum_type_or_name_slot(pre_i)
		if scan_pos < token_count
			Token type_keyword_token = tokens at scan_pos
			(value) in type_keyword_token
			is_typed = list_has(primitive_type_names, value)

		# the enum's own name sits one slot further in for a typed enum
		int name_pos = locate_enum_type_or_name_slot(pre_i)
		if is_typed
			name_pos = locate_enum_typed_name(pre_i)
		if name_pos < token_count
			Token name_token = tokens at name_pos
			(kind, value) in name_token
			if kind is "IDENT"
				enum_names at end = value
				if not is_typed
					declared_type_names at end = value

		# Scan forward to INDENT (works for both typed and untyped)
		for if scan_pos < token_count
			Token scan_token = tokens at scan_pos
			(kind) in scan_token
			if kind is "INDENT"
				break
			scan_pos = scan_pos + 1
		scan_pos = scan_pos + 1

		# Validate each variant in the body
		for if scan_pos < token_count
			Token scan_token = tokens at scan_pos
			(kind) in scan_token
			if kind is "DEDENT"
				break
			if kind is "IDENT"
				(value) in scan_token
				enum_variant_names at end = value
				if len(value) < 3
					errors at end = val_err(scan_token, lbl_variant, rule_min3)
				if not is_pascal(value)
					errors at end = val_err(scan_token, lbl_variant, rule_enum_pascal)
				int after_variant_pos = scan_pos + 1
				if after_variant_pos < token_count
					Token after_variant_token = tokens at after_variant_pos
					(kind) in after_variant_token
					if is_typed
						if kind is not "EQUALS"
							errors at end = val_err(scan_token, lbl_variant, rule_typed_enum_eq)
					else
						if kind is "LPAREN"
							errors at end = val_err(scan_token, lbl_variant, rule_enum_data)
						if kind is "EQUALS"
							errors at end = val_err(scan_token, lbl_variant, rule_untyped_enum_eq)
			else if list_has(reserved_keywords, kind)
				errors at end = val_err(scan_token, lbl_variant, rule_kw_in_parens)
			scan_pos = scan_pos + 1
