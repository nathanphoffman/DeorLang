
# Declared-var collection, validator type predicate parameter
# ('type Roll(int val)'). The only declaration form check_undefined_var_read
# couldn't otherwise see, since the predicate body reads this name like any
# other local var. Part of prescan_collect_declared_vars — see that macro's
# header for the full list of binding forms this prescan pass covers and
# what it feeds.
# Reads: pre_i, tokens, token_count.
# Writes: declared_var_names.
macro prescan_collect_declared_vars_validator_param
	# ex: type Roll({int} val) — kw_pos+2 grabs the opening paren
	fn int locate_left_paren(int kw_pos)
		return kw_pos + 2

	# ex: type Roll(int {val}) — kw_pos+4 grabs the predicate's own parameter
	# name (same fixed offsets check_validator_declaration uses) — this is the
	# only declaration form check_undefined_var_read couldn't otherwise see,
	# since the predicate body reads this name like any local var
	fn int locate_param_name(int kw_pos)
		return kw_pos + 4

	if kind is KW_TYPE
		int left_paren_pos = locate_left_paren(pre_i)
		int param_name_pos = locate_param_name(pre_i)

		if param_name_pos < token_count
			kind as token_kind_at(tokens, left_paren_pos)

			if kind is LPAREN
				kind as token_kind_at(tokens, param_name_pos)
				value as token_value_at(tokens, param_name_pos)

				if kind is IDENT
					declared_var_names at end = value
