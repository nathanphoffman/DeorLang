
# Declared-var collection, fn param form ('fn Ret name(Type1 p1, Type2 p2)').
# Part of prescan_collect_declared_vars — see that macro's header for the
# full list of binding forms this prescan pass covers and what it feeds.
# Reads: pre_i, tokens, token_count.
# Writes: declared_var_names.
macro prescan_collect_declared_vars_fn_params
	# ex: fn int add{(}left, right) — kw_pos+3 grabs the opening paren
	fn int locate_left_paren(int kw_pos)
		return kw_pos + 3

	if kind is "KW_FN"
		int left_paren_pos = locate_left_paren(pre_i)
		if left_paren_pos < token_count
			Token left_paren_token = tokens at left_paren_pos
			(kind) in left_paren_token
			if kind is "LPAREN"
				int param_scan_pos = left_paren_pos + 1
				for if param_scan_pos < token_count
					Token param_scan_token = tokens at param_scan_pos
					(kind, value) in param_scan_token
					if kind is "RPAREN"
						break
					if kind is "COMMA"
						param_scan_pos = param_scan_pos + 1
						continue
					if kind is "IDENT"
						# ex: {Type} name — param_scan_pos+1 grabs the param name after its type
						int param_name_pos = param_scan_pos + 1
						if param_name_pos < token_count
							Token param_name_token = tokens at param_name_pos
							(kind, value) in param_name_token
							if kind is "IDENT"
								declared_var_names at end = value
								param_scan_pos = param_name_pos
					param_scan_pos = param_scan_pos + 1
