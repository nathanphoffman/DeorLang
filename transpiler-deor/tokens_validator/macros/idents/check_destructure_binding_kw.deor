# Flags a reserved keyword or built-in function name used as a destructuring binding
# name: `(f1, keyword) in expr`. Only fires for a genuine destructure — the matching
# close paren must be followed by KW_IN — so a plain parenthesized expression like
# `(not flag)` is untouched. Without the reserved-keyword check, a keyword in a
# binding-name slot used to hang the compiler forever: for_collect_fields_into_fields_list's
# cursor only advanced inside its RPAREN/COMMA/IDENT branches, so an unrecognized token
# kind left the cursor stuck and the loop never terminated.
macro check_destructure_binding_kw
	# ex: {(}f1, val) — kw_pos-1 checks the token before '(' for a call target
	fn int locate_prev_token(int kw_pos)
		return kw_pos - 1

	# ex: ({f1}, val) — kw_pos+1 grabs the first binding-name slot
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if cur_kind is "LPAREN"
		bool is_call = false
		if pos > 0
			int prev_pos = locate_prev_token(pos)
			Token prev_token = tokens at prev_pos
			(kind) in prev_token
			is_call = kind is "IDENT"
		if not is_call
			int scan_pos = locate_next_token(pos)
			int depth = 1
			for if scan_pos < token_count
				Token scan_token = tokens at scan_pos
				(kind) in scan_token
				if kind is "LPAREN"
					depth = depth + 1
				else if kind is "RPAREN"
					depth = depth - 1
					if depth is 0
						break
				scan_pos = scan_pos + 1
			# ex: (f1, val){)} in items — scan_pos+1 checks the token after the matched close paren for KW_IN
			int after_pos = scan_pos + 1
			bool is_destructure = false
			if after_pos < token_count
				Token after_token = tokens at after_pos
				(kind) in after_token
				is_destructure = kind is "KW_IN"
			if is_destructure
				int name_pos = locate_next_token(pos)
				bool at_name_slot = true
				for if name_pos < scan_pos
					Token name_token = tokens at name_pos
					(kind, value) in name_token
					if kind is "COMMA"
						at_name_slot = true
					else if at_name_slot
						if kind is "IDENT"
							if list_has(builtin_names, value)
								errors at end = val_err(name_token, lbl_var, rule_builtin_shadow)
						else if list_has(reserved_keywords, kind)
							errors at end = val_err(name_token, lbl_var, rule_kw_in_parens)
						at_name_slot = false
					name_pos = name_pos + 1
