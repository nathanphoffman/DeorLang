
# Tracks every IDENT that is declared with a validator type so check_avow_target
# and check_validator_reassign can verify their targets. Fires whenever a
# validator type name is followed by an IDENT: covers variable declarations
# (Roll best, Roll best = expr), function parameters (fn T name(Roll param)),
# and struct fields.
# Note: function return-type positions also match (fn Roll func_name(...)) but
# those additions are harmless — function names are never avow/reassign targets.
# The list itself is reset per-function by track_block_scope (see there for why).
macro track_validator_vars
	# ex: Roll {best} = expr — kw_pos+1 grabs the token after the validator type
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if cur_kind is "IDENT"
		bool is_vtype = list_has(validator_type_names, cur_val)
		if is_vtype
			int next_pos = locate_next_token(pos)
			if next_pos < token_count
				Token next_token = tokens at next_pos
				(kind, value) in next_token
				if kind is "IDENT"
					validator_vars at end = value
