
# Tracks declared variable types for two downstream checks:
#   non_bool_var_names — anything except 'bool' and validator types, since only
#     those two have bare truthiness (see check_bare_truthiness).
#   string_var_names — vars declared 'string', so check_string_plus_banned can
#     catch '+' touching a string operand instead of letting it fail as an
#     opaque rustc error.
# Three sources: typed declarations ('Type name = expr', same pattern check_var_decl
# detects), function parameters ('fn Ret name(Type1 p1, Type2 p2, ...)'), and
# `as` bindings whose right-hand side is a STRING literal or another tracked
# string var ('name as "literal"' / 'name as other_string_var') — `as` bindings
# have no declared type token to key off, so string_var_names is the only one of
# the two lists that can pick them up at all (non_bool_var_names has no positive
# non-string/non-bool signal to go on here, so `as`-bound names are left out of it).
# Deliberately does NOT track destructured struct fields ('(field) in source') —
# there's no field-type registry to look up against, so those are left
# unclassified rather than guessed at; every check here only flags names it can
# positively confirm.
macro track_non_bool_vars
	# ex: Type {name} = expr — kw_pos+1 grabs the variable name
	fn int locate_var_name(int kw_pos)
		return kw_pos + 1

	# ex: Type name {=} expr — kw_pos+2 grabs the equals sign
	fn int locate_equals(int kw_pos)
		return kw_pos + 2

	# ex: fn int add{(}left, right) — kw_pos+3 grabs the opening paren
	fn int locate_left_paren(int kw_pos)
		return kw_pos + 3

	if cur_kind is "IDENT"
		int name_pos = locate_var_name(pos)
		int equals_pos = locate_equals(pos)
		if equals_pos < token_count
			Token name_token = tokens at name_pos
			Token equals_token = tokens at equals_pos
			(kind) in name_token
			string name_kind = kind
			(kind) in equals_token
			string equals_kind = kind
			if name_kind is "IDENT" and equals_kind is "EQUALS"
				bool is_bool = cur_val is "bool"
				bool is_vtype = list_has(validator_type_names, cur_val)
				if not is_bool
					if not is_vtype
						(value) in name_token
						non_bool_var_names at end = value
				if cur_val is "string"
					(value) in name_token
					string_var_names at end = value

			# ex: {name} as "literal" / name as other_str — name_kind is KW_AS, equals_kind is the RHS
			if name_kind is "KW_AS"
				bool as_is_str = equals_kind is "STRING"
				if not as_is_str
					if equals_kind is "IDENT"
						(value) in equals_token
						as_is_str = list_has(string_var_names, value)
				if as_is_str
					string_var_names at end = cur_val

	if cur_kind is "KW_FN"
		int left_paren_pos = locate_left_paren(pos)
		if left_paren_pos < token_count
			Token left_paren_token = tokens at left_paren_pos
			(kind) in left_paren_token
			if kind is "LPAREN"
				int param_scan_pos = left_paren_pos + 1
				for if param_scan_pos < token_count
					Token param_scan_token = tokens at param_scan_pos
					(kind, value) in param_scan_token
					if kind is "RPAREN"
						break
					if kind is "COMMA"
						param_scan_pos = param_scan_pos + 1
						continue
					if kind is "IDENT"
						string param_type = value
						int param_name_pos = param_scan_pos + 1
						if param_name_pos < token_count
							Token param_name_token = tokens at param_name_pos
							(kind, value) in param_name_token
							if kind is "IDENT"
								bool param_is_bool = param_type is "bool"
								bool param_is_vtype = list_has(validator_type_names, param_type)
								if not param_is_bool
									if not param_is_vtype
										non_bool_var_names at end = value
								if param_type is "string"
									string_var_names at end = value
								param_scan_pos = param_name_pos
					param_scan_pos = param_scan_pos + 1
