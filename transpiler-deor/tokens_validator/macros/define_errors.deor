# Declares all validation error message strings used across the token validator macros.
unsafe_macro define_errors

	# category labels — identify what kind of thing an error is about, paired
	# with a rule_* string to form a full message (val_err(tok, lbl_X, rule_Y))
	string lbl_struct = "struct"
	string lbl_enum = "enum"
	string lbl_shape = "shape"
	string lbl_type = "type"
	string lbl_fn = "fn"
	string lbl_var = "variable"
	string lbl_call = "call to"
	string lbl_rust = "identifier"
	string lbl_decl = "declaration"
	string lbl_field = "struct field"
	string lbl_variant = "enum variant"
	string lbl_stmt = "statement"

	# naming rules
	string rule_min3 = "name must be at least 3 characters [min3]"
	string rule_no_option = "Rust generic types (Option/Vec/Box/Rc/Arc/Result) are not valid in Deor — use shapes or validator types [no_option]"
	string rule_pascal = "name must be PascalCase (start with uppercase letter) [pascal]"
	string rule_camel = "name must be camelCase (start lowercase, no underscores) [camel]"
	string rule_snake = "name must be lower_snake_case (no uppercase letters) [snake]"
	string rule_screaming = "const name must be SCREAMING_SNAKE_CASE (all caps, underscores between words) [screaming]"
	string rule_named_arg = "each arg must be a named variable when passing 2 or more args [named_arg]"
	string rule_unknown_type = "not a known type — must be a primitive (int, float, string, bool), or a declared struct, shape, raw type, validator type, or untyped enum name [unknown_type]"

	# declaration rules
	string rule_enum_pascal = "enum variant must be PascalCase [enum_pascal]"
	string rule_dup_variant = "enum variant name is already used by another enum — bare variant names must be unique across all untyped enums (rename one, e.g. prefix it with its enum's name) [dup_variant]"
	string rule_with_assign = "'with' only works when declaring a new variable — use 'Type name = source with (field)' or 'name as source with (field)', not 'name = source with (field)' [with_assign]"
	string rule_enum_data = "enum variants cannot carry data — use a struct alongside the enum instead [enum_data]"
	string rule_typed_enum_eq = "typed enum variant must have a value — add '= value' after the variant name [typed_enum_eq]"
	string rule_untyped_enum_eq = "untyped enum variant cannot have a value — use 'enum string/int Name' to associate values with variants [untyped_enum_eq]"
	string rule_non_primitive_validator = "validator base type must be a primitive (int, float, string, bool) or a struct — list shapes and other validator types cannot be used [non_primitive_validator]"
	string rule_validator_missing_body = "validator type is missing a predicate body — add an indented block that returns a bool, e.g. 'return val > 0' [validator_missing_body]"
	string rule_missing_return_expr = "looks like a value meant to be returned, but 'return' is missing — only a function body that's a single expression implicitly returns; add 'return' here [missing_return_expr]"

	# function rules
	string rule_max_params = "functions may have at most 3 parameters [max_params]"
	string rule_param_shadow = "parameter name cannot be the same as its type — choose a descriptive name [param_shadow]"
	string rule_type_param_shadow = "validator parameter name cannot be the same as the type name — use a descriptive name like 'val' or 'num' [type_param_shadow]"
	string rule_no_ret = "missing return type — use 'fn void name()' for functions that return nothing [no_ret]"
	string rule_nested_fn = "functions may only be declared at the top level of a file or nested directly inside another fn — not inside a struct/enum/shape/macro body [nested_fn]"
	string rule_nested_fn_body_shape = "a fn nested inside another fn must have a body of exactly one 'return expr' statement — no local variables, moves, or other statements [nested_fn_body_shape]"
	string rule_void_return = "void functions must not use return — remove the return statement and let the function fall through [void_return]"
	string rule_return_empty = "cannot return 'empty' — declare a validator type variable without a value and return it to signal not-valid [return_empty]"
	string rule_return_none = "none is not a Deor keyword — declare a validator type variable without a value and return it to signal not-valid [return_none]"
	string rule_void_var = "'void' is not a valid variable type — only functions can return void [void_var]"
	string rule_crash = "crash takes exactly 1 string argument [crash]"
	string rule_print_args = "print takes 1 argument, or 2 arguments where the second replaces the trailing newline [print_args]"
	string rule_range_args = "range takes 1 argument (range(count)) or 2 arguments (range(start, end)) [range_args]"
	string rule_len_args = "len takes exactly 1 argument [len_args]"

	# statement rules
	string rule_avow = "avow can only be used on a validator type variable [avow]"
	string rule_invalid_char = "character is not valid in Deor — use Deor operators and keywords; raw Rust syntax belongs inside a 'rust' block [invalid_char]"
	string rule_validator_empty = "empty is not valid for validator types — declare without a value to start as not valid: 'Roll best' [validator_empty]"
	string rule_bad_stmt = "literal cannot follow 'name ident' — capture in a named variable first [bad_stmt]"
	string rule_undeclared_reassign = "'name = expr' only works for reassigning an existing variable — this name was never declared. Prefix it with a type to declare it (e.g. 'string hello = expr'), or use 'as' instead of '=' if it's a fresh binding and moving/copying ownership is fine (e.g. 'hello as expr') [undeclared_reassign]"
	string rule_undefined_var = "used here but never declared anywhere — check for a typo, or declare it first ('string name = expr', 'name as expr', a function parameter, or a for-loop variable) [undefined_var]"
	string rule_typed_as = "typed `as` bindings are not supported — use `a as b` to transfer ownership, or `Type a = move b` for an explicit typed move [typed_as]"
	string rule_as_move = "`as` already transfers ownership — use `a as b` instead of `a as move b` [as_move]"
	string rule_bracket_index = "bracket indexing is not valid in Deor — use 'name at index' instead [bracket_index]"
	string rule_multiline_list = "a list literal must stay on one line — keep [a, b, c] on a single line, or append the items one at a time with 'list at end = item' [multiline_list]"
	string rule_empty_bracket = "use 'empty' to initialize an empty list — [] is only valid with items inside [empty_bracket]"
	string rule_move = "'move' can only precede a variable name — 'move 5' or 'move \"hello\"' are not valid [move]"
	string rule_use_after_move = "used here but already moved earlier — the value was consumed by an earlier 'move' and cannot be read again [use_after_move]"
	string rule_double_move = "already moved earlier — 'move' cannot consume the same variable twice [double_move]"
	string rule_not_needs_bool = "'not' only works on a bool — a number or string has no true/false to flip (compare it first, e.g. 'count is not 0') [not_needs_bool]"
	string rule_not_then_operator = "'not' binds tighter than the operator after it, so 'not a > b' means '(not a) > b' — compare first ('bool big = a > b') and then use 'not big' [not_then_operator]"
	string rule_not_is = "use 'x is not y' instead of 'not x is y' — 'not' binds before 'is' resolves [not_is]"
	string rule_kw_in_parens = "reserved keyword cannot be used as a name — choose a different variable name [kw_in_parens]"
	string rule_valid = "'valid' can only appear after 'is' or 'is not' — it cannot be assigned or returned [valid]"
	string rule_end = "'end' can only appear directly after 'at' (list at end / list at end = val) — it cannot be used as a variable name or expression [end]"
	string rule_with_parens = "'with' must be followed by a parenthesized field list — 'with (area)', not 'with area' — parens are required even for a single field [with_parens]"
	string rule_with_fields = "'with (...)' accepts only existing variable names separated by commas — 'with (value as field)' is not supported. Assign the new value to a variable named after the field first, then use 'with (field)' [with_fields]"
	string rule_unmatched_open_paren = "'(' is never closed — every open paren needs a matching ')' [unmatched_open_paren]"
	string rule_unmatched_close_paren = "')' has no matching '(' before it — remove the extra ')' or add the missing '(' [unmatched_close_paren]"
	string rule_empty_parens = "'()' is not valid — parens must contain at least one item, except when declaring or calling a zero-parameter function [empty_parens]"
	string rule_unmatched_open_bracket = "'[' is never closed — every open bracket needs a matching ']' [unmatched_open_bracket]"
	string rule_unmatched_close_bracket = "']' has no matching '[' before it — remove the extra ']' or add the missing '[' [unmatched_close_bracket]"
	string rule_builtin_shadow = "this name belongs to a built-in function (print, crash, len, range, args, input) and cannot be shadowed or redeclared [builtin_shadow]"
	string rule_range_placement = "'range' can only be used as a for-loop's iterator expression ('for var in range(n)' or 'for in range(n)') — it cannot be assigned to a variable or passed as an argument [range_placement]"
	string rule_bare_tuple_range = "bare tuple range ('for var in (start, end)') is not valid — use 'for var in range(start, end)' instead [bare_tuple_range]"
	string rule_bare_truthiness = "only bool and validator types have truthiness — use an explicit comparison ('is not 0', 'is not \"\"', 'is valid', etc.) [bare_truthiness]"
	string rule_func_shape_multi_param = "func shapes accept at most one input type and one output type — bundle multiple values into a struct instead [func_shape_multi_param]"
	string rule_string_plus_banned = "'+' cannot be used with strings — use s_join([a, b, ...]) or s_join_with(list, sep) instead [string_plus_banned]"
	string rule_double_equals = "'==' is not valid in Deor — use 'is' for equality comparison [double_equals]"

	# const rules
	string rule_const_reassign = "cannot reassign a const variable — const bindings are immutable [const_reassign]"

	# validator type rules
	string rule_validator_reassign = "cannot reassign a validator type variable with 'as' — it skips the predicate check; use 'name = expr' to re-validate, or 'TypeName name = expr' for a fresh declaration [validator_reassign]"

	# raw rules
	string rule_raw_in_expr = "raw variables cannot be used in Deor operators, builtins, or rebindings — pass them to a function or consume them inside a rust block [raw_in_expr]"
	string rule_raw_reassign = "raw variables cannot be reassigned — declare a new 'raw name = expr' instead [raw_reassign]"
	string rule_raw_assignment = "raw variables can only be assigned from a function call — use 'raw name = some_function()', not a literal or an inline rust block [raw_assignment]"
	string rule_raw_as = "raw declarations must use '=', not 'as' — 'raw name = call()' declares an opaque value from a function call [raw_as]"

	# struct field rules
	string rule_no_func_field = "func shapes cannot be struct fields — pass the func shape as a function parameter instead [no_func_field]"
	string rule_recursive_struct_field = "a struct cannot hold itself, directly or inside a validator type — it would have infinite size [recursive_struct_field]"
	string rule_no_raw_field = "raw cannot be a struct field — raw values are opaque and cannot be stored in structs [no_raw_field]"

	# struct construction rules
	string rule_struct_field_count = "wrong number of fields in struct construction — all fields must be provided [struct_field_count]"
	string rule_return_with = "'with' cannot be used directly in a return — bind the updated struct first ('updated as ship with (pos)'), then 'return updated' [return_with]"
	string rule_return_tuple_item = "every item in a returned '( )' field list must be a single named variable whose name is a struct field — literals, expressions and calls need a local named after the field first (e.g. 'bool wide = false') [return_tuple_item]"
	string rule_struct_ambiguous = "more than one struct has these fields, so Deor cannot tell which one you mean — build it with an explicit type ('Type name = (fields)') and return that variable [struct_ambiguous]"
	string rule_with_ambiguous = "more than one struct has these fields, so Deor cannot tell which one the source is — use the explicit form 'Type name = source with (fields)' [with_ambiguous]"
	string rule_return_tuple_fields = "returned '( )' field list does not match any struct — the variable names must be exactly the fields of one struct, so name each local after its field [return_tuple_fields]"
	string rule_struct_field_name = "unknown field name in struct construction — variable name does not match any field in this struct [struct_field_name]"
