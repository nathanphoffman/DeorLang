
shape fnTestRule = func of string to bool

# One snapshot per currently-open if/else-if/else chain, used by
# check_use_after_move to track moves flow-sensitively across branches. See
# docs on that macro for the mechanism.
struct UamFrame
	int uam_depth
	strList uam_pre_vars
	strList uam_acc_vars

shape frameStack = list of UamFrame

# One snapshot per currently-open fn, used by track_block_scope to restore
# in_void_fn correctly when a nested fn's body closes back into its enclosing
# fn (which may have a different void-ness than the nested one).
struct VoidFnFrame
	int vff_depth
	bool vff_prev_void

shape voidFrameStack = list of VoidFnFrame

# Walks the merged token list and enforces naming conventions before codegen runs.
# Prints all violations and exits with code 1 if any are found.
fn void validate_tokens(TokensRef tokens)
	int token_count = len(tokens)
	strList errors = empty
	int pos = 0
	int paren_depth = 0
	int block_depth = 0
	bool in_void_fn = false
	bool in_struct_body = false
	bool in_enum_body = false
	bool in_fn_body = false
	bool was_already_in_fn_body = false
	voidFrameStack void_fn_stack = empty

	unsafe_macro_run define_errors

	# Checked first and short-circuited on: an unmatched paren corrupts every
	# other paren_depth-dependent check for the remainder of the file (see
	# check_paren_balance.deor), so it must be reported before anything else runs.
	macro_run check_paren_balance
	macro_run check_bracket_balance
	handle_errors(errors)

	unsafe_macro_run define_lookup_tables

	# first pre-scan: collect names that the second pre-scan pass depends on
	unsafe_macro_run prescan_shapes_and_validator_types

	# second pre-scan: collect remaining names + validate members
	unsafe_macro_run prescan_declared_state

	for if pos < token_count
		Token tok = tokens at pos
		(kind, value, line, file) in tok
		string cur_kind = kind
		string cur_val = value
		int cur_line = line
		string cur_file = file

		macro_run check_common_token_rules

		macro_run check_struct_decl
		macro_run check_enum_decl
		macro_run check_shape_decl
		macro_run check_type_decl
		macro_run track_non_bool_vars
		macro_run check_fn_decl

		macro_run check_misc_token_rules
		macro_run check_ident_token_rules
		macro_run check_closing_token_rules

		pos = pos + 1

	handle_errors(errors)
