
# Looks up a struct name in the alternating [name, "field1,field2"] registry.
# Returns the comma-separated field string, or "" if the name is not found.
fn string find_struct_field_str(strList reg, string name)
	int reg_count = len(reg)
	int reg_index = 0
	for if reg_index < reg_count
		string entry = reg at reg_index
		if entry is name
			int val_pos = reg_index + 1
			if val_pos < reg_count
				string fields = reg at val_pos
				return fields
		reg_index = reg_index + 2
	return ""

fn bool arg_is_named(TokensRef tokens, int scan_pos, string kind)
	# ex: move {data} — kw_pos+1 skips 'move' to reach the real arg name
	fn int locate_after_move(int kw_pos)
		return kw_pos + 1

	int token_count = len(tokens)
	int check_pos = scan_pos
	string check_kind = kind
	if kind is "KW_MOVE"
		check_pos = locate_after_move(scan_pos)
		if check_pos < token_count
			Token move_token = tokens at check_pos
			(kind) in move_token
			check_kind = kind
	if check_kind is not "IDENT"
		return false
	# ex: add(data{(}5)) — check_pos+1 peeks the token after the arg name
	int peek_pos = check_pos + 1
	if peek_pos < token_count
		Token peek_token = tokens at peek_pos
		(kind) in peek_token
		bool is_call = kind is "LPAREN"
		bool is_idx = kind is "KW_AT"
		bool is_plus = kind is "PLUS"
		bool is_minus = kind is "MINUS"
		bool is_star = kind is "STAR"
		bool is_slash = kind is "SLASH"
		bool is_pct = kind is "PERCENT"
		bool is_op = is_plus or is_minus or is_star or is_slash or is_pct
		if is_call or is_idx or is_op
			return false
	return true


# Returns the position of the RPAREN matching the LPAREN at lp_pos. Falls back to
# lp_pos itself if unmatched (shouldn't happen — check_paren_balance runs first).
fn int find_matching_rparen(TokensRef tokens, int lp_pos)
	# ex: name({}arg) — kw_pos+1 grabs the first token after the opening paren
	fn int locate_first_token(int kw_pos)
		return kw_pos + 1

	int token_count = len(tokens)
	int cur = locate_first_token(lp_pos)
	int depth = 0
	for if cur < token_count
		Token token = tokens at cur
		(kind) in token
		if kind is "LPAREN"
			depth = depth + 1
		else if kind is "RPAREN"
			bool at_root = depth is 0
			if at_root
				return cur
			depth = depth - 1
		cur = cur + 1
	return lp_pos

# Counts arguments between LPAREN at lp_pos and its matching RPAREN.
# Returns 0 for empty calls, 1 for single-arg, N for N-arg calls.
fn int count_call_args(TokensRef tokens, int lp_pos)
	# ex: name({}arg) — kw_pos+1 grabs the first token after the opening paren
	fn int locate_first_token(int kw_pos)
		return kw_pos + 1

	int token_count = len(tokens)
	int cur = locate_first_token(lp_pos)
	int depth = 0
	int comma_count = 0
	bool saw_token = false
	for if cur < token_count
		Token token = tokens at cur
		(kind) in token
		if kind is "RPAREN"
			bool at_root = depth is 0
			if at_root
				break
			depth = depth - 1
		else if kind is "LPAREN"
			depth = depth + 1
			saw_token = true
		else if kind is "LBRACKET"
			depth = depth + 1
			saw_token = true
		else if kind is "RBRACKET"
			depth = depth - 1
			saw_token = true
		else if kind is "COMMA"
			bool at_root = depth is 0
			if at_root
				comma_count = comma_count + 1
			saw_token = true
		else
			saw_token = true
		cur = cur + 1
	int result = 0
	if saw_token
		result = comma_count + 1
	return result
