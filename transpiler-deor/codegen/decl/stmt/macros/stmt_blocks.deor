
# Handles block-level statement forms that wrap a child block.
#   block  → bare `{ ... }` scope block at the current indentation depth
#   rust   → inline Rust source block, re-indented to match current depth
macro stmt_blocks
	# ex: block {\n}    ... — anchor+1 grabs the NEWLINE before the scoped body
	fn int locate_next_token(int anchor)
		return anchor + 1

	# ex: rust\n{"fn foo() {}"} — kw_pos+2 grabs the RUST_BLOCK content token
	fn int locate_rust_block_content(int kw_pos)
		return kw_pos + 2

	if kind is "KW_BLOCK"
		int newline_pos = locate_next_token(pos)
		int body_start = skip_to_body_ref(tokens, newline_pos)
		int body_depth = depth + 1
		ParseResult body_result = gen_block(body_start, body_depth, ctx)
		move (code, new_pos) in body_result
		body_code as code
		body_end as new_pos
		string open_brace = "{\n"
		string close_brace = "}\n"
		string block_open = s_cat(pad, open_brace)
		string block_close = s_cat(pad, close_brace)
		string block_code = s_join([block_open, body_code, block_close])
		return make_result(move block_code, body_end)
	if kind is "KW_RUST"
		int rust_block_pos = locate_rust_block_content(pos)
		Token rust_block_token = tokens at rust_block_pos
		(value) in rust_block_token
		string rust_content = value
		strList rust_lines = s_split(rust_content, RS_NL)
		strList padded_lines = empty
		int line_count = len(rust_lines)
		for line_index in range(line_count)
			string rust_line = rust_lines at line_index
			if is_empty(rust_line)
				string empty_line = ""
				padded_lines at end = empty_line
			else
				padded_lines at end = s_join([pad, rust_line])
		string rust_block_code = s_join_nl(padded_lines)
		rust_block_code = s_cat(rust_block_code, RS_NL)
		int rust_block_next = locate_next_token(rust_block_pos)
		return make_result(move rust_block_code, rust_block_next)
