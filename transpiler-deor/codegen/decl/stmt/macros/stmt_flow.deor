
# Handles simple flow-control statements that produce one line of output and return.
#   return expr  → `return expr[.to_string()];`
#   break        → `break;`
#   continue     → `continue;`
# The `.to_string()` suffix is skipped when expr is a binary-op chain (e.g.
# `return a + b + "c"`) — a chain already produces a correctly owned value, and this
# suffix is meant for a single token.
macro stmt_flow
	# ex: return {expr} — anchor+1 grabs the return value expression
	fn int locate_next_token(int anchor)
		return anchor + 1

	if kind is "KW_RETURN"
		int val_pos = locate_next_token(pos)
		Token val_token = tokens at val_pos
		(kind) in val_token
		ParseResult val_result = gen_expr(tokens, val_pos, ctx)
		move (code, new_pos) in val_result
		val_code as code
		val_end as new_pos

		bool is_chain = is_expr_chain(tokens, val_pos, val_end)

		string suffix = ""
		if not is_chain
			if kind is "STRING"
				suffix = ".to_string()"
		string return_kw = "return "
		string return_sc = ";\n"
		string return_code = s_join([pad, return_kw, val_code, suffix, return_sc])
		return make_nl_result(move return_code, val_end, tokens)
	if kind is "KW_BREAK"
		string break_kw = "break;\n"
		string break_code = s_join([pad, break_kw])
		int break_next = locate_next_token(pos)
		return make_nl_result(move break_code, break_next, tokens)
	if kind is "KW_CONTINUE"
		string continue_kw = "continue;\n"
		string continue_code = s_join([pad, continue_kw])
		int continue_next = locate_next_token(pos)
		return make_nl_result(move continue_code, continue_next, tokens)
