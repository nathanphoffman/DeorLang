
# Checks that `tokens at cur` is KW_IN followed by an IDENT named "input" or "args".
# On success sets name_ok=true, lparen_pos to the position of the expected LPAREN,
# and is_args=true when the source is args().
# Reads: cur, tokens, token_count (all from outer scope).
# Writes: name_ok, lparen_pos, is_args (must be declared in outer scope before call).
macro gic_match_kw_and_name
	# ex: (fields) in {input}() — anchor+1 grabs the args/input identifier
	fn int locate_next_token(int anchor)
		return anchor + 1

	Token in_token = tokens at cur
	(kind) in in_token
	if kind is "KW_IN"
		int name_pos = locate_next_token(cur)
		if name_pos < token_count
			Token name_token = tokens at name_pos
			(kind, value) in name_token
			if kind is "IDENT"
				if value is "input"
					name_ok = true
				else if value is "args"
					name_ok = true
					is_args = true
				if name_ok
					# ex: (fields) in input{(}) — name_pos+1 grabs the opening paren
					lparen_pos = locate_next_token(name_pos)
