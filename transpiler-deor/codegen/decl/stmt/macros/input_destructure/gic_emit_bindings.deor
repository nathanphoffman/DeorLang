
# Loops over the collected field names and emits a `let` binding for each.
# Valid names: first, second, third, input_string, input_list.
# Silently skips any unrecognised name (binding stays "").
# Appends lines to output_lines.
# Reads: fields, input_pad, RS_NL, output_lines.
macro gic_emit_bindings
	int field_count = len(fields)
	for field_index in range(field_count)
		string field_name = fields at field_index
		string binding = ""
		if field_name is "first"
			binding = "let first: String = _deor_args.get(0).cloned().unwrap_or_default();"
		else if field_name is "second"
			binding = "let second: String = _deor_args.get(1).cloned().unwrap_or_default();"
		else if field_name is "third"
			binding = "let third: String = _deor_args.get(2).cloned().unwrap_or_default();"
		else if field_name is "input_string"
			binding = "let input_string: String = _deor_args.join(\" \");"
		else if field_name is "input_list"
			binding = "let input_list: Vec<String> = _deor_args.clone();"
		if not is_empty(binding)
			string binding_line = s_join([input_pad, binding, RS_NL])
			output_lines at end = binding_line
