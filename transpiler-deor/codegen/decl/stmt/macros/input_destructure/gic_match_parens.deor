
# Checks that the token at lparen_pos is LPAREN and the one after is RPAREN,
# confirming the trailing `()` of input() or args().
# On success sets matched=true.
# Reads: lparen_pos, tokens, token_count.
# Writes: matched (must be declared false in outer scope before call).
macro gic_match_parens
	# ex: input({)}) — anchor+1 grabs the token right after the opening paren
	fn int locate_next_token(int anchor)
		return anchor + 1

	if lparen_pos < token_count
		Token lparen_token = tokens at lparen_pos
		(kind) in lparen_token
		if kind is "LPAREN"
			int rparen_pos = locate_next_token(lparen_pos)
			if rparen_pos < token_count
				Token rparen_token = tokens at rparen_pos
				(kind) in rparen_token
				if kind is "RPAREN"
					matched = true
