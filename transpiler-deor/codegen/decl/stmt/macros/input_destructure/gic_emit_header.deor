
# Emits the Rust preamble lines that produce the _deor_args Vec.
#   args()  → collects argv[1..] directly
#   input() → flushes stdout (so an unterminated prompt printed just before
#             this isn't left sitting in the buffer), then reads one stdin
#             line and splits on whitespace
# Appends lines to output_lines.
# Reads: is_args, input_pad, RS_NL, output_lines.
macro gic_emit_header
	if is_args
		string args_decl = "let _deor_args: Vec<String> = std::env::args().skip(1).collect();"
		string args_line = s_join([input_pad, args_decl, RS_NL])
		output_lines at end = args_line
	else
		string raw_decl = "let mut _deor_raw: String = String::new();"
		string raw_line = s_join([input_pad, raw_decl, RS_NL])
		output_lines at end = raw_line
		string flush_decl = "std::io::Write::flush(&mut std::io::stdout()).unwrap_or(());"
		string flush_line = s_join([input_pad, flush_decl, RS_NL])
		output_lines at end = flush_line
		string read_decl = "std::io::stdin().read_line(&mut _deor_raw).unwrap_or_default();"
		string read_line = s_join([input_pad, read_decl, RS_NL])
		output_lines at end = read_line
		string split_decl = "let _deor_args: Vec<String> = _deor_raw.split_whitespace().map(|s| s.to_string()).collect();"
		string split_line = s_join([input_pad, split_decl, RS_NL])
		output_lines at end = split_line
