macro for_build_fields
	for field_index in range(field_count)
		string field = fields at field_index
		bool is_mut = list_has(mut_names, field)
		string mut_kw = ""
		if is_mut
			mut_kw = "mut "
		string let_kw = "let "
		string equals_kw = " = "
		string dot = "."
		dest_lines at end = s_join([pad, let_kw, mut_kw, field, equals_kw, val_code, dot, field, field_suffix])
