# Determines `range_expr` and `body_tok_pos` for the shared for-loop emit path: the
# iterated collection becomes `&collection`. Count loops (`for idx N times`) are
# handled earlier by for_times, and a bare `(start, end)` in this position is a
# validation error (see check_bare_tuple_range.deor) that never reaches codegen.
macro for_iter_expr
	val_pos as iter_pos
	ParseResult expr_result = gen_expr(tokens, val_pos, ctx)
	move (code, new_pos) in expr_result
	val_code as code
	val_end as new_pos
	string amp = "&"
	string collection_ref = s_cat(amp, val_code)
	range_expr = collection_ref
	body_tok_pos = val_end
