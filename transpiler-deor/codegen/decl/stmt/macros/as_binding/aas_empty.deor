
# Handles `name as empty`: emits `let mut name = Vec::new()`.
macro aas_empty
	# ex: name as empty{\n} — anchor+1 grabs the token after empty, where parsing resumes
	fn int locate_after_empty(int anchor)
		return anchor + 1

	string empty_prefix = "let mut "
	string empty_suffix = " = Vec::new();\n"
	string empty_code = s_join([pad, empty_prefix, ident_name, empty_suffix])
	int after_empty = locate_after_empty(after_as)
	return make_nl_result(move empty_code, after_empty, tokens)
