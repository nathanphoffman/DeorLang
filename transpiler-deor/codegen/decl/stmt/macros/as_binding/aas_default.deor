
# Default as-binding: emits `let [mut] name = expr[.clone()|.to_string()]` for any `name as expr`
# form not handled by the other aas macros. Skipped when expr is a binary-op chain (e.g.
# `x as a + b + "c"`) — a chain already produces a correctly owned value, and this
# suffix is meant for a single token. Mirrors tb_default's suffix logic exactly — `as`
# always clones, the same as a typed `=` declaration, with no exception for a bare
# identifier: `saved as lines` clones `lines` rather than moving it.
macro aas_default
	# ex: name as other{(}x) — anchor+1 checks for a call/index after the identifier
	fn int locate_after_value(int anchor)
		return anchor + 1

	(kind) in after_as_token
	val_pos as after_as
	ParseResult expr_result = gen_expr(tokens, val_pos, ctx)
	move (code, new_pos) in expr_result
	val_code as code
	val_end as new_pos

	bool is_chain = is_expr_chain(tokens, val_pos, val_end)

	string var_name = ident_name
	unsafe_macro_run mut_guard
	string suffix = ""
	if not is_chain
		if kind is "STRING"
			suffix = ".to_string()"
		else if kind is "IDENT"
			int next_idx = locate_after_value(val_pos)
			if next_idx < token_count
				Token next_token = tokens at next_idx
				(kind) in next_token
				bool is_call = kind is "LPAREN"
				bool is_idx = kind is "KW_AT"
				if not is_call
					if not is_idx
						suffix = ".clone()"
	string let_kw = "let "
	string equals_kw = " = "
	string statement_close = ";\n"
	string bind_code = s_join([pad, let_kw, mut_kw, ident_name, equals_kw, val_code, suffix, statement_close])
	return make_nl_result(move bind_code, val_end, tokens)
