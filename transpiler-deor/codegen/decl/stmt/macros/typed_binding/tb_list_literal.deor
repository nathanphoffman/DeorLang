
# Handles `Type name = [...]`: always emits `let mut name: RustType = vec![...]`.
macro tb_list_literal
	ParseResult expr_result = gen_expr(tokens, val_pos, ctx)
	move (code, new_pos) in expr_result
	val_code as code
	val_end as new_pos
	string list_prefix = "let mut "
	string list_colon = ": "
	string list_eq = " = "
	string list_sc = ";\n"
	string list_code = s_join([pad, list_prefix, var_name, list_colon, rust_type, list_eq, val_code, list_sc])
	return make_nl_result(move list_code, val_end, tokens)
