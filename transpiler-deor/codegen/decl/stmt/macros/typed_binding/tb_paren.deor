
# Handles `Type name = (...)`: emits struct construction if the type is a known struct,
# or an unwrap expression for `(avow x)`. Falls through for plain grouped expressions.
macro tb_paren
	# ex: Type name = ({avow} x) — anchor+1 grabs the token after the opening paren
	fn int locate_after_lparen(int anchor)
		return anchor + 1

	int peek_pos = locate_after_lparen(val_pos)
	Token peek_token = tokens at peek_pos
	(kind) in peek_token
	bool is_avow_expr = kind is "KW_AVOW"
	bool is_struct_type = reg_has(struct_reg, var_type)
	if not is_avow_expr
		if is_struct_type
			strList paren_fields = empty
			int scan_pos = locate_after_lparen(val_pos)
			for if scan_pos < token_count
				Token scan_token = tokens at scan_pos
				(kind, value) in scan_token
				if kind is "RPAREN"
					scan_pos = scan_pos + 1
					break
				else if kind is "COMMA"
					scan_pos = scan_pos + 1
				else if kind is "IDENT"
					paren_fields at end = value
					scan_pos = scan_pos + 1
				else
					scan_pos = scan_pos + 1
			strList field_pairs = empty
			int field_count = len(paren_fields)
			for field_index in range(field_count)
				string field_name = paren_fields at field_index
				string field_sep = ": "
				string field_clone_suffix = ".clone()"
				field_pairs at end = s_join([field_name, field_sep, field_name, field_clone_suffix])
			string sep = ", "
			string fields_code = s_join_with(field_pairs, sep)
			unsafe_macro_run mut_guard
			string struct_let = "let "
			string struct_eq = " = "
			string struct_open_brace = " { "
			string struct_close_brace = " };\n"
			string struct_code = s_join([pad, struct_let, mut_kw, var_name, struct_eq, var_type, struct_open_brace, fields_code, struct_close_brace])
			return make_nl_result(move struct_code, scan_pos, tokens)
	if is_avow_expr
		# ex: Type name = (avow {x}) — peek_pos+1 grabs the expression after avow
		int inner_pos = peek_pos + 1
		val_pos as inner_pos
		ParseResult expr_result = gen_expr(tokens, val_pos, ctx)
		move (code, new_pos) in expr_result
		val_code as code
		val_end as new_pos
		int after_rparen = val_end + 1
		string unwrap_suffix = ".unwrap()"
		string unwrap_field0_suffix = ".unwrap().0"
		string unwrap_expr = s_cat(val_code, unwrap_suffix)
		if var_type is "int"
			unwrap_expr = s_cat(val_code, unwrap_field0_suffix)
		if var_type is "string"
			unwrap_expr = s_cat(val_code, unwrap_field0_suffix)
		if var_type is "bool"
			unwrap_expr = s_cat(val_code, unwrap_field0_suffix)
		if var_type is "float"
			unwrap_expr = s_cat(val_code, unwrap_field0_suffix)
		string avow_let = "let "
		string avow_colon = ": "
		string avow_eq = " = "
		string avow_sc = ";\n"
		string avow_code = s_join([pad, avow_let, var_name, avow_colon, rust_type, avow_eq, unwrap_expr, avow_sc])
		return make_nl_result(move avow_code, after_rparen, tokens)
