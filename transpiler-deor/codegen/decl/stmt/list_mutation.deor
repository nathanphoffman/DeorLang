
# Generates code for list-mutation statements where the target is an identifier.
# pos points to the list name. Dispatches based on the next token:
#   name at end = val     → `.push(val)`
#   name at idx = val     → `name[idx as usize] = val`
#   name remove at idx    → `.remove(idx as usize)`
fn ParseResult gen_list_mutation_stmt(int pos, int depth, RcCtx ctx)
	# ex: name {at} end = val — anchor+1 grabs the mutation-kind keyword after the list name
	fn int locate_next_token(int anchor)
		return anchor + 1

	# ex: name at end = {val} — anchor+2 skips 'end' and '=' to grab the value expr
	fn int locate_value_after_end(int anchor)
		return anchor + 2

	# ex: name remove at {idx} — anchor+2 skips 'remove' and 'at' to grab the index expr
	fn int locate_index_after_remove(int anchor)
		return anchor + 2

	(tokens) in ctx
	int token_count = len(tokens)
	unsafe_macro_run rust_strings
	string pad = s_repeat(RS_IND, depth)
	Token name_token = tokens at pos
	(value) in name_token
	string ident_name = value
	int next_pos = locate_next_token(pos)
	Token next_token = tokens at next_pos
	(kind) in next_token

	# name at end = val  OR  name at idx = val
	if kind is "KW_AT"
		int after_at = locate_next_token(next_pos)
		if after_at < token_count
			Token at_next_token = tokens at after_at
			(kind, value) in at_next_token
			if kind is "KW_END"
				int val_pos = locate_value_after_end(after_at)
				unsafe_macro_run gen_expr_r
				Token val_tok = tokens at val_pos
				(kind) in val_tok
				string push_val = emit_val(val_code, kind)
				string push_prefix = ".push("
				string push_code = s_join([pad, ident_name, push_prefix, push_val, RS_RP_SC])
				return make_nl_result(move push_code, val_end, tokens)
			val_pos as after_at
			unsafe_macro_run gen_expr_r
			string idx_code = move val_code
			int val_pos = val_end + 1
			unsafe_macro_run gen_expr_r
			Token val_tok = tokens at val_pos
			(kind) in val_tok
			string idx_val = emit_val(val_code, kind)
			string index_open = "["
			string index_mid = " as usize] = "
			string index_suffix = ";\n"
			string index_code = s_join([pad, ident_name, index_open, idx_code, index_mid, idx_val, index_suffix])
			return make_nl_result(move index_code, val_end, tokens)

	# name remove at idx
	if kind is "KW_REMOVE"
		int idx_pos = locate_index_after_remove(next_pos)
		val_pos as idx_pos
		unsafe_macro_run gen_expr_r
		string remove_prefix = ".remove("
		string remove_suffix = " as usize);\n"
		string remove_code = s_join([pad, ident_name, remove_prefix, val_code, remove_suffix])
		return make_nl_result(move remove_code, val_end, tokens)

	string unhandled_prefix = "/* unhandled_list_mut("
	string unhandled_suffix = ") */\n"
	string unhandled = s_join([unhandled_prefix, kind, unhandled_suffix])
	int unhandled_next = locate_next_token(pos)
	return make_result(move unhandled, unhandled_next)
