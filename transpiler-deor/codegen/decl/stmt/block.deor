
# Runs gen_stmt repeatedly until DEDENT or EOF, collecting and joining the statement
# code strings. Used for function bodies, if/else branches, for/while bodies, and
# using blocks — anywhere Deor uses indentation to define a scope.
fn ParseResult gen_block(int pos, int depth, RcCtx ctx)
	(tokens) in ctx
	strList stmts = empty
	int cur = pos
	int token_count = len(tokens)
	string last_file = ""
	unsafe_macro_run rust_strings
	string pad = s_repeat(RS_IND, depth)
	for if true
		if cur >= token_count
			break
		Token token = tokens at cur
		(kind, value, file) in token
		if kind is "DEDENT" or kind is "EOF"
			if kind is "DEDENT"
				cur = cur + 1
			break
		if kind is "NEWLINE"
			cur = cur + 1
			continue
		if kind is "MACRO_MARKER"
			string macro_prefix = "// macro: "
			string paren_open = " ("
			string paren_close = ")"
			string macro_comment = s_join([pad, macro_prefix, value, paren_open, file, paren_close, RS_NL])
			stmts at end = macro_comment
			last_file = file
			cur = cur + 1
			continue
		if file is not last_file
			string comment_prefix = "// "
			string file_comment = s_join([pad, comment_prefix, file, RS_NL])
			stmts at end = file_comment
			last_file = file

		ParseResult stmt_result = gen_stmt(cur, depth, ctx)
		move (code, new_pos) in stmt_result
		stmts at end = code
		cur = new_pos

	string block_joined = s_join(stmts)
	return make_result(move block_joined, cur)
