
# === Statement code generation ===
#
# Each statement concern has its own file:
#
#   codegen_stmt/helpers.deor         — emit_val
#   codegen_stmt/destructure.deor     — gen_destructure: (f1, f2) in source
#   codegen_stmt/block.deor           — gen_block: indented statement sequence
#   codegen_stmt/if.deor              — gen_if_branch, gen_if
#   codegen_stmt/for.deor             — gen_for: while/for-in/for-range
#   codegen_stmt/macros/stmt_flow.deor     — stmt_flow: return/break/continue
#   codegen_stmt/macros/stmt_blocks.deor   — stmt_blocks: block/rust
#   codegen_stmt/macros/stmt_structural.deor — stmt_structural: (avow)/destructure
#   codegen_stmt/as_binding.deor      — gen_as_binding: name as ...
#   codegen_stmt/call_stmt.deor       — gen_call_stmt: name(args)
#   codegen_stmt/list_mutation.deor   — gen_list_mutation_stmt: at/remove
#   codegen_stmt/typed_binding.deor   — gen_typed_binding: Type name = expr

# Main statement dispatcher. Recognizes every statement form and routes to the
# appropriate function or macro. The IDENT branch dispatches to sub-functions for
# each identifier-led form so this function stays a clean dispatch table.
fn ParseResult gen_stmt(int pos, int depth, RcCtx ctx)
	# The token right after whatever keyword/ident anchor is in scope at each call
	# site below — reused across branches, meaning documented by the comment there.
	fn int locate_next_token(int anchor)
		return anchor + 1

	# ex: raw name = {val} — kw_pos+3 skips 'raw', the name, and '=' to grab the value expr
	fn int locate_raw_value(int kw_pos)
		return kw_pos + 3

	(variant_reg, shape_reg, struct_reg, enum_reg, mut_names, type_reg, tokens, validator_var_reg) in ctx
	int token_count = len(tokens)
	Token token = tokens at pos
	(kind, value, line) in token
	unsafe_macro_run rust_strings
	string pad = s_repeat(RS_IND, depth)

	macro_run stmt_flow
	macro_run stmt_blocks
	macro_run stmt_structural

	if kind is "KW_RAW"
		# ex: raw {name} = ... — kw_pos+1 grabs the variable name after 'raw'
		int raw_name_pos = locate_next_token(pos)
		Token raw_name_tok = tokens at raw_name_pos
		(value) in raw_name_tok
		string raw_var_name = value
		int val_pos = locate_raw_value(pos)

		unsafe_macro_run gen_expr_r
		string var_name = raw_var_name
		unsafe_macro_run mut_guard

		strList raw_parts = [pad, RS_LET, mut_kw, raw_var_name, RS_EQ, val_code, RS_SC]
		string raw_code = s_join(raw_parts)
		return make_nl_result(move raw_code, val_end, tokens)

	if kind is "KW_CONST"
		# ex: const {Type} name = val — kw_pos+1 grabs the type token after 'const'
		int const_type_pos = locate_next_token(pos)
		return gen_typed_binding(const_type_pos, depth, ctx)

	if kind is "KW_IF"
		return gen_if(pos, depth, ctx)

	if kind is "KW_FOR"
		return gen_for(pos, depth, ctx)

	if kind is "KW_FN"
		# A fn nested inside another fn — restricted by the validator to a body of
		# exactly one `return expr` statement, so its Rust body can be generated by
		# recursing into gen_stmt at the KW_RETURN token instead of the general
		# gen_block/closure machinery gen_type_decl needs for multi-statement bodies.
		# ex: fn {int} add(left, right) — kw_pos+1 grabs the return-type slot
		fn int locate_fn_return_type(int kw_pos)
			return kw_pos + 1

		TokensRef fn_tokens = tokens
		int return_type_pos = locate_fn_return_type(pos)
		unsafe_macro_run fn_parse_signature
		int nested_fn_body_depth = depth + 1
		ParseResult nested_fn_body_result = gen_stmt(body_start, nested_fn_body_depth, ctx)
		move (code, new_pos) in nested_fn_body_result
		nested_fn_body_code as code
		nested_fn_body_end as new_pos
		int nested_fn_after_pos = nested_fn_body_end + 1
		string nested_fn_params_code = s_join_with(param_strs, RS_CSEP)
		string nested_fn_ret_suffix = ""
		if not is_empty(ret_type)
			nested_fn_ret_suffix = s_join([RS_ARR, ret_type])
		string nested_fn_kw = "fn "
		string nested_fn_close = "}\n"
		strList nested_fn_parts = [pad, nested_fn_kw, fn_name, RS_LP, nested_fn_params_code, RS_RP, nested_fn_ret_suffix, RS_OB, nested_fn_body_code, pad, nested_fn_close]
		string nested_fn_code = s_join(nested_fn_parts)
		return make_result(move nested_fn_code, nested_fn_after_pos)

	if kind is "IDENT"
		string ident_name = value
		# ex: name {=} expr — kw_pos+1 grabs the token after the identifier that decides the statement form
		int next_pos = locate_next_token(pos)
		if next_pos >= token_count
			string eof_code = "/* eof */\n"
			return make_result(move eof_code, next_pos)
		Token next_token = tokens at next_pos
		(kind) in next_token

		if kind is "KW_AS"
			return gen_as_binding(pos, depth, ctx)

		if kind is "LPAREN"
			return gen_call_stmt(pos, depth, ctx)

		if kind is "KW_AT"
			return gen_list_mutation_stmt(pos, depth, ctx)

		if kind is "KW_REMOVE"
			return gen_list_mutation_stmt(pos, depth, ctx)

		# name = expr  (plain reassignment)
		if kind is "EQUALS"
			# ex: name = {expr} — next_pos+1 grabs the value expression after '='
			int val_pos = locate_next_token(next_pos)
			Token eq_val_token = tokens at val_pos
			(kind) in eq_val_token
			unsafe_macro_run gen_expr_r
			string assign_suffix = ""
			if kind is "STRING"
				assign_suffix = ".to_string()"
			# validator-typed reassignment re-runs the predicate: `name = TypeName::new(expr);`
			# instead of a plain `name = expr;` — see docs/validator_types.md#is-valid-is-not-valid
			string reassign_type = reg_get(validator_var_reg, ident_name)
			string asgn_code = ""
			if not is_empty(reassign_type)
				string reassign_new_open = "::new("
				string reassign_sc = ");\n"
				strList reassign_parts = [pad, ident_name, RS_EQ, reassign_type, reassign_new_open, val_code, reassign_sc]
				asgn_code = s_join(reassign_parts)
			else
				strList assign_parts = [pad, ident_name, RS_EQ, val_code, assign_suffix, RS_SC]
				asgn_code = s_join(assign_parts)
			return make_nl_result(move asgn_code, val_end, tokens)

		# Type name = expr  (typed binding)
		if kind is "IDENT"
			# ex: Type name {=} val — next_pos+1 grabs the expected '=' after the var name
			int eq_pos = locate_next_token(next_pos)
			if eq_pos < token_count
				Token eq_token = tokens at eq_pos
				(kind) in eq_token
				if kind is "EQUALS"
					return gen_typed_binding(pos, depth, ctx)
			# bare declaration: Type name  (no = → None for validator types)
			(value) in next_token
			string bare_var_name = value
			string bare_rust_type = resolve_type(ident_name, ctx)
			bool bare_is_validator = reg3_has(type_reg, ident_name)
			if bare_is_validator
				string bare_decl_suffix = " = None;\n"
				string bare_decl_code = s_join([pad, RS_LETM, bare_var_name, RS_COL, bare_rust_type, bare_decl_suffix])
				int bare_decl_after = locate_next_token(next_pos)
				return make_nl_result(move bare_decl_code, bare_decl_after, tokens)

	string unhandled_prefix = "/* unhandled("
	string unhandled_suffix = ") */\n"
	strList unhandled_parts = [unhandled_prefix, kind, unhandled_suffix]
	string unhandled = s_join(unhandled_parts)
	int unhandled_next = locate_next_token(pos)
	return make_result(move unhandled, unhandled_next)
