# True when a call's arguments are exactly `name, name)`: two plain variables. Only
# that shape is safe to rewrite, since the expressions are then just variable reads.
fn bool is_two_variable_args(TokensRef tokens, int args_pos)
	int comma_pos = args_pos + 1
	int second_pos = args_pos + 2
	int close_pos = args_pos + 3
	int token_count = len(tokens)

	if close_pos >= token_count
		return false

	string first_kind = token_kind_at(tokens, args_pos)
	string comma_kind = token_kind_at(tokens, comma_pos)
	string second_kind = token_kind_at(tokens, second_pos)
	string close_kind = token_kind_at(tokens, close_pos)
	bool first_ok = first_kind is IDENT
	bool comma_ok = comma_kind is COMMA
	bool second_ok = second_kind is IDENT
	bool close_ok = close_kind is RPAREN

	return first_ok and comma_ok and second_ok and close_ok

# Generates `list_has(items, value)` as `(items.contains(&value))`. Deor passes
# arguments by value, so the plain call would copy the whole list on every check.
# args_pos is the first argument; returns the position just past the closing ')'.
fn ParseResult gen_list_contains(TokensRef tokens, int args_pos, RcCtx ctx)
	int second_pos = args_pos + 2
	int after_pos = args_pos + 4
	ParseResult items_result = gen_expr(tokens, args_pos, ctx)
	move (code) in items_result
	items_code as code
	ParseResult value_result = gen_expr(tokens, second_pos, ctx)
	move (code) in value_result
	value_code as code
	string paren_open = "("
	string contains_open = ".contains(&"
	string contains_close = "))"
	string joined = s_join([paren_open, items_code, contains_open, value_code, contains_close])

	return make_result(move joined, after_pos)
