
# Handles identifiers, which are the most complex primary form — the next token
# determines which of three sub-cases applies:
#   name(args)   — function call (with special handling for len and crash builtins)
#   name at idx  — index read (nested macro_run not supported, so this is inlined rather than shared)
#   name         — plain identifier, or an enum variant if found in the variant registry
macro primary_ident_expr
	# ex: name{(}args) — kw_pos+1 grabs the token that decides call/index/plain
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if kind is "IDENT"
		int next_pos = locate_next_token(pos)
		if next_pos < token_count
			Token next_token = tokens at next_pos
			(kind) in next_token
			if kind is "LPAREN"
				string func_name = value
				# ex: name({args}) — next_pos+1 grabs the first call-argument slot
				int args_pos = locate_next_token(next_pos)
				if func_name is "len"
					string len_suffix = ".len() as i64"
					ParseResult len_result = gen_unary_method(args_pos, len_suffix, ctx)
					move (code, new_pos) in len_result
					len_code as code
					len_end as new_pos
					string paren_open = "("
					string paren_close = ")"
					string len_wrapped = s_join([paren_open, len_code, paren_close])
					return make_result(move len_wrapped, len_end)
				else if func_name is "crash"
					ParseResult crash_result = gen_call_args(tokens, args_pos, ctx)
					move (code, new_pos) in crash_result
					crash_code as code
					crash_end as new_pos
					string panic_prefix = "panic!(\"{}\", "
					string panic_suffix = ")"
					string panic_code = s_join([panic_prefix, crash_code, panic_suffix])
					int after_crash = crash_end + 1
					return make_result(move panic_code, after_crash)

				# This is solely for optimization, it is rewritten as a .concat() so that no clones happen
				#  clones happen because deor clones everything by default, and String is one of the few impacted
				#  as a result, since it is a completely unnecessary wrapper call, it does save some performance to
				#  replace the function with concat()
				if func_name is "s_join"
					Token join_arg_token = tokens at args_pos
					(kind) in join_arg_token
					if kind is "LBRACKET"
						# ex: s_join([{a}, b]) — args_pos+1 grabs the first item after '['
						int join_inner_pos = locate_next_token(args_pos)
						ParseResult join_result = gen_join_items(tokens, join_inner_pos, ctx)
						move (code, new_pos) in join_result
						join_items_code as code
						join_end as new_pos
						int join_after = join_end + 2
						string join_open = "["
						string join_close = "].concat()"
						string join_code = s_join([join_open, join_items_code, join_close])
						return make_result(move join_code, join_after)

				ParseResult call_args_result = gen_call_args(tokens, args_pos, ctx)
				move (code, new_pos) in call_args_result
				call_args_code as code
				call_args_end as new_pos
				int call_after = call_args_end + 1
				string call_paren_open = "("
				string call_paren_close = ")"
				string call_code = s_join([func_name, call_paren_open, call_args_code, call_paren_close])
				return make_result(move call_code, call_after)

			if kind is "KW_AT"
				# ex: name at {idx} — next_pos+1 grabs the index expression after 'at'
				int index_pos = locate_next_token(next_pos)
				ParseResult index_result = gen_primary(tokens, index_pos, ctx)
				move (code, new_pos) in index_result
				index_code as code
				index_end as new_pos
				string index_mid = "["
				string index_suffix = " as usize].clone()"
				string index_expr = s_join([value, index_mid, index_code, index_suffix])
				return make_result(move index_expr, index_end)
		string variant_enum = reg_get(variant_reg, value)
		if not is_empty(variant_enum)
			string double_colon = "::"
			string variant_code = s_join([variant_enum, double_colon, value])
			return make_result(move variant_code, next_pos)
		return make_result(move value, next_pos)
