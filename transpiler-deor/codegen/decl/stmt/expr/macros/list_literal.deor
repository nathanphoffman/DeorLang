
# Handles `[item, item, ...]` list literals, delegating to gen_list_items for the
# element list and wrapping the result in `vec![...]`.
macro primary_list_literal
	# ex: [{item}, item] — kw_pos+1 grabs the first list element after '['
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if kind is "LBRACKET"
		int inner_pos = locate_next_token(pos)
		ParseResult items_result = gen_list_items(tokens, inner_pos, ctx)
		move (code, new_pos) in items_result
		items_code as code
		items_pos as new_pos
		string list_open = "vec!["
		string list_close = "]"
		string list_code = s_join([list_open, items_code, list_close])
		int after_pos = items_pos + 1
		return make_result(move list_code, after_pos)
