
# Handles parenthesised expressions. Three cases share the `(` open token:
#   (avow expr)  — forced unwrap: generates `expr.unwrap().0`
#   (f1, f2)     — struct construction: looks up the struct by its field set and
#                  generates `StructName { f1, f2 }`
#   (expr)       — grouped arithmetic/logic: generates `(expr)`
macro primary_paren_expr
	# ex: ({avow} expr) — kw_pos+1 grabs the token that decides avow/struct/grouped
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if kind is "LPAREN"
		int peek_pos = locate_next_token(pos)
		if peek_pos < token_count
			Token peek_token = tokens at peek_pos
			(kind) in peek_token
			if kind is "KW_AVOW"
				# ex: (avow {expr}) — peek_pos+1 grabs the expression after 'avow'
				int avow_expr_pos = locate_next_token(peek_pos)
				ParseResult avow_expr_result = gen_expr(tokens, avow_expr_pos, ctx)
				move (code, new_pos) in avow_expr_result
				avow_expr_code as code
				avow_after as new_pos + 1
				string unwrap_suffix = ".unwrap().0"
				string avow_unwrap_code = s_join([avow_expr_code, unwrap_suffix])
				return make_result(move avow_unwrap_code, avow_after)

			# Peek ahead to decide: if every token before RPAREN is IDENT or COMMA
			# then this is struct construction, otherwise it's a grouped expression.
			bool is_struct = true
			int scan_pos = peek_pos
			for if scan_pos < token_count
				Token scan_token = tokens at scan_pos
				(kind) in scan_token
				if kind is "RPAREN"
					break
				if kind is "IDENT"
					scan_pos = scan_pos + 1
					continue
				if kind is "COMMA"
					scan_pos = scan_pos + 1
					continue
				is_struct = false
				break

			if is_struct
				strList fields = empty
				int field_scan_pos = peek_pos
				for if field_scan_pos < token_count
					Token field_token = tokens at field_scan_pos
					(kind, value) in field_token
					if kind is "RPAREN"
						field_scan_pos = field_scan_pos + 1
						break
					else if kind is "COMMA"
						field_scan_pos = field_scan_pos + 1
					else if kind is "IDENT"
						fields at end = value
						field_scan_pos = field_scan_pos + 1
					else
						field_scan_pos = field_scan_pos + 1
				string struct_name = find_struct_for_fields(struct_reg, fields)
				string fields_separator = ", "
				string fields_code = s_join_with(fields, fields_separator)
				string open_brace = " { "
				string close_brace = " }"
				string struct_code = s_join([struct_name, open_brace, fields_code, close_brace])
				return make_result(move struct_code, field_scan_pos)

			# Grouped expression: parse the inner expr then skip the closing RPAREN
			ParseResult grouped_result = gen_expr(tokens, peek_pos, ctx)
			move (code, new_pos) in grouped_result
			grouped_inner_code as code
			grouped_after as new_pos + 1
			string paren_open = "("
			string paren_close = ")"
			string grouped_code = s_join([paren_open, grouped_inner_code, paren_close])
			return make_result(move grouped_code, grouped_after)
