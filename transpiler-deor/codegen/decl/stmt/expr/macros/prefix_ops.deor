
# Handles prefix keyword operators that modify the next primary expression.
#   move expr  — transparently passes through to the inner expression (ownership transfer,
#                no Rust code difference needed since Deor values are already moved by default)
#   avow expr  — forced unwrap: appends `.unwrap().0`, same as the parenthesized `(avow expr)`
#                form. Binds only to the next primary (same rule as move), so `avow val + 2`
#                parses as `(avow val) + 2` — no ambiguity, parens stay optional.
#   not expr   — logical negation: prepends `!` to the inner expression code
macro primary_prefix_ops
	# ex: move {expr} — kw_pos+1 grabs the expression after the prefix keyword
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	if kind is "KW_MOVE"
		int inner_pos = locate_next_token(pos)
		ParseResult result = gen_primary(tokens, inner_pos, ctx)
		return result
	if kind is "KW_AVOW"
		int avow_inner_pos = locate_next_token(pos)
		ParseResult avow_result = gen_primary(tokens, avow_inner_pos, ctx)
		move (code, new_pos) in avow_result
		avow_code as code
		avow_end as new_pos
		string avow_suffix = ".unwrap().0"
		string avow_unwrap_code = s_join([avow_code, avow_suffix])
		return make_result(move avow_unwrap_code, avow_end)
	if kind is "KW_NOT"
		int operand_pos = locate_next_token(pos)
		ParseResult operand_result = gen_primary(tokens, operand_pos, ctx)
		move (code, new_pos) in operand_result
		operand_code as code
		operand_end as new_pos
		string bang = "!"
		string not_code = s_join([bang, operand_code])
		return make_result(move not_code, operand_end)
