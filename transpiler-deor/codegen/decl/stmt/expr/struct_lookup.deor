# True when every wanted field name appears in the struct's comma-separated field list.
fn bool fields_all_present(strList wanted, strList have)
	int wanted_count = len(wanted)

	for index in range(wanted_count)
		string field = wanted at index
		bool found = list_has(have, field)

		if not found
			return false

	return true

# Names of every struct whose field set is exactly `fields` (order ignored). The struct
# registry is a flat list of alternating name, "field,field,..." entries.
# Used when a bare `(f1, f2)` must resolve to a struct for construction.
fn strList structs_with_exact_fields(ListRef struct_reg, strList fields)
	strList matches = empty
	string comma = ","
	int wanted_count = len(fields)
	int pair_count = len(struct_reg) / 2

	for pair in range(pair_count)
		int name_index = pair * 2
		int fields_index = name_index + 1
		string name = struct_reg at name_index
		string fields_text = struct_reg at fields_index
		strList have = s_split(fields_text, comma)
		bool same_size = len(have) is wanted_count
		bool all_present = fields_all_present(fields, have)

		if same_size and all_present
			matches at end = name

	return matches

# Names of every struct that has at least the given fields. Used by `x with (f1, f2)`,
# where only the overridden fields are visible and the rest come from the source struct.
fn strList structs_containing_fields(ListRef struct_reg, strList fields)
	strList matches = empty
	string comma = ","
	int pair_count = len(struct_reg) / 2

	for pair in range(pair_count)
		int name_index = pair * 2
		int fields_index = name_index + 1
		string name = struct_reg at name_index
		string fields_text = struct_reg at fields_index
		strList have = s_split(fields_text, comma)
		bool all_present = fields_all_present(fields, have)

		if all_present
			matches at end = name

	return matches

# First struct whose field set matches exactly, or "Unknown". Ambiguous matches are
# rejected earlier by the validator (check_ambiguous_struct_build).
fn string find_struct_for_fields(ListRef struct_reg, strList fields)
	strList matches = structs_with_exact_fields(struct_reg, fields)
	string unknown = "Unknown"

	if matches is empty
		return unknown

	string first_match = matches at 0

	return first_match

# First struct containing all the given fields, or "Unknown". Same validator guarantee.
fn string find_struct_containing_fields(ListRef struct_reg, strList fields)
	strList matches = structs_containing_fields(struct_reg, fields)
	string unknown = "Unknown"

	if matches is empty
		return unknown

	string first_match = matches at 0

	return first_match

# Rust field list for a record update: `f1: f1.clone(), f2: f2.clone()`. `with` copies the
# listed values like every other Deor binding, so the variables stay usable afterwards.
fn string cloned_field_pairs(strList fields)
	strList pairs = empty
	string field_sep = ": "
	string clone_suffix = ".clone()"
	string pair_sep = ", "
	int field_count = len(fields)

	for index in range(field_count)
		string field = fields at index
		pairs at end = s_join([field, field_sep, field, clone_suffix])

	return s_join_with(pairs, pair_sep)

# True when the token at `move_pos` starts `move source with (...)`, the record update that
# consumes its source instead of copying it.
fn bool is_move_with(TokensRef tokens, int move_pos)
	int token_count = len(tokens)
	int source_pos = move_pos + 1
	int with_pos = move_pos + 2

	if with_pos >= token_count
		return false

	Token move_token = tokens at move_pos
	move (kind) in move_token

	if kind is not KW_MOVE
		return false

	Token source_token = tokens at source_pos
	move (kind) in source_token

	if kind is not "IDENT"
		return false

	Token with_token = tokens at with_pos
	move (kind) in with_token

	return kind is KW_WITH
