
# True when the for header (from the token after `for` up to its NEWLINE) contains
# the `times` keyword, i.e. it is a count loop.
fn bool for_header_has_times(TokensRef tokens, int pos)
	unsafe_macro_run token_kinds

	# ex: for {idx} 10 times — pos+1 is the first token after 'for'
	fn int locate_next_token(int anchor)
		return anchor + 1

	int token_count = len(tokens)
	int scan_start = locate_next_token(pos)

	for scan_off token_count - scan_start times
		int scan_index = scan_start + scan_off
		Token scan_token = tokens at scan_index
		(kind) in scan_token

		if kind is KW_TIMES
			return true

		if kind is NEWLINE
			return false

	return false

# Generates Rust loop code from a Deor `for` statement. Four dispatch paths:
#   `for if cond`            → `while cond { ... }`
#   `for idx N times`        → `for idx in 0..N { ... }` (or `for N times`, no variable)
#   `for move (var in expr)` → `for var in expr { ... }` (consuming ownership)
#   `for var in collection`  → `for var in collection { ... }`
fn ParseResult gen_for(int pos, int depth, RcCtx ctx)
	unsafe_macro_run token_kinds

	# Reused across the branches below for whatever "one token past X" is needed —
	# each call site's comment documents what X is.
	fn int locate_next_token(int anchor)
		return anchor + 1

	(tokens) in ctx
	int token_count = len(tokens)
	unsafe_macro_run rust_strings
	string pad = s_repeat(RS_IND, depth)

	# ex: for {if} cond — kw_pos+1 grabs the token after 'for' that decides the loop form
	int next_pos = locate_next_token(pos)
	Token next_token = tokens at next_pos
	(kind) in next_token

	if kind is KW_IF
		macro_run for_while

	if kind is KW_MOVE
		macro_run for_move

	if for_header_has_times(tokens, pos)
		macro_run for_times

	string var_name = "_"
	int iter_pos = 0

	if kind is KW_IN
		# ex: for in {(}start, end) — next_pos+1 grabs the range expression after 'in'
		iter_pos = locate_next_token(next_pos)
	else
		(value) in next_token
		var_name = value

		# ex: for {var} in expr — next_pos+1 grabs the expected 'in' keyword after the loop var
		int in_pos = locate_next_token(next_pos)

		# ex: for var in {expr} — in_pos+1 grabs the iteration expression after 'in'
		iter_pos = locate_next_token(in_pos)

	Token iter_token = tokens at iter_pos
	(kind, value) in iter_token

	string range_expr = ""
	int body_tok_pos = 0

	macro_run for_iter_expr

	int blk_start = skip_to_body_ref(tokens, body_tok_pos)
	unsafe_macro_run gen_block_r

	string for_kw = "for "
	string for_in_kw = " in "
	string for_code = s_join([pad, for_kw, var_name, for_in_kw, range_expr, RS_OB, blk_code, pad, RS_CB])

	return make_result(move for_code, blk_end)
