
# Consumes a `raw TypeName` declaration and emits nothing into the Rust output.
# The type is registered in shape_reg (with "raw:" marker) by try_raw_entry so
# resolve_type can return its name as-is. At code-gen time there is nothing to emit —
# the actual Rust type must be defined in an adjacent `rust` block.
fn ParseResult gen_raw_decl(TokensRef tokens, int pos)
	# ex: raw TypeName{\n} — kw_pos+2 grabs the NEWLINE ending the decl
	fn int locate_raw_newline(int kw_pos)
		return kw_pos + 2

	int after = locate_raw_newline(pos)
	string empty_str = ""
	return make_nl_result(move empty_str, after, tokens)
