
# Slices the body token range, pre-scans for mutable variable names, and builds
# the per-function GenCtx. Expects: fn_tokens, indent_pos, body_start,
# variant_reg, shape_reg, struct_reg, enum_reg, type_reg in scope from gen_fn_decl.
unsafe_macro fn_build_body_ctx
	(typed_enum_reg, typed_variant_reg) in ctx
	int body_end_pos = find_block_end_ref(fn_tokens, indent_pos)
	int body_slice_end = body_end_pos + 1
	tokenList body_tokens_raw = l_slice_ref(fn_tokens, body_start, body_slice_end)
	int body_len = len(body_tokens_raw)
	int zero = 0
	int body_last = body_len - 1
	strList mut_names = collect_mut_names(body_tokens_raw, zero, body_last)
	strList validator_var_reg = collect_validator_var_types(body_tokens_raw, type_reg)
	TokensRef tokens = tokens_wrap(move body_tokens_raw)
	TokensRef detect_tokens = tokens
	GenCtx body_ctx_raw = move (variant_reg, shape_reg, struct_reg, enum_reg, mut_names, type_reg, tokens, typed_enum_reg, typed_variant_reg, validator_var_reg)
	RcCtx body_ctx = make_rctx(move body_ctx_raw)

	# A function body that's a single bare expression implicitly returns that value
	# (docs/functions.md's "Return Rules" section — e.g. 'val * val' with no explicit
	# return). Detect that shape here, before gen_block/gen_stmt ever see it: gen_stmt's
	# dispatcher has no case for a lone expression statement (nothing matches, so it
	# falls to the '/* unhandled */' catch-all), and that's deliberately not something
	# to teach gen_stmt generally — a bare trailing expression is only an implicit
	# return when it's the function's ONLY statement; a multi-statement body still
	# requires explicit 'return' at every exit point, per the same doc section.
	bool used_implicit_return = false
	string implicit_return_code = ""
	int implicit_return_end = 0
	bool is_void_ret = is_empty(ret_type)
	if not is_void_ret
		if body_len > 2
			int last_idx = body_len - 1
			int second_last_idx = body_len - 2
			Token last_tok = detect_tokens at last_idx
			(kind) in last_tok
			bool ends_in_dedent = kind is "DEDENT"
			Token second_last_tok = detect_tokens at second_last_idx
			(kind) in second_last_tok
			bool second_last_is_newline = kind is "NEWLINE"
			# Both checks together confirm the body is exactly one line long: statement
			# tokens, then NEWLINE, then immediately the DEDENT that closes the function.
			if ends_in_dedent and second_last_is_newline
				Token first_tok = detect_tokens at zero
				(kind) in first_tok
				string first_kind = kind
				# Statement forms gen_stmt already handles correctly on their own — skip
				# the trial parse below so an existing single-statement body (a lone
				# 'return', 'if', 'for', destructure, raw/rust/macro_run, etc.) is left
				# completely untouched by this new path.
				bool skip_leading = false
				if first_kind is "KW_RETURN"
					skip_leading = true
				if first_kind is "KW_IF"
					skip_leading = true
				if first_kind is "KW_FOR"
					skip_leading = true
				if first_kind is "KW_CONST"
					skip_leading = true
				if first_kind is "KW_RAW"
					skip_leading = true
				if first_kind is "KW_RUST"
					skip_leading = true
				if first_kind is "KW_BLOCK"
					skip_leading = true
				if first_kind is "KW_MACRO_RUN"
					skip_leading = true
				if first_kind is "KW_UNSAFE_MACRO_RUN"
					skip_leading = true
				if first_kind is "LPAREN"
					skip_leading = true
				if not skip_leading
					# Trial-parse the whole line as one expression. If it doesn't fully
					# consume the line (e.g. 'x = 5', 'x as 5' — gen_expr stops right
					# after the first primary since '=' / 'as' aren't binary operators),
					# this isn't a bare expression and the trial result is simply
					# discarded — gen_block runs normally below, unaffected.
					ParseResult trial_result = gen_expr(detect_tokens, zero, body_ctx)
					move (code, new_pos) in trial_result
					trial_code as code
					trial_end as new_pos
					bool fully_consumed = trial_end is second_last_idx
					if fully_consumed
						bool is_chain = is_expr_chain(detect_tokens, zero, trial_end)
						string suffix = ""
						if not is_chain
							if first_kind is "STRING"
								suffix = ".to_string()"
						string return_kw = "return "
						string return_sc = ";\n"
						string return_code = s_join([RS_IND, return_kw, trial_code, suffix, return_sc])
						used_implicit_return = true
						implicit_return_code = return_code
						implicit_return_end = body_len
