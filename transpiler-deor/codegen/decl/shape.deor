
# Builds the Rust source for `shape Foo = list of T` → `type Foo = Vec<T>;`
fn string gen_list_shape_code(string rust_name, string rust_elem)
	string list_prefix = "type "
	string list_mid = " = Vec<"
	string list_suffix = ">;\n\n"
	return s_join([list_prefix, rust_name, list_mid, rust_elem, list_suffix])

# Builds the Rust source for `shape Foo = func of T to U` → `type Foo = fn(T) -> U;`
fn string gen_func_shape_code(string rust_name, string rust_in, string rust_out)
	string out_suffix = ""
	if not is_empty(rust_out)
		string out_prefix = " -> "
		out_suffix = s_join([out_prefix, rust_out])
	string func_prefix = "type "
	string func_mid = " = fn("
	string func_paren_close = ")"
	string func_suffix = ";\n\n"
	return s_join([func_prefix, rust_name, func_mid, rust_in, func_paren_close, out_suffix, func_suffix])

# Generates a Rust type alias from a Deor `shape` declaration. Dispatches to
# shape_list for `list of T` forms and shape_func for `func of T to U` forms.
fn ParseResult gen_shape_decl(TokensRef tokens, int pos)
	# ex: shape {Foo} = list of T — kw_pos+1 grabs the shape name
	fn int locate_shape_name(int kw_pos)
		return kw_pos + 1

	# ex: shape Foo = {list} of T — kw_pos+3 grabs the form keyword (list/func)
	fn int locate_shape_form(int kw_pos)
		return kw_pos + 3

	int name_pos = locate_shape_name(pos)
	int form_pos = locate_shape_form(pos)
	Token name_token = tokens at name_pos
	Token form_token = tokens at form_pos
	(value) in name_token
	string shape_name = value
	(kind) in form_token
	string rust_name = s_pascal(shape_name)
	macro_run shape_list
	macro_run shape_func
