
# Generates a Rust newtype struct plus a `new()` constructor from a Deor
# `type Name(baseType paramName)` declaration. The constructor returns Option<Self>,
# evaluating the user's predicate: if it passes, wraps the value in Some(TypeName(val));
# otherwise returns None. This is Deor's mechanism for validated/constrained scalar types.
#
# Predicate bodies come in two shapes:
#   single expression  — `return val > 0` — handled inline via gen_expr, no block needed.
#   multi-statement     — intermediate bindings before a final `return` — parsed with the
#                          same gen_block used for function bodies, then wrapped in an
#                          immediately-invoked closure `(|| -> bool { ... })()` so the
#                          predicate's `return` exits the closure, not the constructor.
fn ParseResult gen_type_decl(TokensRef tokens, int pos, RcCtx ctx)
	# ex: type {Positive}(int val) — kw_pos+1 grabs the validator type's name
	fn int locate_type_name(int kw_pos)
		return kw_pos + 1

	(variant_reg, shape_reg, struct_reg, enum_reg, type_reg, typed_enum_reg, typed_variant_reg) in ctx
	int type_name_pos = locate_type_name(pos)

	TokenCursor cur = cur_at_ref(tokens, type_name_pos)
	(current) in cur
	(value) in current
	string type_name = value

	cur = cur_next_ref(cur, tokens)   # LPAREN
	cur = cur_next_ref(cur, tokens)   # param_type

	(current) in cur
	(value) in current
	string param_type = value
	string rust_param_type = render_rust_type(param_type)
	cur = cur_next_ref(cur, tokens)   # param_name
	(current) in cur
	(value) in current
	string param_name = value

	cur = cur_next_ref(cur, tokens)   # RPAREN
	cur = cur_next_ref(cur, tokens)   # NEWLINE
	# pos is now the header's NEWLINE — pos+1 grabs the INDENT starting the predicate body
	(pos) in cur
	int indent_pos = pos + 1
	cur = cur_skip_to_body_ref(cur, tokens)

	(pos) in cur
	int body_start = pos

	ParseResult pred_r = gen_expr(tokens, body_start, ctx)
	move (code, new_pos) in pred_r
	pred_code as code
	pred_end as new_pos

	# Peek past the parsed expression: if a (possibly absent) DEDENT follows
	# immediately, the predicate was a single line and pred_code is already correct.
	TokenCursor peek = cur_at_ref(tokens, pred_end)
	for if not c_at_end(peek)
		(current) in peek
		(kind) in current
		if kind is "NEWLINE"
			peek = cur_next_ref(peek, tokens)
			continue
		break

	bool is_single = true
	if not c_at_end(peek)
		(current) in peek
		(kind) in current
		is_single = kind is "DEDENT"

	string final_pred_code = pred_code
	int final_pos = 0

	if is_single
		TokenCursor scan = cur_at_ref(tokens, pred_end)
		for if not c_at_end(scan)
			(current) in scan
			(kind) in current
			scan = cur_next_ref(scan, tokens)
			if kind is "DEDENT"
				break
		(pos) in scan
		final_pos = pos
	else
		int body_end_pos = find_block_end_ref(tokens, indent_pos)
		int body_slice_end = body_end_pos + 1
		tokenList body_tokens = l_slice_ref(tokens, body_start, body_slice_end)
		int zero = 0
		int last = len(body_tokens) - 1
		strList mut_names = collect_mut_names(body_tokens, zero, last)
		strList validator_var_reg = collect_validator_var_types(body_tokens, type_reg)
		TokensRef tokens = tokens_wrap(move body_tokens)
		GenCtx ctx_raw = move (variant_reg, shape_reg, struct_reg, enum_reg, mut_names, type_reg, tokens, typed_enum_reg, typed_variant_reg, validator_var_reg)
		RcCtx pred_ctx = make_rctx(move ctx_raw)

		int block_depth = 2
		ParseResult block_r = gen_block(zero, block_depth, pred_ctx)
		move (code, new_pos) in block_r
		block_code as code
		block_new_pos as new_pos

		string closure_open = "(|| -> bool {\n"
		string closure_close = "        })()"
		final_pred_code = s_join([closure_open, block_code, closure_close])
		final_pos = body_start + block_new_pos

	string struct_prefix = "#[derive(Clone, Copy, PartialEq, Debug)]\nstruct "
	string struct_paren_open = "("
	string struct_suffix = ");\n\n"
	string struct_code = s_join([struct_prefix, type_name, struct_paren_open, rust_param_type, struct_suffix])
	string impl_prefix = "impl "
	string impl_fn_new_open = " {\n    fn new("
	string impl_colon = ": "
	string impl_return_if_open = ") -> Option<Self> {\n        if "
	string impl_some_open = " {\n            Some("
	string impl_inner_paren_open = "("
	string impl_suffix = "))\n        } else {\n            None\n        }\n    }\n}\n\n"
	string impl_code = s_join([impl_prefix, type_name, impl_fn_new_open, param_name, impl_colon, rust_param_type, impl_return_if_open, final_pred_code, impl_some_open, type_name, impl_inner_paren_open, param_name, impl_suffix])
	string type_code = s_cat(move struct_code, move impl_code)

	return make_result(move type_code, final_pos)
