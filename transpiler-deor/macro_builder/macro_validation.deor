
# Pre-expansion validator for macro definitions and uses. Runs on the raw merged
# token list before expand_deor_macros consumes the KW_MACRO/KW_MACRO_RUN tokens.
# Reports any macro_run that references a name not defined by a macro anywhere in
# the merged token stream, then returns the token list unchanged.
fn tokenList validate_macros(tokenList raw_tokens)
	# ex: macro {name} — kw_pos+1 grabs the macro name after the keyword
	fn int locate_next_token(int kw_pos)
		return kw_pos + 1

	int token_count = len(raw_tokens)
	strList errors = empty

	# pass 1: collect every defined macro name
	strList macro_names = empty
	int def_index = 0
	for if def_index < token_count
		Token tok = raw_tokens at def_index
		(kind) in tok
		if kind is "KW_MACRO" or kind is "KW_UNSAFE_MACRO"
			int name_pos = locate_next_token(def_index)
			if name_pos < token_count
				Token name_token = raw_tokens at name_pos
				(kind, value) in name_token
				if kind is "IDENT"
					macro_names at end = value
		def_index = def_index + 1

	# pass 2: verify every macro_run/unsafe_macro_run references a collected name
	string lbl_macro = "macro_run"
	string rule_macro_run = "macro is not defined — check the name or add a 'macro <name>' definition"
	int run_index = 0
	for if run_index < token_count
		Token tok = raw_tokens at run_index
		(kind) in tok
		if kind is "KW_MACRO_RUN" or kind is "KW_UNSAFE_MACRO_RUN"
			int name_pos = locate_next_token(run_index)
			if name_pos < token_count
				Token name_token = raw_tokens at name_pos
				(kind, value) in name_token
				if kind is "IDENT"
					if not list_has(macro_names, value)
						errors at end = val_err(name_token, lbl_macro, rule_macro_run)
		run_index = run_index + 1

	handle_errors(errors)
	return raw_tokens
