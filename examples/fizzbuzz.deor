# fizzbuzz.deor
# Coding test: print the numbers 1 to 20, but print "Fizz" for multiples of 3,
# "Buzz" for multiples of 5, and "FizzBuzz" for multiples of both.

import "lib/convert.deor"

fn string fizzbuzz(int num)
	if num % 15 is 0
		return "FizzBuzz"

	if num % 3 is 0
		return "Fizz"

	if num % 5 is 0
		return "Buzz"

	return c_int_to_string(num)

fn void main()
	start as 1
	stop as 21

	for num in range(start, stop)
		print(fizzbuzz(num))
