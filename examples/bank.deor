# bank.deor
# Coding test: run a list of text commands against a set of bank accounts.
# A command is rejected if it names an unknown account, would overdraw an
# account, or isn't a known command. Prints a log line per command, then the
# final balances.

import "lib/string.deor"
import "lib/convert.deor"

struct Account
	string owner
	int balance

struct Outcome
	accountList accounts
	string status

shape accountList = list of Account

fn int find_account(accountList accounts, string wanted)
	int missing = 0 - 1
	int count = len(accounts)

	for idx count times
		Account account = accounts at idx
		(owner) in account

		if owner is wanted
			return idx

	return missing

fn int balance_at(accountList accounts, int idx)
	Account account = accounts at idx
	(balance) in account

	return balance

fn accountList adjust(accountList accounts, int idx, int change)
	Account old_account = accounts at idx
	(balance) in old_account
	balance = balance + change
	Account new_account = old_account with (balance)

	# parameters are read-only, so the change is made on a copy
	accountList updated = accounts
	updated at idx = new_account

	return updated

fn Outcome apply(accountList ledger, string command)
	accountList accounts = ledger
	stringList parts = s_split_whitespace(command)
	int count = len(parts)
	status as "ok"

	if count < 3
		status = "rejected: bad command"

		return (accounts, status)

	string action = parts at 0
	string owner = parts at 1
	int last = count - 1
	int amount = c_string_to_int(parts at last)
	int source = find_account(accounts, owner)

	if action is "open"
		if source >= 0
			status = "rejected: account exists"
		else
			int balance = amount
			Account account = (owner, balance)
			accounts at end = account

		return (accounts, status)

	if source < 0
		status = "rejected: unknown account"

		return (accounts, status)

	if action is "deposit"
		accounts = adjust(accounts, source, amount)

		return (accounts, status)

	# withdraw and transfer both take money out of the source account
	int debit = 0 - amount

	if balance_at(accounts, source) < amount
		status = "rejected: insufficient funds"
	else if action is "withdraw"
		accounts = adjust(accounts, source, debit)
	else if action is "transfer"
		string target_name = parts at 2
		int target = find_account(accounts, target_name)

		if target < 0
			status = "rejected: unknown account"
		else
			accounts = adjust(accounts, source, debit)
			accounts = adjust(accounts, target, amount)
	else
		status = "rejected: unknown command"

	return (accounts, status)

fn void main()
	stringList commands = empty
	commands at end = "open alice 100"
	commands at end = "open bob 50"
	commands at end = "open cara 0"
	commands at end = "deposit alice 25"
	commands at end = "withdraw bob 80"
	commands at end = "transfer alice cara 60"
	commands at end = "transfer cara dave 10"
	commands at end = "refund bob 5"
	commands at end = "withdraw alice 65"

	accountList ledger = empty
	rejected as 0

	for command in commands
		Outcome outcome = apply(ledger, command)
		(accounts, status) in outcome
		ledger = accounts

		if status is not "ok"
			rejected = rejected + 1

		print(s_join([command, " -> ", status]))

	print("")
	print("Final balances:")
	width as 8

	for account in ledger
		(owner, balance) in account
		string label = s_pad_right(owner, width)
		print(s_join([label, c_int_to_string(balance)]))

	print(s_join(["Rejected commands: ", c_int_to_string(rejected)]))
